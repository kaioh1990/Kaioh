+// vInputKit glue for CvF Online: controller remapping (Steam Input style profiles).
+#import <Foundation/Foundation.h>
+
+@class TouchOverlayView;
+
+// Starts vInputKit once and feeds its virtual gamepad to the game every frame.
+void CvfVInputStart(TouchOverlayView *overlay);
+// Opens the controller configuration screen over the game.
+void CvfVInputShowConfigurator(void);
