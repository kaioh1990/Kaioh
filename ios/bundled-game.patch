+#pragma mark - Menu gestures
+- (BOOL)touchIsOnButton:(UITouch *)touch {
+    CGPoint loc = [touch locationInView:self];
+    for (UIButton *button in self.buttons) {
+        CGRect frame = [self convertRect:button.bounds fromView:button];
+        if (CGRectContainsPoint(CGRectInset(frame, -self.hitSlop, -self.hitSlop), loc)) {
+            return YES;
+        }
+    }
+    return NO;
+}
+
+- (void)trackGestureBegan:(NSSet<UITouch *> *)touches event:(UIEvent *)event {
+    if (CvfInMatch()) {
+        self.gestureTouch = nil;
+        return;
+    }
+    if (self.gestureTouch != nil) {
+        self.gestureTwoFingers = YES;
+        return;
+    }
+    UITouch *touch = touches.anyObject;
+    if ([self touchIsOnButton:touch]) {
+        return;
+    }
+    self.gestureTouch = touch;
+    self.gestureStart = [touch locationInView:self];
+    self.gestureTime = touch.timestamp;
+    self.gestureTwoFingers = touches.count > 1;
+}
+
+- (void)trackGestureEnded:(NSSet<UITouch *> *)touches {
+    UITouch *touch = self.gestureTouch;
+    if (touch == nil || ![touches containsObject:touch]) {
+        return;
+    }
+    self.gestureTouch = nil;
+    
+    CGPoint end = [touch locationInView:self];
+    CGFloat dx = end.x - self.gestureStart.x;
+    CGFloat dy = end.y - self.gestureStart.y;
+    CGFloat distance = hypot(dx, dy);
+    NSTimeInterval held = touch.timestamp - self.gestureTime;
+    
+    if (distance >= kSwipeDistance) {
+        DPadDirection direction;
+        if (fabs(dx) > fabs(dy)) {
+            direction = dx > 0 ? DPadDirectionRight : DPadDirectionLeft;
+        } else {
+            direction = dy > 0 ? DPadDirectionDown : DPadDirectionUp;
+        }
+        [self pressDirection:direction];
+    } else if (distance <= kTapDistance && held <= kTapTime) {
+        if (self.gestureTwoFingers) {
+            [self pressGestureButton:SDL_CONTROLLER_BUTTON_BACK];
+        } else if (!CvfTouchTap(end.x / self.bounds.size.width, end.y / self.bounds.size.height)) {
+            [self pressGestureButton:SDL_CONTROLLER_BUTTON_A];
+        }
+    }
+}
+
+// performSelector rather than dispatch_after: the engine runs inside a main queue
+// block, so blocks queued behind it would not run. Run loop timers still fire.
+- (void)pressDirection:(DPadDirection)direction {
+    [self dPad:self.dPadView didChangeDirection:direction];
+    [self performSelector:@selector(releaseDirection) withObject:nil afterDelay:kGesturePress];
+}
+
+- (void)releaseDirection {
+    [self dPad:self.dPadView didChangeDirection:DPadDirectionNeutral];
+}
+
+- (void)pressGestureButton:(SDL_GameControllerButton)button {
+    [self initVirtualJoystick];
+    if (virtualJoystick == NULL) {
+        return;
+    }
+    SDL_JoystickSetVirtualButton(virtualJoystick, (int)button, SDL_PRESSED);
+    SDL_JoystickUpdate();
+    [self performSelector:@selector(releaseGestureButton:) withObject:@(button) afterDelay:kGesturePress];
+}
+
+- (void)releaseGestureButton:(NSNumber *)button {
+    if (virtualJoystick != NULL) {
+        SDL_JoystickSetVirtualButton(virtualJoystick, button.intValue, SDL_RELEASED);
+        SDL_JoystickUpdate();
+    }
+}
