@@ -0,0 +1,81 @@
+// vInputKit glue for CvF Online. Built only when CVF_VINPUTKIT is defined (the CI build
+// links vInputKit.xcframework when it can read the private repo).
+#import "CvfVInput.h"
+#if CVF_VINPUTKIT
+#import <GameController/GameController.h>
+#import "vik_ios.h"
+#import "TouchOverlayView.h"
+
+// CvF's default mapping. Every button keeps the job it has in save/config.ini
+// ([Joystick_P1]), so existing settings still apply; the labels name CvF's actions.
+static NSString *CvfBind(NSString *input, NSString *binding, NSString *label)
+{
+    return [NSString stringWithFormat:@"\"%@\" { \"activators\" { \"Full_Press\" { \"bindings\" { \"binding\" \"%@, %@, \" } } } }\n", input, binding, label];
+}
+
+static NSString *CvfDefaultProfile(void)
+{
+    NSMutableString *o = [NSMutableString stringWithString:@"\"controller_mappings\" {\n\"version\" \"3\"\n\"title\" \"Castlevania Fighter\"\n\"revision\" \"1\"\n\"controller_type\" \"controller_generic\"\n\"actions\" { \"Default\" { \"title\" \"Fighting\" } }\n"];
+    void (^group)(int, NSString *, NSString *, NSString *) = ^(int gid, NSString *mode, NSString *settings, NSString *inputs) {
+        [o appendFormat:@"\"group\" { \"id\" \"%d\" \"mode\" \"%@\" \"settings\" { %@ } \"inputs\" {\n%@} }\n", gid, mode, settings, inputs];
+    };
+    group(0, @"four_buttons", @"", [@[
+        CvfBind(@"button_a", @"xinput_button A", @"C Secondary Attack"),
+        CvfBind(@"button_b", @"xinput_button B", @"A Primary Attack"),
+        CvfBind(@"button_x", @"xinput_button X", @"X Backdash"),
+        CvfBind(@"button_y", @"xinput_button Y", @"B Jump")] componentsJoinedByString:@""]);
+    group(1, @"dpad", @"\"requires_click\" \"0\"", [@[
+        CvfBind(@"dpad_north", @"xinput_button DPAD_UP", @"Up"),
+        CvfBind(@"dpad_south", @"xinput_button DPAD_DOWN", @"Down"),
+        CvfBind(@"dpad_west", @"xinput_button DPAD_LEFT", @"Left"),
+        CvfBind(@"dpad_east", @"xinput_button DPAD_RIGHT", @"Right")] componentsJoinedByString:@""]);
+    group(2, @"joystick_move", @"", @"");
+    group(3, @"joystick_camera", @"", @"");
+    group(4, @"trigger", @"\"port_output_trigger\" \"1\"", CvfBind(@"click", @"xinput_button TRIGGER_LEFT", @"D Extra"));
+    group(5, @"trigger", @"\"port_output_trigger\" \"2\"", CvfBind(@"click", @"xinput_button TRIGGER_RIGHT", @"W Whip Rush"));
+    group(6, @"switches", @"", [@[
+        CvfBind(@"left_bumper", @"xinput_button SHOULDER_LEFT", @"Y Special Ability"),
+        CvfBind(@"right_bumper", @"xinput_button SHOULDER_RIGHT", @"Z Change Subweapon"),
+        CvfBind(@"button_menu", @"xinput_button START", @"Start / Pause"),
+        CvfBind(@"button_escape", @"xinput_button BACK", @"Menu / Back")] componentsJoinedByString:@""]);
+    [o appendString:@"\"preset\" { \"id\" \"0\" \"name\" \"Default\" \"group_source_bindings\" {\n\"0\" \"button_diamond active\"\n\"1\" \"dpad active\"\n\"2\" \"joystick active\"\n\"3\" \"right_joystick active\"\n\"4\" \"left_trigger active\"\n\"5\" \"right_trigger active\"\n\"6\" \"switch active\"\n} }\n}\n"];
+    return o;
+}
+
+static __weak TouchOverlayView *gOverlay;
+
+static void CvfVInputFrame(const vik_input_frame *input, const vik_output_frame *output, double dt, void *user)
+{
+    // Only drive the game while a controller is connected, so touch gestures keep working without one.
+    BOOL connected = vik_ios_device_count() > 0;
+    [gOverlay applyControllerButtons:output->gamepad.buttons
+                               leftX:output->gamepad.left_x leftY:output->gamepad.left_y
+                              rightX:output->gamepad.right_x rightY:output->gamepad.right_y
+                         leftTrigger:output->gamepad.left_trigger rightTrigger:output->gamepad.right_trigger
+                              active:connected];
+}
+
+void CvfVInputStart(TouchOverlayView *overlay)
+{
+    gOverlay = overlay;
+    if (vik_ios_is_running()) {
+        return;
+    }
+    // Profiles and settings live next to the game's own saves, visible in the Files app.
+    vik_ios_set_documents_subfolder("save/Controls");
+    vik_status st = vik_ios_register_default_profile("Castlevania Fighter", CvfDefaultProfile().UTF8String, NULL);
+    if (st != VIK_OK) {
+        NSLog(@"CvF: default controller profile not loaded (%s)", vik_status_string(st));
+    }
+    vik_ios_set_home_opens_configurator(1);
+    vik_ios_start();
+    vik_ios_set_frame_callback(CvfVInputFrame, NULL);
+}
+
+void CvfVInputShowConfigurator(void)
+{
+    if (!vik_ios_configurator_is_open()) {
+        vik_ios_present_configurator();
+    }
+}
+#endif
