+#pragma mark - Remapped controller
+static SInt16 CvfAxis(float v)
+{
+    if (v > 1.0f) v = 1.0f;
+    if (v < -1.0f) v = -1.0f;
+    return (SInt16)(v < 0 ? v * 32768.0f : v * 32767.0f);
+}
+
+- (void)applyControllerButtons:(uint32_t)buttons leftX:(float)lx leftY:(float)ly rightX:(float)rx rightY:(float)ry leftTrigger:(float)lt rightTrigger:(float)rt active:(BOOL)active
+{
+    static BOOL wasActive = NO;
+    if (!active) {
+        if (!wasActive) {
+            return;
+        }
+        buttons = 0;
+        lx = ly = rx = ry = lt = rt = 0;
+    }
+    wasActive = active;
+    [self initVirtualJoystick];
+    if (virtualJoystick == NULL) {
+        return;
+    }
+    // vik_gamepad bit order: A B X Y, D-pad up down left right, LB RB, L3 R3, Start Back Guide.
+    static const SDL_GameControllerButton map[15] = {
+        SDL_CONTROLLER_BUTTON_A, SDL_CONTROLLER_BUTTON_B, SDL_CONTROLLER_BUTTON_X, SDL_CONTROLLER_BUTTON_Y,
+        SDL_CONTROLLER_BUTTON_DPAD_UP, SDL_CONTROLLER_BUTTON_DPAD_DOWN, SDL_CONTROLLER_BUTTON_DPAD_LEFT, SDL_CONTROLLER_BUTTON_DPAD_RIGHT,
+        SDL_CONTROLLER_BUTTON_LEFTSHOULDER, SDL_CONTROLLER_BUTTON_RIGHTSHOULDER,
+        SDL_CONTROLLER_BUTTON_LEFTSTICK, SDL_CONTROLLER_BUTTON_RIGHTSTICK,
+        SDL_CONTROLLER_BUTTON_START, SDL_CONTROLLER_BUTTON_BACK, SDL_CONTROLLER_BUTTON_GUIDE,
+    };
+    for (int i = 0; i < 15; i++) {
+        SDL_JoystickSetVirtualButton(virtualJoystick, (int)map[i], (buttons >> i) & 1 ? SDL_PRESSED : SDL_RELEASED);
+    }
+    // SDL's y axes point down.
+    SDL_JoystickSetVirtualAxis(virtualJoystick, SDL_CONTROLLER_AXIS_LEFTX, CvfAxis(lx));
+    SDL_JoystickSetVirtualAxis(virtualJoystick, SDL_CONTROLLER_AXIS_LEFTY, CvfAxis(-ly));
+    SDL_JoystickSetVirtualAxis(virtualJoystick, SDL_CONTROLLER_AXIS_RIGHTX, CvfAxis(rx));
+    SDL_JoystickSetVirtualAxis(virtualJoystick, SDL_CONTROLLER_AXIS_RIGHTY, CvfAxis(-ry));
+    SDL_JoystickSetVirtualAxis(virtualJoystick, SDL_CONTROLLER_AXIS_TRIGGERLEFT, CvfAxis(lt));
+    SDL_JoystickSetVirtualAxis(virtualJoystick, SDL_CONTROLLER_AXIS_TRIGGERRIGHT, CvfAxis(rt));
+    SDL_JoystickUpdate();
+}
+
+#pragma mark - Menu gestures
+// With a physical controller connected, only direct taps on screen elements (like a
+// character) are used; swipes, select/back taps and the menu tap are off.
+- (BOOL)controllerConnected {
+    BOOL connected = GCController.controllers.count > 0;
+    CvfSetTouchMenus(connected ? 0 : 1);
+    return connected;
+}
+
+// Swipe: move (outside fights). Tap on the right half: select. Double-tap on the right
+// half: back. Three-finger tap: Start/menu, also during fights.
+- (void)trackGestureBegan:(NSSet<UITouch *> *)touches event:(UIEvent *)event {
+    NSUInteger active = 0;
+    for (UITouch *t in event.allTouches) {
+        if (t.phase != UITouchPhaseEnded && t.phase != UITouchPhaseCancelled) {
+            active++;
+        }
+    }
+    if (self.gestureTouch == nil) {
+        UITouch *touch = touches.anyObject;
+        self.gestureTouch = touch;
+        self.gestureStart = [touch locationInView:self];
+        self.gestureTime = touch.timestamp;
+        self.gestureMaxTouches = 0;
+    }
+    self.gestureMaxTouches = MAX(self.gestureMaxTouches, active);
+}
+
+- (void)trackGestureEnded:(NSSet<UITouch *> *)touches event:(UIEvent *)event {
+    UITouch *touch = self.gestureTouch;
+    if (touch == nil) {
+        return;
+    }
+    // Wait for every finger to lift before deciding what the gesture was.
+    for (UITouch *t in event.allTouches) {
+        if (![touches containsObject:t] && t.phase != UITouchPhaseEnded && t.phase != UITouchPhaseCancelled) {
+            return;
+        }
+    }
+    self.gestureTouch = nil;
+    
+    CGPoint end = [touch locationInView:self];
+    CGFloat dx = end.x - self.gestureStart.x;
+    CGFloat dy = end.y - self.gestureStart.y;
+    CGFloat distance = hypot(dx, dy);
+    BOOL quick = touch.timestamp - self.gestureTime <= kTapTime;
+    
+    BOOL controller = [self controllerConnected];
+#if CVF_VINPUTKIT
+    // With a controller, a three-finger tap opens the controller configuration.
+    if (controller && self.gestureMaxTouches >= 3) {
+        if (quick) {
+            CvfVInputShowConfigurator();
+        }
+        return;
+    }
+#endif
+    if (self.gestureMaxTouches >= 3) {
+        if (quick && !controller) {
+            [self pressGestureButton:SDL_CONTROLLER_BUTTON_START];
+        }
+        return;
+    }
+    if (self.gestureMaxTouches != 1 || CvfInMatch()) {
+        return;
+    }
+    if (controller) {
+        if (distance <= kTapDistance && quick) {
+            CvfTouchTap(end.x / self.bounds.size.width, end.y / self.bounds.size.height);
+        }
+        return;
+    }
+    if (distance >= kSwipeDistance) {
+        DPadDirection direction;
+        if (fabs(dx) > fabs(dy)) {
+            direction = dx > 0 ? DPadDirectionRight : DPadDirectionLeft;
+        } else {
+            direction = dy > 0 ? DPadDirectionDown : DPadDirectionUp;
+        }
+        [self pressDirection:direction];
+    } else if (distance <= kTapDistance && quick) {
+        [self handleTapAt:end];
+    }
+}
+
+- (void)handleTapAt:(CGPoint)point {
+    if (self.tapPending && hypot(point.x - self.pendingTapPoint.x, point.y - self.pendingTapPoint.y) <= kDoubleTapDistance) {
+        [NSObject cancelPreviousPerformRequestsWithTarget:self selector:@selector(commitSingleTap) object:nil];
+        self.tapPending = NO;
+        [self pressGestureButton:SDL_CONTROLLER_BUTTON_BACK];
+        return;
+    }
+    if (self.tapPending) {
+        [NSObject cancelPreviousPerformRequestsWithTarget:self selector:@selector(commitSingleTap) object:nil];
+        [self commitSingleTap];
+    }
+    // Hold the tap briefly in case a second one makes it a double-tap.
+    self.tapPending = YES;
+    self.pendingTapPoint = point;
+    [self performSelector:@selector(commitSingleTap) withObject:nil afterDelay:kDoubleTapTime];
+}
+
+- (void)commitSingleTap {
+    if (!self.tapPending) {
+        return;
+    }
+    self.tapPending = NO;
+    CGPoint p = self.pendingTapPoint;
+    CGSize size = self.bounds.size;
+    // Character select reads taps itself (tap a character to move there).
+    if (CvfTouchTap(p.x / size.width, p.y / size.height)) {
+        return;
+    }
+    if (p.x >= size.width / 2.0) {
+        [self pressGestureButton:SDL_CONTROLLER_BUTTON_A];
+    }
+}
+
+// performSelector rather than dispatch_after: the engine runs inside a main queue
+// block, so blocks queued behind it would not run. Run loop timers still fire.
+- (void)pressDirection:(DPadDirection)direction {
+    [self dPad:self.dPadView didChangeDirection:direction];
+    [self performSelector:@selector(releaseDirection) withObject:nil afterDelay:kGesturePress];
+}
+
+- (void)releaseDirection {
+    [self dPad:self.dPadView didChangeDirection:DPadDirectionNeutral];
+}
+
+- (void)pressGestureButton:(SDL_GameControllerButton)button {
+    [self initVirtualJoystick];
+    if (virtualJoystick == NULL) {
+        return;
+    }
+    SDL_JoystickSetVirtualButton(virtualJoystick, (int)button, SDL_PRESSED);
+    SDL_JoystickUpdate();
+    [self performSelector:@selector(releaseGestureButton:) withObject:@(button) afterDelay:kGesturePress];
+}
+
+- (void)releaseGestureButton:(NSNumber *)button {
+    if (virtualJoystick != NULL) {
+        SDL_JoystickSetVirtualButton(virtualJoystick, button.intValue, SDL_RELEASED);
+        SDL_JoystickUpdate();
+    }
+}
+
 // This method processes touch events so that multiple button presses (A+B, X+Y, X+A, etc.) work
 - (void)processTouches:(NSSet<UITouch *> *)touches {
+    if (self.vewlixButtonView.hidden) {
+        return; // no on-screen buttons
+    }
     NSMutableSet<UIButton *> *newPressedButtons = [NSMutableSet set];
     
     // Evaluate active touch locations across the view
diff --git a/I.K.E.M.E.N-Go/ViewController.m b/I.K.E.M.E.N-Go/ViewController.m
index e850d21..85109b6 100644
--- a/I.K.E.M.E.N-Go/ViewController.m
+++ b/I.K.E.M.E.N-Go/ViewController.m
@@ -5,6 +5,10 @@
 //  Created by Jesuszilla on 8/24/26.
 //
 
+#if CVF_VINPUTKIT
+#import "vik_ios.h"
