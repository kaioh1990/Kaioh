+
+// lookupName is Names[name] with a pointer-identity cache in front: command
+// names in bytecode are string-pool entries whose data never moves, and
+// trigger code checks commands thousands of times per tick.
+func (cl *CommandList) lookupName(name string) (int, bool) {
+	p, n := unsafe.StringData(name), len(name)
+	if p == nil {
+		pos, ok := cl.Names[name]
+		return pos, ok
+	}
+	e := &cl.nameCache[(uintptr(unsafe.Pointer(p))>>3)&31]
+	if e.p == p && e.n == n {
+		return e.pos, e.ok
+	}
+	pos, ok := cl.Names[name]
+	*e = cmdNameCacheEnt{p, n, pos, ok}
