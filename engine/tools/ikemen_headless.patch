+func cvfOnlineScriptInit(l *lua.LState) {
+	cvfNearbyScriptInit(l)
+	luaRegister(l, "cvfTouchMenus", func(l *lua.LState) int {
+		l.Push(lua.LBool(cvfTouchMenus))
+		return 1
+	})
+	luaRegister(l, "cvfTouchTap", func(l *lua.LState) int {
+		cvfTapMu.Lock()
+		cvfTap.used, cvfTap.polled = true, sys.frameCounter
+		pending, x, y := cvfTap.pending, cvfTap.x, cvfTap.y
+		cvfTap.pending = false
+		cvfTapMu.Unlock()
+		if !pending {
+			return 0
+		}
+		l.Push(lua.LNumber(x))
+		l.Push(lua.LNumber(y))
+		return 2
+	})
+	luaRegister(l, "cvfOnlineHostBegin", func(l *lua.LState) int {
+		cvfOnline.hostBegin(int(numArg(l, 1)), int(sys.cfg.Netplay.Rollback.Port))
+		return 0
+	})
+	luaRegister(l, "cvfOnlineHostEnd", func(l *lua.LState) int {
+		cvfOnline.hostEnd()
+		return 0
+	})
+	luaRegister(l, "cvfOnlineHostStatus", func(l *lua.LState) int {
+		l.Push(lua.LString(cvfOnline.hostStatus()))
+		return 1
+	})
+	// Called when joining: open our UDP rollback port too, so the host can reach us.
+	luaRegister(l, "cvfOnlineJoinBegin", func(l *lua.LState) int {
+		cvfOnline.readConfig()
+		cvfOnline.openPorts(0, int(sys.cfg.Netplay.Rollback.Port))
+		return 0
+	})
+	luaRegister(l, "cvfOnlineClosePorts", func(l *lua.LState) int {
+		cvfOnline.closePorts()
+		return 0
+	})
+	luaRegister(l, "cvfLobbyEnabled", func(l *lua.LState) int {
+		cvfOnline.readConfig()
+		l.Push(lua.LBool(cvfOnline.lobbyURL != ""))
+		return 1
+	})
+	luaRegister(l, "cvfLobbyRefresh", func(l *lua.LState) int {
+		cvfOnline.refreshRooms()
+		return 0
+	})
+	// Returns rooms table, status string
+	luaRegister(l, "cvfLobbyRooms", func(l *lua.LState) int {
+		cvfOnline.mu.Lock()
+		rooms := append([]cvfRoom(nil), cvfOnline.rooms...)
+		status := cvfOnline.roomsErr
+		tag := cvfOnline.buildTag
+		cvfOnline.mu.Unlock()
+		t := l.NewTable()
+		for _, r := range rooms {
+			rt := l.NewTable()
+			rt.RawSetString("id", lua.LString(r.ID))
+			rt.RawSetString("name", lua.LString(r.Name))
+			rt.RawSetString("ip", lua.LString(r.IP))
+			rt.RawSetString("port", lua.LNumber(r.Port))
+			rt.RawSetString("open", lua.LString(r.Open))
+			rt.RawSetString("age", lua.LNumber(r.AgeSec))
+			rt.RawSetString("compatible", lua.LBool(r.Version == tag))
+			t.Append(rt)
+		}
+		l.Push(t)
+		l.Push(lua.LString(status))
+		return 2
+	})
+	luaRegister(l, "cvfGetPlayerName", func(l *lua.LState) int {
+		cvfOnline.readConfig()
+		l.Push(lua.LString(cvfOnline.playerName))
+		return 1
+	})
+	luaRegister(l, "cvfSetPlayerName", func(l *lua.LState) int {
+		cvfOnline.readConfig()
+		n := cvfCleanName(strArg(l, 1))
+		cvfOnline.mu.Lock()
+		cvfOnline.playerName = n
+		cvfOnline.mu.Unlock()
+		cvfOnline.saveProfile()
+		l.Push(lua.LString(n))
+		return 1
+	})
+	// Temporarily point the netplay connection at a lobby room's port.
+	luaRegister(l, "cvfSetNetplayPort", func(l *lua.LState) int {
+		if p := int(numArg(l, 1)); p > 0 && p < 65536 {
+			sys.cfg.Netplay.ListenPort = p
+		}
+		return 0
+	})
+	luaRegister(l, "cvfGetNetplayPort", func(l *lua.LState) int {
+		l.Push(lua.LNumber(sys.cfg.Netplay.ListenPort))
+		return 1
+	})
+}
