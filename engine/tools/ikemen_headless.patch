diff --git a/src/bc_compile.go b/src/bc_compile.go
new file mode 100644
index 0000000..d837da0
--- /dev/null
+++ b/src/bc_compile.go
@@ -0,0 +1,671 @@
+package main
+
+// Trigger expression compiler (PS Vita).
+//
+// The bytecode interpreter (BytecodeExp.run) spends most of a fight's CPU
+// time on dispatch: a switch over ~700 opcodes, operand decoding and a
+// push/pop on the global value stack for every operation. This file turns a
+// trigger expression, once at load time, into a tree of Go closures that
+// pass values directly.
+//
+// Exactness rules (the Vita must stay bit-identical with the PC build):
+//   - Every node computes its value with the same helper the interpreter
+//     uses (BytecodeExp.eq, Char.varGet, ...), in the same order.
+//   - Short-circuit jumps (jz8/jnz8/jud8) keep the tested value as the
+//     result, exactly like the interpreter leaves it on the stack.
+//   - A redirection (enemy, helper(...), ...) applies to the following
+//     operations up to and including the first one that does not "continue"
+//     in the interpreter (redirects themselves and run_caller continue);
+//     after that, operations use the original character again.
+//   - Opcodes without a native node run the interpreter's own case for that
+//     single opcode (runOC on a one-op slice), with the same current and
+//     original characters; their stack effect comes from bc_gen.go, which is
+//     generated from the interpreter source.
+//   - Anything the compiler cannot model exactly (unknown stack effect,
+//     unusual jumps, stack shuffles) makes it give up on the whole
+//     expression, which then stays interpreted.
+
+type cnode func(t, oc *Char) BytecodeValue
+
+var bcCompileStats struct{ ok, fail, native, generic int }
+
+type cparser struct {
+	be    BytecodeExp
+	fail  bool
+	depth int
+}
+
+// compileExp returns a closure equivalent to be.run(c) (call it as
+// n(c, c)), or nil when the expression must stay interpreted.
+func compileExp(be BytecodeExp) cnode {
+	if len(be) == 0 {
+		return nil
+	}
+	p := &cparser{be: be}
+	st, end := p.parse(0, len(be), nil, false)
+	if p.fail || len(st) != 1 || end != len(be) || st[0] == nil {
+		bcCompileStats.fail++
+		return nil
+	}
+	bcCompileStats.ok++
+	return st[0]
+}
+
+func (p *cparser) popFrom(st *[]cnode) cnode {
+	s := *st
+	if len(s) == 0 || s[len(s)-1] == nil {
+		p.fail = true
+		return nil
+	}
+	n := s[len(s)-1]
+	*st = s[:len(s)-1]
+	return n
+}
+
+// parse runs the symbolic stack machine over be[s:e] starting with stack
+// init; startRedir says whether the first op runs with the redirect target.
+// It returns the final stack and where parsing stopped.
+func (p *cparser) parse(s, e int, init []cnode, startRedir bool) ([]cnode, int) {
+	p.depth++
+	defer func() { p.depth-- }()
+	if p.depth > 48 {
+		p.fail = true
+		return nil, e
+	}
+	be := p.be
+	st := append([]cnode(nil), init...)
+	redir := startRedir
+	i := s
+	for i < e && !p.fail {
+		op := be[i]
+		i++
+		useT := redir
+		redir = false // most ops end a redirect (no "continue")
+		switch op {
+		case OC_nop:
+			redir = useT
+		case OC_rdreset:
+		case OC_jz8, OC_jnz8, OC_jud8:
+			if i >= e {
+				p.fail = true
+				break
+			}
+			off := int(uint8(be[i]))
+			target := len(be)
+			if off != 0 {
+				target = i + 1 + off
+			}
+			if target > e || target <= i+1 {
+				p.fail = true
+				break
+			}
+			a := p.popFrom(&st)
+			if p.fail {
+				break
+			}
+			// Not-taken path: "pop; <rest>" leaving exactly one value.
+			rest, rend := p.parse(i+1, target, []cnode{nil}, false)
+			if p.fail || rend != target || len(rest) != 1 || rest[0] == nil {
+				p.fail = true
+				break
+			}
+			b := rest[0]
+			switch op {
+			case OC_jz8:
+				st = append(st, func(t, oc *Char) BytecodeValue {
+					if v := a(t, oc); !v.ToB() {
+						return v
+					}
+					return b(t, oc)
+				})
+			case OC_jnz8:
+				st = append(st, func(t, oc *Char) BytecodeValue {
+					if v := a(t, oc); v.ToB() {
+						return v
+					}
+					return b(t, oc)
+				})
+			default:
+				st = append(st, func(t, oc *Char) BytecodeValue {
+					if v := a(t, oc); v.IsUndefined() {
+						return v
+					}
+					return b(t, oc)
+				})
+			}
+			i = target
+		case OC_jmp8:
+			if i < e && be[i] == 0 && e == len(be) {
+				return st, e // jump to the end: the result is the top
+			}
+			p.fail = true
+		case OC_pop:
+			// Only the placeholder for a jump's tested value may be
+			// dropped: its evaluation belongs to the jump node.
+			if len(st) == 0 || st[len(st)-1] != nil {
+				p.fail = true
+				break
+			}
+			st = st[:len(st)-1]
+		case OC_int8:
+			v := BytecodeInt(int32(int8(be[i])))
+			i++
+			st = append(st, func(*Char, *Char) BytecodeValue { return v })
+		case OC_int:
+			v := BytecodeInt(bcI32(be, i))
+			i += 4
+			st = append(st, func(*Char, *Char) BytecodeValue { return v })
+		case OC_float:
+			arr := []byte{byte(be[i]), byte(be[i+1]), byte(be[i+2]), byte(be[i+3])}
+			v := BytecodeFloat(Float32frombytes(arr))
+			i += 4
+			st = append(st, func(*Char, *Char) BytecodeValue { return v })
+		case OC_string:
+			v := BytecodeValue{VT_String, float64(be.readInt32At(i))}
+			i += 4
+			st = append(st, func(*Char, *Char) BytecodeValue { return v })
+		case OC_run_caller:
+			l := be.PeekLength(i)
+			sub := compileExp(be[i+4 : i+4+l])
+			if sub == nil {
+				p.fail = true
+				break
+			}
+			i += 4 + l
+			st = append(st, func(t, oc *Char) BytecodeValue { return sub(oc, oc) })
+			redir = useT // continue: the redirect stays active
+		case OC_run_redir:
+			l := be.PeekLength(i)
+			sub := compileExp(be[i+4 : i+4+l])
+			if sub == nil {
+				p.fail = true
+				break
+			}
+			i += 4 + l
+			ut := useT
+			st = append(st, func(t, oc *Char) BytecodeValue {
+				c := oc
+				if ut {
+					c = t
+				}
+				return sub(c, c) // a nested run: its original char is c
+			})
+		case OC_enemy, OC_enemynear, OC_partner, OC_helper, OC_target, OC_parent, OC_root,
+			OC_player, OC_playerid, OC_playerindex, OC_helperindex, OC_p2, OC_stateowner:
+			n := p.redirect(op, &i, e, useT, &st)
+			if !p.fail {
+				st = append(st, n)
+			}
+		case OC_ifelse:
+			v3 := p.popFrom(&st)
+			v2 := p.popFrom(&st)
+			cond := p.popFrom(&st)
+			if p.fail {
+				break
+			}
+			st = append(st, func(t, oc *Char) BytecodeValue {
+				cv := cond(t, oc)
+				a := v2(t, oc)
+				b := v3(t, oc)
+				if cv.ToB() {
+					return a
+				}
+				return b
+			})
+		default:
+			n := p.simple(op, &i, e, useT, &st)
+			if !p.fail {
+				st = append(st, n)
+			}
+		}
+	}
+	if redir {
+		p.fail = true
+	}
+	return st, e
+}
+
+// redirect parses a redirection opcode and its block.
+func (p *cparser) redirect(op OpCode, ip *int, e int, useT bool, st *[]cnode) cnode {
+	be := p.be
+	i := *ip
+	var a1, a2 cnode
+	switch op {
+	case OC_helper, OC_target:
+		a2 = p.popFrom(st)
+		a1 = p.popFrom(st)
+	case OC_enemy, OC_enemynear, OC_partner, OC_player, OC_playerid, OC_playerindex, OC_helperindex:
+		a1 = p.popFrom(st)
+	}
+	resolve := redirResolver(op)
+	if p.fail || i+4 > e || resolve == nil {
+		p.fail = true
+		return nil
+	}
+	l := be.PeekLength(i)
+	bs, bend := i+4, i+4+l
+	if l <= 0 || bend > e {
+		p.fail = true
+		return nil
+	}
+	bst, end := p.parse(bs, bend, nil, true)
+	if p.fail || end != bend || len(bst) != 1 || bst[0] == nil {
+		p.fail = true
+		return nil
+	}
+	blk := bst[0]
+	*ip = bend
+	ut := useT
+	return func(t, oc *Char) BytecodeValue {
+		c := oc
+		if ut {
+			c = t
+		}
+		var x1, x2 BytecodeValue
+		if a1 != nil {
+			x1 = a1(t, oc)
+		}
+		if a2 != nil {
+			x2 = a2(t, oc)
+		}
+		tgt := resolve(c, x1, x2)
+		if tgt == nil {
+			return BytecodeUndefined()
+		}
+		return blk(tgt, oc)
+	}
+}
+
+func redirResolver(op OpCode) func(c *Char, x1, x2 BytecodeValue) *Char {
+	switch op {
+	case OC_enemy:
+		return func(c *Char, x1, _ BytecodeValue) *Char { return c.enemy(x1.ToI()) }
+	case OC_enemynear:
+		return func(c *Char, x1, _ BytecodeValue) *Char { return c.enemyNearTrigger(x1.ToI()) }
+	case OC_partner:
+		return func(c *Char, x1, _ BytecodeValue) *Char { return c.partner(x1.ToI(), true) }
+	case OC_helper:
+		return func(c *Char, x1, x2 BytecodeValue) *Char { return c.helperTrigger(x1.ToI(), int(x2.ToI())) }
+	case OC_target:
+		return func(c *Char, x1, x2 BytecodeValue) *Char { return c.targetTrigger(x1.ToI(), int(x2.ToI())) }
+	case OC_parent:
+		return func(c *Char, _, _ BytecodeValue) *Char { return c.parent(true) }
+	case OC_root:
+		return func(c *Char, _, _ BytecodeValue) *Char { return c.root(true) }
+	case OC_player:
+		return func(c *Char, x1, _ BytecodeValue) *Char { return c.playerTrigger(int(x1.ToI()), true) }
+	case OC_playerid:
+		return func(c *Char, x1, _ BytecodeValue) *Char { return c.playerIDTrigger(x1.ToI(), true) }
+	case OC_playerindex:
+		return func(c *Char, x1, _ BytecodeValue) *Char { return c.playerIndexTrigger(x1.ToI()) }
+	case OC_helperindex:
+		return func(c *Char, x1, _ BytecodeValue) *Char { return c.helperIndexTrigger(x1.ToI()) }
+	case OC_p2:
+		return func(c *Char, _, _ BytecodeValue) *Char { return c.p2() }
+	case OC_stateowner:
+		return func(c *Char, _, _ BytecodeValue) *Char { return c.stateOwner() }
+	}
+	return nil
+}
+
+// simple handles every other opcode: native nodes for the frequent ones,
+// otherwise a generic node that runs the interpreter case.
+func (p *cparser) simple(op OpCode, ip *int, e int, useT bool, st *[]cnode) cnode {
+	be := p.be
+	start := *ip - 1
+	// Stack effect and operand length.
+	var arity, operand int
+	switch op {
+	case OC_const_, OC_ex_, OC_ex2_, OC_ex3_:
+		if *ip >= e {
+			p.fail = true
+			return nil
+		}
+		sub := be[*ip]
+		var tab map[OpCode][2]int8
+		switch op {
+		case OC_const_:
+			tab = bcGenSubConst
+		case OC_ex_:
+			tab = bcGenSubEx
+		case OC_ex2_:
+			tab = bcGenSubEx2
+		default:
+			tab = bcGenSubEx3
+		}
+		r, ok := tab[sub]
+		if !ok {
+			p.fail = true
+			return nil
+		}
+		arity, operand = int(r[0]), 1+int(r[1])
+	default:
+		r, ok := bcGenMain[op]
+		if !ok {
+			p.fail = true
+			return nil
+		}
+		arity, operand = int(r[0]), int(r[1])
+	}
+	end := *ip + operand
+	if end > e || len(*st) < arity {
+		p.fail = true
+		return nil
+	}
+	args := make([]cnode, arity)
+	for k := arity - 1; k >= 0; k-- {
+		args[k] = p.popFrom(st)
+	}
+	if p.fail {
+		return nil
+	}
+	*ip = end
+	if n := nativeNode(op, be, start, args, useT); n != nil {
+		bcCompileStats.native++
+		return n
+	}
+	bcCompileStats.generic++
+	seg := append(BytecodeExp(nil), be[start:end]...)
+	ut := useT
+	switch arity {
+	case 0:
+		return func(t, oc *Char) BytecodeValue {
+			c := oc
+			if ut {
+				c = t
+			}
+			return seg.runOC(c, oc)
+		}
+	case 1:
+		a0 := args[0]
+		return func(t, oc *Char) BytecodeValue {
+			v0 := a0(t, oc)
+			c := oc
+			if ut {
+				c = t
+			}
+			sys.bcStack.Push(v0)
+			return seg.runOC(c, oc)
+		}
+	default:
+		return func(t, oc *Char) BytecodeValue {
+			var vs [4]BytecodeValue
+			var big []BytecodeValue
+			if len(args) > len(vs) {
+				big = make([]BytecodeValue, len(args))
+			}
+			for k, a := range args {
+				if big != nil {
+					big[k] = a(t, oc)
+				} else {
+					vs[k] = a(t, oc)
+				}
+			}
+			c := oc
+			if ut {
+				c = t
+			}
+			for k := range args {
+				if big != nil {
+					sys.bcStack.Push(big[k])
+				} else {
+					sys.bcStack.Push(vs[k])
+				}
+			}
+			return seg.runOC(c, oc)
+		}
+	}
+}
+
+// nativeNode returns a direct implementation of op, mirroring the
+// interpreter case line for line, or nil.
+func nativeNode(op OpCode, be BytecodeExp, start int, args []cnode, useT bool) cnode {
+	var bx BytecodeExp // receiver for the value helpers (stateless)
+	switch len(args) {
+	case 2:
+		a, b := args[0], args[1]
+		// One closure per operator with a direct call: passing &v1 through a
+		// func value makes TinyGo heap-allocate v1 on every evaluation.
+		switch op {
+		case OC_add:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.add(&v1, v2); return v1 }
+		case OC_sub:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.sub(&v1, v2); return v1 }
+		case OC_mul:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.mul(&v1, v2); return v1 }
+		case OC_div:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.div(&v1, v2); return v1 }
+		case OC_mod:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.mod(&v1, v2); return v1 }
+		case OC_eq:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.eq(&v1, v2); return v1 }
+		case OC_ne:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.ne(&v1, v2); return v1 }
+		case OC_gt:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.gt(&v1, v2); return v1 }
+		case OC_ge:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.ge(&v1, v2); return v1 }
+		case OC_lt:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.lt(&v1, v2); return v1 }
+		case OC_le:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.le(&v1, v2); return v1 }
+		case OC_bland:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.bland(&v1, v2); return v1 }
+		case OC_blor:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.blor(&v1, v2); return v1 }
+		case OC_blxor:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.blxor(&v1, v2); return v1 }
+		case OC_bwand:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.bwand(&v1, v2); return v1 }
+		case OC_bwor:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.bwor(&v1, v2); return v1 }
+		case OC_bwxor:
+			return func(t, oc *Char) BytecodeValue { v1 := a(t, oc); v2 := b(t, oc); bx.bwxor(&v1, v2); return v1 }
+		}
+		return nil
+	case 3:
+		switch op {
+		case OC_range_ii, OC_range_ie, OC_range_ei, OC_range_ee:
+			a, b, c3 := args[0], args[1], args[2]
+			kind := op
+			return func(t, oc *Char) BytecodeValue {
+				v1 := a(t, oc)
+				v2 := b(t, oc)
+				v3 := c3(t, oc)
+				bx.rangeCheck(&v1, v2, v3, kind)
+				return v1
+			}
+		}
+		return nil
+	case 1:
+		a := args[0]
+		switch op {
+		case OC_neg:
+			return func(t, oc *Char) BytecodeValue { v := a(t, oc); bx.neg(&v); return v }
+		case OC_blnot:
+			return func(t, oc *Char) BytecodeValue { v := a(t, oc); bx.blnot(&v); return v }
+		case OC_bwnot:
+			return func(t, oc *Char) BytecodeValue { v := a(t, oc); bx.bwnot(&v); return v }
+		case OC_abs:
+			return func(t, oc *Char) BytecodeValue { v := a(t, oc); bx.abs(&v); return v }
+		case OC_floor:
+			return func(t, oc *Char) BytecodeValue { v := a(t, oc); bx.floor(&v); return v }
+		case OC_ceil:
+			return func(t, oc *Char) BytecodeValue { v := a(t, oc); bx.ceil(&v); return v }
+		}
+		var g func(c *Char, v BytecodeValue) BytecodeValue
+		switch op {
+		case OC_var:
+			g = func(c *Char, v BytecodeValue) BytecodeValue { return c.varGet(v.ToI()) }
+		case OC_fvar:
+			g = func(c *Char, v BytecodeValue) BytecodeValue { return c.fvarGet(v.ToI()) }
+		case OC_sysvar:
+			g = func(c *Char, v BytecodeValue) BytecodeValue { return c.sysVarGet(v.ToI()) }
+		case OC_sysfvar:
+			g = func(c *Char, v BytecodeValue) BytecodeValue { return c.sysFvarGet(v.ToI()) }
+		case OC_numhelper:
+			g = func(c *Char, v BytecodeValue) BytecodeValue { return c.numHelper(v) }
+		case OC_numexplod:
+			g = func(c *Char, v BytecodeValue) BytecodeValue { return c.numExplod(v) }
+		case OC_numprojid:
+			g = func(c *Char, v BytecodeValue) BytecodeValue { return c.numProjID(v) }
+		case OC_selfanimexist:
+			g = func(c *Char, v BytecodeValue) BytecodeValue { return c.selfAnimExist(v) }
+		case OC_animexist:
+			g = func(c *Char, v BytecodeValue) BytecodeValue { return c.animExist(v) }
+		case OC_animelemtime:
+			g = func(c *Char, v BytecodeValue) BytecodeValue { return c.animElemTime(v.ToI()) }
+		case OC_animelemno:
+			g = func(c *Char, v BytecodeValue) BytecodeValue { return c.animElemNo(v.ToI()) }
+		}
+		if g == nil {
+			return nil
+		}
+		ut := useT
+		return func(t, oc *Char) BytecodeValue {
+			v := a(t, oc)
+			c := oc
+			if ut {
+				c = t
+			}
+			return g(c, v)
+		}
+	case 0:
+		var g func(c *Char) BytecodeValue
+		switch op {
+		case OC_stateno:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.ss.no) }
+		case OC_prevstateno:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.ss.prevno) }
+		case OC_anim:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.animNo) }
+		case OC_time:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.ss.time) }
+		case OC_life:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.life) }
+		case OC_lifemax:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.lifeMax) }
+		case OC_ctrl:
+			g = func(c *Char) BytecodeValue { return BytecodeBool(c.ctrl()) }
+		case OC_alive:
+			g = func(c *Char) BytecodeValue { return BytecodeBool(c.alive()) }
+		case OC_facing:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(int32(c.facing)) }
+		case OC_roundstate:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(sys.roundState()) }
+		case OC_gametime:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(sys.gameTime()) }
+		case OC_numenemy:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.numEnemy()) }
+		case OC_numpartner:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.numPartner()) }
+		case OC_movecontact:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.moveContact()) }
+		case OC_movehit:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.moveHit()) }
+		case OC_moveguarded:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.moveGuarded()) }
+		case OC_power:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.getPower()) }
+		case OC_powermax:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.powerMax) }
+		case OC_random:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(Rand(0, 999)) }
+		case OC_animtime:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.animTime()) }
+		case OC_numproj:
+			g = func(c *Char) BytecodeValue { return BytecodeInt(c.numProj()) }
+		}
+		if g == nil {
+			return nil
+		}
+		ut := useT
+		return func(t, oc *Char) BytecodeValue {
+			if ut {
+				return g(t)
+			}
+			return g(oc)
+		}
+	}
+	return nil
+}
+
+// ---- integration ----
+
+var cjitOn = -1
+var cjitCheck = false
+
+// cjitEnabled: on the Vita unless ux0:data/CvF/vita_nojit.txt exists;
+// vita_jitcheck.txt runs both paths and logs any difference (emulator use).
+func cjitEnabled() bool {
+	if cjitOn < 0 {
+		cjitOn = 0
+		// Off by default: correct, but measured slower than the fused
+		// interpreter on the Vita (indirect calls). Opt in with vita_jit.txt.
+		if fuseEnabled() && FileExist("vita_jit.txt") != "" && FileExist("vita_nojit.txt") == "" {
+			cjitOn = 1
+		}
+		cjitCheck = FileExist("vita_jitcheck.txt") != ""
+	}
+	return cjitOn == 1
+}
+
+// compileBlockTriggers saves an unfused copy of the trigger of every block
+// in b. Must run before fuseBytecode (the compiler reads the unfused
+// bytecode). The closure itself is built on first use, from evalTrigger:
+// character loading runs on a goroutine with a small fixed stack (256 KB in
+// TinyGo), too small for the recursive parser on long trigger chains,
+// whereas the game loop runs on the main stack. It also skips the work for
+// the many controllers that never run in a given match.
+func compileBlockTriggers(b *StateBlock) {
+	if b == nil || !cjitEnabled() {
+		return
+	}
+	if len(b.trigger) > 0 && b.ctrig == nil && b.trigRaw == nil {
+		b.trigRaw = append(BytecodeExp(nil), b.trigger...)
+	}
+	if b.elseBlock != nil {
+		compileBlockTriggers(b.elseBlock)
+	}
+	for _, sc := range b.ctrls {
+		if sb, ok := sc.(*StateBlock); ok {
+			compileBlockTriggers(sb)
+		}
+	}
+}
+
+// cjitStatsLine reports how many triggers were compiled so far.
+func cjitStatsLine() string {
+	return "jit: compiled triggers " + itoa(bcCompileStats.ok) + ", interpreted " + itoa(bcCompileStats.fail) +
+		"; native ops " + itoa(bcCompileStats.native) + ", generic " + itoa(bcCompileStats.generic)
+}
+
+var cjitMismatch int
+
+// evalTrigger evaluates b's trigger with the compiled closure when present.
+func (b *StateBlock) evalTrigger(c *Char) bool {
+	if b.trigRaw != nil {
+		b.ctrig = compileExp(b.trigRaw)
+		b.trigRaw = nil
+	}
+	if b.ctrig == nil {
+		return b.trigger.evalB(c)
+	}
+	if !cjitCheck {
+		return b.ctrig(c, c).ToB()
+	}
+	seed := sys.randseed
+	vc := b.ctrig(c, c)
+	seedC := sys.randseed
+	sys.randseed = seed
+	vi := b.trigger.run(c)
+	if vc != vi || seedC != sys.randseed {
+		cjitMismatch++
+		if cjitMismatch <= 40 {
+			vitaTrace("jitcheck: MISMATCH p" + itoa(c.playerNo) + " st " + itoa(int(c.ss.no)) +
+				" compiled " + vc.ToS() + "/" + itoa(int(vc.vtype)) + " interp " + vi.ToS() + "/" + itoa(int(vi.vtype)) +
+				" seeds " + itoa(int(seedC)) + "/" + itoa(int(sys.randseed)))
+		}
+	}
+	return vi.ToB()
+}
diff --git a/src/bc_fuse.go b/src/bc_fuse.go
new file mode 100644
index 0000000..2f7e453
--- /dev/null
+++ b/src/bc_fuse.go
@@ -0,0 +1,355 @@
+package main
+
+// Peephole fusion for the Vita bytecode interpreter.
+//
+// Fight logic on the Vita is dominated by the interpreter loop, about 60k
+// operations per tick per player with CvF's shared -3 state, and each
+// dispatch costs more than the work it does. fuseBytecode rewrites the most
+// common two-op sequences into single fused opcodes:
+//
+//	int8 n; var         -> var8 n nop        (also fvar, sysvar)
+//	int8 n; eq/ne/..    -> eq8 n nop ...
+//	jz8 k; pop          -> jz8p k nop        (the "triggerall" separator)
+//
+// Every rewrite keeps the byte length, so no jump target moves; the padding
+// byte is a real no-op opcode in case anything lands on it. The walker only
+// steps across opcodes whose operand size it knows and stops at the first it
+// doesn't, so an unknown opcode can never be mis-decoded.
+
+var fuseFlag = -1
+
+// fuseEnabled: on the Vita unless ux0:data/CvF/vita_nofuse.txt exists
+// (also disables trigger hoisting), for A/B checks with the state hash.
+func fuseEnabled() bool {
+	if fuseFlag < 0 {
+		fuseFlag = 0
+		if vitaPerf && FileExist("vita_nofuse.txt") == "" {
+			fuseFlag = 1
+		}
+	}
+	return fuseFlag == 1
+}
+
+var fuseStats struct{ exprs, fused int }
+
+func fuseBytecode(sb *StateBytecode) {
+	if !fuseEnabled() || sb == nil {
+		return
+	}
+	fuseExp(sb.stateTypeExp)
+	fuseExp(sb.moveTypeExp)
+	fuseExp(sb.physicsExp)
+	fuseBlock(&sb.block)
+}
+
+func fuseBlock(b *StateBlock) {
+	if b == nil {
+		return
+	}
+	fuseExp(b.trigger)
+	fuseExp(b.forCtrlVar.be)
+	for i := range b.forExpression {
+		fuseExp(b.forExpression[i])
+	}
+	if b.elseBlock != nil {
+		fuseBlock(b.elseBlock)
+	}
+	for _, sc := range b.ctrls {
+		switch c := sc.(type) {
+		case *StateBlock:
+			fuseBlock(c)
+		case StateExpr:
+			fuseExp(BytecodeExp(c))
+		case varAssign:
+			fuseExp(c.be)
+		default:
+			fuseController(sc)
+		}
+	}
+}
+
+// fuseController fuses the parameter expressions of a state controller. The
+// controllers are all StateControllerBase ([]byte of "paramID; count;
+// expr-length; expr..." entries) wrapped in distinct named types; sc_runfn.go
+// knows them all, so it provides the conversion.
+func fuseController(sc StateController) {
+	scb, ok := scBase(sc)
+	if !ok {
+		return
+	}
+	for _, p := range scb {
+		for _, e := range p.exp {
+			fuseExp(e)
+		}
+	}
+}
+
+// opLen returns the operand length of a base opcode, or -1 when the walker
+// must stop (unknown opcode, or a nested block it handles separately).
+func opLen(op OpCode) int {
+	switch op {
+	case OC_jud8, OC_jz8, OC_jnz8, OC_jmp8, OC_int8, OC_localvar,
+		OC_statetype, OC_movetype, OC_teammode:
+		return 1
+	case OC_jz, OC_jnz, OC_jmp, OC_int, OC_float, OC_string, OC_hitdefattr:
+		return 4
+	case OC_int64:
+		return 8
+	case OC_var8, OC_fvar8, OC_sysvar8, OC_eq8, OC_ne8, OC_lt8, OC_gt8, OC_le8, OC_ge8, OC_jz8p, OC_jnz8p:
+		return 2
+	case OC_eq32, OC_ne32, OC_lt32, OC_gt32, OC_le32, OC_ge32:
+		return 5
+	case OC_range_ii8, OC_range_ie8, OC_range_ei8, OC_range_ee8:
+		return 4
+	case OC_range_ii32, OC_range_ie32, OC_range_ei32, OC_range_ee32:
+		return 10
+	case OC_tcmp8:
+		return 6
+	case OC_tcmp32:
+		return 9
+	case OC_trange8:
+		return 8
+	case OC_trange32:
+		return 14
+	case OC_tvcmp8:
+		return 8
+	case OC_player, OC_parent, OC_root, OC_helper, OC_target, OC_partner, OC_enemy,
+		OC_enemynear, OC_playerid, OC_playerindex, OC_p2, OC_stateowner, OC_helperindex,
+		OC_run_redir, OC_run_caller:
+		return -2 // 4-byte length + nested block
+	case OC_ex_, OC_ex2_, OC_ex3_, OC_const_, OC_assign_:
+		return -1 // sub-opcodes with their own operands: stop here
+	}
+	if op < OC_ex3_ {
+		return 0 // plain trigger / operator
+	}
+	return -1
+}
+
+func fuseExp(be BytecodeExp) {
+	if len(be) == 0 {
+		return
+	}
+	fuseStats.exprs++
+	fuseExp1(be)
+	fuseLines(be)
+}
+
+func fuseExp1(be BytecodeExp) {
+	i := 0
+	for i < len(be) {
+		op := be[i]
+		// Fusions: check the two-op patterns at i.
+		if op == OC_int8 && i+2 < len(be) {
+			var f OpCode
+			switch be[i+2] {
+			case OC_var:
+				f = OC_var8
+			case OC_fvar:
+				f = OC_fvar8
+			case OC_sysvar:
+				f = OC_sysvar8
+			case OC_eq:
+				f = OC_eq8
+			case OC_ne:
+				f = OC_ne8
+			case OC_lt:
+				f = OC_lt8
+			case OC_gt:
+				f = OC_gt8
+			case OC_le:
+				f = OC_le8
+			case OC_ge:
+				f = OC_ge8
+			}
+			if f != 0 {
+				be[i], be[i+2] = f, OC_nop
+				fuseStats.fused++
+				i += 3
+				continue
+			}
+		}
+		if op == OC_int8 && i+5 < len(be) && be[i+2] == OC_int8 && be[i+4] >= OC_range_ii && be[i+4] <= OC_range_ee {
+			// int8 a; int8 b; range -> range8 a b nop nop
+			be[i] = be[i+4] - OC_range_ii + OC_range_ii8
+			be[i+2] = be[i+3] // b
+			be[i+3], be[i+4] = OC_nop, OC_nop
+			fuseStats.fused++
+			i += 5
+			continue
+		}
+		if op == OC_int && i+5 < len(be) {
+			var f OpCode
+			switch be[i+5] {
+			case OC_eq:
+				f = OC_eq32
+			case OC_ne:
+				f = OC_ne32
+			case OC_lt:
+				f = OC_lt32
+			case OC_gt:
+				f = OC_gt32
+			case OC_le:
+				f = OC_le32
+			case OC_ge:
+				f = OC_ge32
+			}
+			if f != 0 {
+				be[i], be[i+5] = f, OC_nop
+				fuseStats.fused++
+				i += 6
+				continue
+			}
+			if i+10 < len(be) && be[i+5] == OC_int && be[i+10] >= OC_range_ii && be[i+10] <= OC_range_ee {
+				// int a; int b; range -> range32 a b nop nop
+				be[i] = be[i+10] - OC_range_ii + OC_range_ii32
+				copy(be[i+5:i+9], be[i+6:i+10])
+				be[i+9], be[i+10] = OC_nop, OC_nop
+				fuseStats.fused++
+				i += 11
+				continue
+			}
+		}
+		if (op == OC_jz8 || op == OC_jnz8) && i+2 < len(be) && be[i+2] == OC_pop {
+			// Only when the jump can't land on the pop we're removing: a
+			// forward jump of k lands at i+2+k, which equals the pop only
+			// for k == 0 (meaning "end of expression"), so this is always safe.
+			if op == OC_jz8 {
+				be[i] = OC_jz8p
+			} else {
+				be[i] = OC_jnz8p
+			}
+			be[i+2] = OC_nop
+			fuseStats.fused++
+			i += 3
+			continue
+		}
+		n := opLen(op)
+		switch {
+		case n >= 0:
+			i += 1 + n
+		case n == -2:
+			if i+5 > len(be) {
+				return
+			}
+			l := int(bcI32([]OpCode(be), i+1))
+			if l < 0 || i+5+l > len(be) {
+				return
+			}
+			fuseExp(be[i+5 : i+5+l])
+			i += 5 + l
+		default:
+			return
+		}
+	}
+}
+
+// isSimpleTrigger reports whether t is a one-byte trigger pushTrigger handles.
+func isSimpleTrigger(t OpCode) bool {
+	switch t {
+	case OC_stateno, OC_prevstateno, OC_life, OC_lifemax, OC_roundstate, OC_time, OC_alive, OC_ctrl,
+		OC_anim, OC_numpartner, OC_numenemy, OC_gametime, OC_power, OC_facing, OC_hitpausetime,
+		OC_movecontact, OC_movehit, OC_teamside, OC_id:
+		return true
+	}
+	return false
+}
+
+func isCmp8(op OpCode) bool  { return op >= OC_eq8 && op <= OC_ge8 }
+func isCmp32(op OpCode) bool { return op >= OC_eq32 && op <= OC_ge32 }
+func cmpOf8(op OpCode) OpCode {
+	switch op {
+	case OC_eq8:
+		return OC_eq
+	case OC_ne8:
+		return OC_ne
+	case OC_lt8:
+		return OC_lt
+	case OC_gt8:
+		return OC_gt
+	case OC_le8:
+		return OC_le
+	}
+	return OC_ge
+}
+func cmpOf32(op OpCode) OpCode { return cmpOf8(op - OC_eq32 + OC_eq8) }
+
+// fuseLines runs after fuseExp1 and folds "T; cmp k; jz8p 0" lines.
+func fuseLines(be BytecodeExp) {
+	i := 0
+	for i < len(be) {
+		op := be[i]
+		if isSimpleTrigger(op) {
+			// T; cmp8 n nop; jz8p 0 nop  (7 bytes)
+			if i+6 < len(be) && isCmp8(be[i+1]) && be[i+4] == OC_jz8p && be[i+5] == 0 {
+				t, cmp, n := op, cmpOf8(be[i+1]), be[i+2]
+				be[i], be[i+1], be[i+2], be[i+3] = OC_tcmp8, t, cmp, n
+				be[i+4], be[i+5], be[i+6] = OC_nop, OC_nop, OC_nop
+				fuseStats.fused++
+				i += 7
+				continue
+			}
+			// T; cmp32 n(4) nop; jz8p 0 nop  (10 bytes)
+			if i+9 < len(be) && isCmp32(be[i+1]) && be[i+7] == OC_jz8p && be[i+8] == 0 {
+				t, cmp := op, cmpOf32(be[i+1])
+				var k [4]OpCode
+				copy(k[:], be[i+2:i+6])
+				be[i], be[i+1], be[i+2] = OC_tcmp32, t, cmp
+				copy(be[i+3:i+7], k[:])
+				be[i+7], be[i+8], be[i+9] = OC_nop, OC_nop, OC_nop
+				fuseStats.fused++
+				i += 10
+				continue
+			}
+			// T; rangeR8 a b nop nop; jz8p 0 nop  (9 bytes)
+			if i+8 < len(be) && be[i+1] >= OC_range_ii8 && be[i+1] <= OC_range_ee8 && be[i+6] == OC_jz8p && be[i+7] == 0 {
+				t, r, a, b := op, be[i+1]-OC_range_ii8+OC_range_ii, be[i+2], be[i+3]
+				be[i], be[i+1], be[i+2], be[i+3], be[i+4] = OC_trange8, t, r, a, b
+				be[i+5], be[i+6], be[i+7], be[i+8] = OC_nop, OC_nop, OC_nop, OC_nop
+				fuseStats.fused++
+				i += 9
+				continue
+			}
+			// T; rangeR32 a(4) b(4) nop nop; jz8p 0 nop  (15 bytes)
+			if i+14 < len(be) && be[i+1] >= OC_range_ii32 && be[i+1] <= OC_range_ee32 && be[i+12] == OC_jz8p && be[i+13] == 0 {
+				t, r := op, be[i+1]-OC_range_ii32+OC_range_ii
+				var ab [8]OpCode
+				copy(ab[:], be[i+2:i+10])
+				be[i], be[i+1], be[i+2] = OC_trange32, t, r
+				copy(be[i+3:i+11], ab[:])
+				be[i+11], be[i+12], be[i+13], be[i+14] = OC_nop, OC_nop, OC_nop, OC_nop
+				fuseStats.fused++
+				i += 15
+				continue
+			}
+		}
