+func (c *CharCompiler) expValueStateType(out *BytecodeExp, in *string, rd bool) (BytecodeValue, error) {
+	trname := c.token
+	pushSelf := func() {
+		if trname == "prevstatetype" {
+			out.append(OC_ex_, OC_ex_prevstatetype, 0)
+		} else if trname == "p2statetype" {
+			var sub BytecodeExp
+			sub.append(OC_statetype, 0)
+			out.appendI32Op(OC_p2, int32(len(sub)))
+			out.append(sub...)
+		} else {
+			out.append(OC_statetype, 0)
+		}
+	}
+	if err := c.flagTrigger(out, in, pushSelf, func(not bool) (bool, error) {
+		if len(c.token) == 0 {
+			return false, Error(trname + " trigger requires a comparison")
+		}
+		var st StateType
+		switch c.token[0] {
+		case 's':
+			st = ST_S
+		case 'c':
+			st = ST_C
+		case 'a':
+			st = ST_A
+		case 'l':
+			st = ST_L
+		default:
+			return false, nil
+		}
+		if trname == "prevstatetype" {
+			out.append(OC_ex_, OC_ex_prevstatetype, OpCode(st))
+			if not {
+				out.append(OC_blnot)
+			}
+		} else if trname == "p2statetype" {
+			var sub BytecodeExp
+			sub.append(OC_statetype, OpCode(st))
+			if not {
+				sub.append(OC_blnot)
+			}
+			out.appendI32Op(OC_p2, int32(len(sub)))
+			out.append(sub...)
+		} else {
+			out.append(OC_statetype, OpCode(st))
+			if not {
+				out.append(OC_blnot)
+			}
+		}
+		return true, nil
+	}); err != nil {
+		return bvNone(), err
+	}
+	return bvNone(), nil
+}
