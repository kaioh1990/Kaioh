diff --git a/src/cvf_fingerprint.go b/src/cvf_fingerprint.go
new file mode 100644
index 0000000..ae8e26c
--- /dev/null
+++ b/src/cvf_fingerprint.go
@@ -0,0 +1,332 @@
+package main
+
+// CvF Online: game content fingerprint for the netplay handshake.
+//
+// Two peers whose game data differ (another cvf_online.ini, an edited common
+// state file, another version of a character or stage) used to connect and
+// then desync silently. The handshake's content_fingerprint field (empty in
+// Ikemen GO) now carries a table of content hashes, computed once per run:
+//
+//   cvf1;r=<rules>;d=<data>;c/<char dir>=<hash>;...;s/<stage def>=<hash>;...
+//
+//   r  the gameplay rules of data/cvf_online.ini as parsed (cvfRules), so the
+//      lobby URL, BuildTag, comments and the display-only WideView do not count
+//   d  every simulation text file under data/ (common states, commands,
+//      animations and constants, *.zss, fight.def, select.def, system.def)
+//      except cvf_online.ini
+//   c  one entry per directory under chars/ that holds a .def file: its text
+//      files (*.def, *.cns, *.st, *.cmd, *.air, *.zss, *.const), recursively
+//   s  one entry per stage .def under stages/
+//
+// Hashes are 64-bit FNV-1a over the relative path and the bytes of each file,
+// with carriage returns skipped (a CRLF checkout plays the same). Sprites,
+// sounds, palettes and music are not hashed: they do not change the
+// simulation and are big (hashing the text of a full roster is a few tens of
+// MB, read once).
+//
+// The rules and data entries must match when the session starts (the
+// handshake fails with a message naming the difference). Character and stage
+// entries are checked at the start of every match, for the characters and the
+// stage actually loaded, so peers whose unused characters differ still play.
+// An empty fingerprint (an older build, or Ikemen GO itself) means "unknown":
+// the session is allowed, as before. Older builds receiving this table ignore
+// it (they only compare non-empty fingerprints of their own, and theirs is
+// empty).
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+const cvfFpVersion = "cvf1"
+
+const (
+	cvfFpOffset uint64 = 14695981039346656037
+	cvfFpPrime  uint64 = 1099511628211
+)
+
+var cvfFpCache string
+var cvfFpDone bool
+
+func cvfFpBytes(h uint64, b []byte) uint64 {
+	for _, c := range b {
+		if c == '\r' {
+			continue
+		}
+		h ^= uint64(c)
+		h *= cvfFpPrime
+	}
+	return h
+}
+
+func cvfFpString(h uint64, s string) uint64 {
+	return cvfFpBytes(h, []byte(s))
+}
+
+func cvfFpHex(h uint64) string {
+	const digits = "0123456789abcdef"
+	var b [16]byte
+	for i := 15; i >= 0; i-- {
+		b[i] = digits[h&15]
+		h >>= 4
+	}
+	return string(b[:])
+}
+
+func cvfFpIsText(name string) bool {
+	switch strings.ToLower(filepath.Ext(name)) {
+	case ".def", ".cns", ".st", ".cmd", ".air", ".zss", ".const":
+		return true
+	}
+	return false
+}
+
+type cvfFpFile struct {
+	rel  string // slash path relative to the content root, lower case
+	hash uint64
+}
+
+// The simulation text files under root (a directory of the game folder), in
+// path order. Symbolic links to directories are followed, root included
+// ("root/." is walked): the native engine's filepath.Walk follows them and
+// Go's does not, and both must see the same files.
+func cvfFpWalk(root string, nfiles, nbytes *int) []cvfFpFile {
+	var files []cvfFpFile
+	cvfFpWalkDir(root, "", 0, &files, nfiles, nbytes)
+	sort.Slice(files, func(i, j int) bool { return files[i].rel < files[j].rel })
+	return files
+}
+
+func cvfFpWalkDir(dir, rel string, depth int, files *[]cvfFpFile, nfiles, nbytes *int) {
+	base := filepath.ToSlash(filepath.Clean(dir)) + "/"
+	filepath.Walk(dir+"/.", func(path string, info os.FileInfo, err error) error {
+		if err != nil || info == nil {
+			return nil
+		}
+		p := filepath.ToSlash(filepath.Clean(path))
+		if !strings.HasPrefix(p, base) {
+			return nil // dir itself
+		}
+		r := rel + p[len(base):]
+		name := filepath.Base(p)
+		if info.IsDir() {
+			return nil
+		}
+		if !cvfFpIsText(name) {
+			// a link to a directory (Go's Walk reports the link, not a directory)
+			if st, serr := os.Stat(path); serr == nil && st.IsDir() && depth < 8 {
+				cvfFpWalkDir(path, r+"/", depth+1, files, nfiles, nbytes)
+			}
+			return nil
+		}
+		data, rerr := os.ReadFile(path)
+		if rerr != nil {
+			return nil
+		}
+		*nfiles++
+		*nbytes += len(data)
+		*files = append(*files, cvfFpFile{rel: strings.ToLower(r), hash: cvfFpBytes(cvfFpOffset, data)})
+		return nil
+	})
+}
+
+// Hash of a set of files: their relative paths (from prefix on) and hashes.
+func cvfFpCombine(files []cvfFpFile, prefix string) uint64 {
+	h := cvfFpOffset
+	for _, f := range files {
+		h = cvfFpString(h, f.rel[len(prefix):])
+		h = cvfFpString(h, "\x00"+cvfFpHex(f.hash)+"\x00")
+	}
+	return h
+}
+
+func cvfFpRules() uint64 {
+	r := cvfRulesLoad()
+	s := fmt.Sprintf("iframe=%d exempt=%d-%d mpvar=%d mpscale=%d cooldown=%d special=%d-%d aspect=%d:%d author=%s",
+		r.iframeCap, r.exemptLo, r.exemptHi, r.mpVar, r.mpScaleMilli, r.specialCD, r.specialLo, r.specialHi,
+		r.fightAspect[0], r.fightAspect[1], r.author)
+	return cvfFpString(cvfFpOffset, s)
+}
+
+// The content fingerprint of this game folder (computed on first use).
+func cvfContentFingerprint() string {
+	if cvfFpDone {
+		return cvfFpCache
+	}
+	cvfFpDone = true
+	t0 := time.Now()
+	nfiles, nbytes := 0, 0
+	var sb strings.Builder
+	sb.WriteString(cvfFpVersion)
+	sb.WriteString(";r=" + cvfFpHex(cvfFpRules()))
+
+	var data []cvfFpFile
+	for _, f := range cvfFpWalk("data", &nfiles, &nbytes) {
+		if f.rel != "cvf_online.ini" {
+			data = append(data, f)
+		}
+	}
+	sb.WriteString(";d=" + cvfFpHex(cvfFpCombine(data, "")))
+
+	// characters: every directory that holds a .def file
+	chars := cvfFpWalk("chars", &nfiles, &nbytes)
+	dirs := map[string]bool{}
+	for _, f := range chars {
+		if strings.HasSuffix(f.rel, ".def") {
+			if i := strings.LastIndex(f.rel, "/"); i > 0 {
+				dirs[f.rel[:i]] = true
+			}
+		}
+	}
+	var dirList []string
+	for d := range dirs {
+		dirList = append(dirList, d)
+	}
+	sort.Strings(dirList)
+	for _, d := range dirList {
+		var in []cvfFpFile
+		for _, f := range chars {
+			if strings.HasPrefix(f.rel, d+"/") {
+				in = append(in, f)
+			}
+		}
+		sb.WriteString(";c/" + d + "=" + cvfFpHex(cvfFpCombine(in, d+"/")))
+	}
+	nc := len(dirList)
+
+	ns := 0
+	for _, f := range cvfFpWalk("stages", &nfiles, &nbytes) {
+		if strings.HasSuffix(f.rel, ".def") {
+			sb.WriteString(";s/" + f.rel + "=" + cvfFpHex(f.hash))
+			ns++
+		}
+	}
+	cvfFpCache = sb.String()
+	LogMessage("Content fingerprint: %s (%d characters, %d stages, %d files, %d KB, %d ms)",
+		cvfFingerprintSummary(cvfFpCache), nc, ns, nfiles, nbytes/1024, time.Since(t0).Milliseconds())
+	return cvfFpCache
+}
+
+// The entries of a fingerprint table, or nil if fp is not one.
+func cvfFpParse(fp string) map[string]string {
+	if !strings.HasPrefix(fp, cvfFpVersion+";") {
+		return nil
+	}
+	m := map[string]string{}
+	for _, e := range strings.Split(fp[len(cvfFpVersion)+1:], ";") {
+		if i := strings.LastIndex(e, "="); i > 0 {
+			m[e[:i]] = e[i+1:]
+		}
+	}
+	return m
+}
+
+// Short form for the log: version, rules, data and entry counts.
+func cvfFingerprintSummary(fp string) string {
+	m := cvfFpParse(fp)
+	if m == nil {
+		if len(fp) > 40 {
+			return fp[:40] + "..."
+		}
+		return fp
+	}
+	nc, ns := 0, 0
+	for k := range m {
+		if strings.HasPrefix(k, "c/") {
+			nc++
+		} else if strings.HasPrefix(k, "s/") {
+			ns++
+		}
+	}
+	return fmt.Sprintf("%s r=%s d=%s chars=%d stages=%d", cvfFpVersion, m["r"], m["d"], nc, ns)
+}
+
+// Session start: rules and common data must match. Empty = unknown, allowed.
+func cvfValidateFingerprint(local, remote string) error {
+	if local == "" || remote == "" {
+		return nil
+	}
+	lm, rm := cvfFpParse(local), cvfFpParse(remote)
+	if lm == nil || rm == nil {
+		if local != remote {
+			return Error("Content/build mismatch between peers")
+		}
+		return nil
+	}
+	if lm["r"] != rm["r"] {
+		return Error("Game data mismatch:\nthe gameplay rules (data/cvf_online.ini)\ndiffer from the other player's.\nBoth players need the same CvF Online version.")
+	}
+	if lm["d"] != rm["d"] {
+		return Error("Game data mismatch:\nthe files in data/ (common states, fight.def,\nselect.def or system.def) differ from the other player's.\nBoth players need the same CvF Online version.")
+	}
+	return nil
+}
+
+// The fingerprint key of a loaded character or stage definition file.
+func cvfFpKey(def string, stage bool) string {
+	p := strings.ToLower(filepath.ToSlash(filepath.Clean(def)))
+	p = strings.TrimPrefix(p, "./")
+	if stage {
+		if strings.HasPrefix(p, "stages/") {
+			return "s/" + p[len("stages/"):]
+		}
+		return ""
+	}
+	if !strings.HasPrefix(p, "chars/") {
+		return ""
+	}
+	p = p[len("chars/"):]
+	if i := strings.LastIndex(p, "/"); i > 0 {
+		return "c/" + p[:i]
+	}
+	return ""
+}
+
+// Match start: the loaded characters and stage must be the same on both
+// sides. Entries one side does not know (zipped characters, files outside
+// chars/ and stages/, an older peer) are allowed.
+func (s *System) cvfCheckMatchContent(remote string) error {
+	rm := cvfFpParse(remote)
+	if rm == nil {
+		return nil
+	}
+	lm := cvfFpParse(cvfContentFingerprint())
+	if lm == nil {
+		return nil
+	}
+	check := func(def, name string, stage bool) error {
+		k := cvfFpKey(def, stage)
+		if k == "" {
+			return nil
+		}
+		lv, lok := lm[k]
+		rv, rok := rm[k]
+		if !lok || !rok || lv == rv {
+			return nil
+		}
+		what := fmt.Sprintf("character %s (%s)", name, def)
+		if stage {
+			what = "stage " + def
+		}
+		return Error(fmt.Sprintf("Game data mismatch:\n%s\ndiffers from the other player's copy.\nBoth players need the same version.", what))
+	}
+	for i := range s.chars {
+		if len(s.chars[i]) == 0 || s.chars[i][0] == nil {
+			continue
+		}
+		c := s.chars[i][0]
+		if err := check(c.gi().def, c.name, false); err != nil {
+			return err
+		}
+	}
+	if s.stage != nil {
+		if err := check(s.stage.def, "", true); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/src/cvf_gohead.go b/src/cvf_gohead.go
new file mode 100644
index 0000000..aa0a00d
--- /dev/null
+++ b/src/cvf_gohead.go
@@ -0,0 +1,48 @@
+//go:build cvfgohead
+
+package main
+
+import (
+	"fmt"
+	"os"
+	"sync"
+
+	"github.com/ikemen-engine/beep/v2"
+)
+
+// Go build of the headless runner (tests/netplay, reference statedumps):
+//
+//	go build -tags cvf,cvfgohead -o cvf_headless_go ./src
+//	cvf_headless_go <gamedir> [ikemen args...]
+//
+// The same entry point as the native engine's cvf_headless
+// (src/app/headless_main.c), run from an init function so that main()
+// (window, renderer, Lua) never starts.
+func init() {
+	speaker = &cvfNullSpeaker{} // no audio device: mixing state only, as the native headless build
+	if len(os.Args) < 2 {
+		fmt.Fprintf(os.Stderr, "usage: %s <gamedir> [ikemen args...]\n", os.Args[0])
+		os.Exit(2)
+	}
+	if err := os.Chdir(os.Args[1]); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(2)
+	}
+	w := cvfHeadlessMain(os.Args[2:])
+	fmt.Printf("winner: %d\n", w)
+	if w < 0 {
+		os.Exit(1)
+	}
+	os.Exit(0)
+}
+
+// AudioSink without a device (System.init, which opens the SDL one, does
+// not run headless).
+type cvfNullSpeaker struct{ mu sync.Mutex }
+
+func (s *cvfNullSpeaker) Init(sr beep.SampleRate, bufferSize int) error { return nil }
+func (s *cvfNullSpeaker) Play(st beep.Streamer)                         {}
+func (s *cvfNullSpeaker) Lock()                                         { s.mu.Lock() }
+func (s *cvfNullSpeaker) Unlock()                                       { s.mu.Unlock() }
+func (s *cvfNullSpeaker) Close()                                        {}
+func (s *cvfNullSpeaker) FillAudio()                                    {}
diff --git a/src/cvf_mobile.go b/src/cvf_mobile.go
new file mode 100644
index 0000000..a644746
--- /dev/null
+++ b/src/cvf_mobile.go
@@ -0,0 +1,87 @@
+//go:build cvf
+
+package main
+
+// Mobile glue of the native C engine. The iOS app calls these through the
+// C host API (engine/src/platform/ios/cvf_host.c), always on the engine
+// (main) thread: directly from UIKit touch callbacks during the event pump,
+// or from the per-frame mailbox drain for values coming from other threads.
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+	"unsafe"
+)
+
+// "OpenGL ES 3.x" selects the GLES renderer (iOS forces "OpenGL ES 3.0").
+func cvfSelectRendererGLES(cfgVal string) (Renderer, FontRenderer, bool) {
+	if strings.HasPrefix(cfgVal, "OpenGL ES") {
+		return &Renderer_GLES32{}, &FontRenderer_GLES32{}, true
+	}
+	return nil, nil, false
+}
+
+// The GLES entry points are bound by the platform layer (gles_bind.c);
+// gl.Init ignores this loader.
+func eglGetProcAddress(name string) unsafe.Pointer { return nil }
+
+// Entry of the iOS app (SDL_main): --assets DIR --screen WxH, as the Go
+// app's SDL_main export.
+func cvfIOSMain(args []string) {
+	for i := 0; i+1 < len(args); i++ {
+		switch args[i] {
+		case "--assets":
+			sys.baseDir = args[i+1]
+		case "--screen":
+			cvfParseScreen(args[i+1])
+		}
+	}
+	realMain()
+}
+
+// True while a fight is on screen, so touches stay game controls.
+func cvfHostInMatch() bool { return sys.middleOfMatch() && !sys.motif.me.active }
+
+// Hands a tap to the current screen; false if that screen ignores taps.
+func cvfHostTap(x, y float32) bool { return cvfStoreTap(x, y) }
+
+func cvfHostSetTouchMenus(on bool) { cvfTouchMenus = on }
+
+// Nearby peers reachable over the app's direct link (JSON list).
+func cvfHostPeers(json string) { cvfNearby.setP2P(json) }
+
+// The player's answer from the app's name box ("" if cancelled).
+func cvfHostNameEntered(name string) { cvfNameAskDone(name) }
+
+// Lobby round trip through net/http (NSURLSession on iOS), for a local test
+// lobby (lobby/main.go): GET /api/rooms, POST a room, GET again. Run by the
+// iOS app with CVF_HTTP_TEST=<base URL> (src/platform/ios/ios_main.c).
+func cvfHTTPSelfTest(base string) string {
+	c := &http.Client{Timeout: 15 * time.Second}
+	out := ""
+	get := func() {
+		resp, err := c.Get(base + "/api/rooms")
+		if err != nil {
+			out += "GET error: " + err.Error() + "\n"
+			return
+		}
+		b, _ := io.ReadAll(resp.Body)
+		resp.Body.Close()
+		out += fmt.Sprintf("GET /api/rooms -> %d %s\n", resp.StatusCode, strings.TrimSpace(string(b)))
+	}
+	get()
+	body := `{"name":"iOS Simulator","port":7500,"udp_port":7501,"version":"` + cvfOnline.buildTag + `"}`
+	resp, err := c.Post(base+"/api/rooms", "application/json", strings.NewReader(body))
+	if err != nil {
+		out += "POST error: " + err.Error() + "\n"
+	} else {
+		b, _ := io.ReadAll(resp.Body)
+		resp.Body.Close()
+		out += fmt.Sprintf("POST /api/rooms -> %d %s\n", resp.StatusCode, strings.TrimSpace(string(b)))
+	}
+	get()
+	return out
+}
diff --git a/src/cvf_nearby.go b/src/cvf_nearby.go
new file mode 100644
index 0000000..6323a30
--- /dev/null
+++ b/src/cvf_nearby.go
@@ -0,0 +1,605 @@
+package main
+
+// Castlevania Fighter "Nearby" play: two devices on the same local network play without
+// the Internet, the lobby or typing addresses. The usual case is one device's hotspot
+// (iPhone Personal Hotspot, Android hotspot, Steam Deck / Windows hotspot) with the other
+// device joined to it, but any shared Wi-Fi works too.
+//
+// Discovery is a tiny UDP probe/reply on cvfNearbyPort:
+//   - the host answers probes with its name, netplay port and build tag;
+//   - the joiner sends a probe to every address of each local Wi-Fi/Ethernet subnet
+//     (plus the broadcast address) and lists whoever answers.
+// Probing each address directly avoids broadcast/multicast, which iOS only allows for
+// apps with a special Apple entitlement. A hotspot subnet is small (an iPhone's is 14
+// addresses), so a sweep is cheap.
+//
+// iPhones/iPads also advertise and browse over Apple's peer-to-peer Wi-Fi (cvf_p2p_ios.go),
+// so two Apple devices find each other with no network at all. When a host is reachable
+// both ways, the shared network is used.
+//
+// The match itself is ordinary Ikemen netplay (TCP handshake + rollback over UDP).
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"net"
+	"runtime"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	lua "github.com/yuin/gopher-lua"
+)
+
+const (
+	cvfNearbyPort    = 7520
+	cvfNearbyProbe   = "CVFNEARBY?1"
+	cvfNearbyMaxScan = 1022 // addresses per interface; bigger networks scan the /24 around us
+	cvfNearbyExpire  = 7 * time.Second
+
+	// Loopback ports the app's relay uses on the joining device for a direct link.
+	cvfP2PJoinTCP = 7510
+	cvfP2PJoinUDP = 7502
+)
+
+type cvfNearbyHost struct {
+	ID      string
+	Via     string // "lan" or "p2p"
+	Name    string
+	IP      string
+	Port    int
+	Version string
+	seen    time.Time
+}
+
+type cvfNearbyReply struct {
+	T       string `json:"t"`
+	Name    string `json:"name"`
+	Port    int    `json:"port"`
+	Version string `json:"ver"`
+	ID      string `json:"id"`
+}
+
+type cvfNearbyState struct {
+	mu sync.Mutex
+
+	// hosting
+	hostConn   net.PacketConn
+	hostErr    string
+	hostPort   int
+	hostProbes int
+	hostID     string
+
+	// joining
+	scanStop  chan struct{}
+	hosts     map[string]*cvfNearbyHost
+	scanErr   string
+	lastSweep time.Time
+	extra     []string // extra probe targets (tests)
+	p2p       []cvfNearbyHost
+}
+
+func cvfNearbyNewID() string {
+	b := make([]byte, 5)
+	rand.Read(b)
+	return hex.EncodeToString(b)
+}
+
+var cvfNearby = &cvfNearbyState{}
+
+// Interfaces worth scanning: up, not loopback, not cellular/VPN/peer-to-peer links.
+func cvfNearbyIfaceOK(ifc net.Interface) bool {
+	if ifc.Flags&net.FlagUp == 0 || ifc.Flags&net.FlagLoopback != 0 {
+		return false
+	}
+	n := strings.ToLower(ifc.Name)
+	for _, p := range []string{"pdp_ip", "rmnet", "ccmni", "wwan", "utun", "ipsec", "tun", "tap",
+		"ppp", "awdl", "llw", "anpi", "gif", "stf", "tailscale", "zt", "wg", "docker", "veth", "virbr"} {
+		if strings.HasPrefix(n, p) {
+			return false
+		}
+	}
+	return true
+}
+
+type cvfNearbyNet struct {
+	self  net.IP
+	ipnet *net.IPNet
+}
+
+func cvfNearbyNets() []cvfNearbyNet {
+	var out []cvfNearbyNet
+	ifaces, _ := net.Interfaces()
+	for _, ifc := range ifaces {
+		if !cvfNearbyIfaceOK(ifc) {
+			continue
+		}
+		addrs, _ := ifc.Addrs()
+		for _, a := range addrs {
+			ipn, ok := a.(*net.IPNet)
+			if !ok {
+				continue
+			}
+			ip4 := ipn.IP.To4()
+			if ip4 == nil || ip4.IsLinkLocalUnicast() || ip4.IsLoopback() {
+				continue
+			}
+			out = append(out, cvfNearbyNet{ip4, &net.IPNet{IP: ip4.Mask(ipn.Mask), Mask: ipn.Mask}})
+		}
+	}
+	return out
+}
+
+func cvfNearbyIsSelf(ip net.IP) bool {
+	for _, n := range cvfNearbyNets() {
+		if n.self.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+// Every address to probe on one subnet: all hosts (or the /24 around us on big
+// networks), then the broadcast address. Our own address is skipped.
+func cvfNearbyTargets(n cvfNearbyNet) []net.IP {
+	ones, bits := n.ipnet.Mask.Size()
+	if bits != 32 || ones >= 31 {
+		return nil
+	}
+	base := n.ipnet.IP.To4()
+	size := uint32(1) << uint(32-ones)
+	if size-2 > cvfNearbyMaxScan {
+		base = n.self.Mask(net.CIDRMask(24, 32)).To4()
+		size = 256
+	}
+	start := uint32(base[0])<<24 | uint32(base[1])<<16 | uint32(base[2])<<8 | uint32(base[3])
+	out := make([]net.IP, 0, size)
+	for i := uint32(1); i < size; i++ { // i == size-1 is the broadcast address
+		v := start + i
+		ip := net.IPv4(byte(v>>24), byte(v>>16), byte(v>>8), byte(v)).To4()
+		if !ip.Equal(n.self) {
+			out = append(out, ip)
+		}
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// Host side
+
+func (s *cvfNearbyState) hostBegin(port, udpPort int) {
+	s.hostEnd()
+	id := cvfNearbyNewID()
+	name, tag := cvfNearbyIdentity()
+	cvfP2PAdvertise(id, name, tag, port, udpPort)
+	conn, err := net.ListenPacket("udp4", fmt.Sprintf(":%d", cvfNearbyPort))
+	s.mu.Lock()
+	s.hostPort, s.hostProbes, s.hostID = port, 0, id
+	if err != nil {
+		s.hostErr = "Nearby discovery unavailable (" + err.Error() + ")"
+		s.mu.Unlock()
+		return
+	}
+	s.hostErr = ""
+	s.hostConn = conn
+	s.mu.Unlock()
+
+	go func() {
+		buf := make([]byte, 256)
+		for {
+			n, from, err := conn.ReadFrom(buf)
+			if err != nil {
+				return // closed by hostEnd
+			}
+			if string(buf[:n]) != cvfNearbyProbe {
+				continue
+			}
+			name, tag := cvfNearbyIdentity()
+			s.mu.Lock()
+			p, id := s.hostPort, s.hostID
+			s.hostProbes++
+			s.mu.Unlock()
+			b, _ := json.Marshal(cvfNearbyReply{T: "cvfnearby", Name: name, Port: p, Version: tag, ID: id})
+			conn.WriteTo(b, from)
+		}
+	}()
+}
+
+func cvfNearbyIdentity() (name, tag string) {
+	cvfOnline.readConfig()
+	cvfOnline.mu.Lock()
+	name, tag = cvfOnline.playerName, cvfOnline.buildTag
+	cvfOnline.mu.Unlock()
+	if name == "" {
+		name = "Player"
+	}
+	return
+}
+
+// Stops looking for opponents. A direct link that is already connected keeps running.
+func (s *cvfNearbyState) hostEnd() {
+	cvfP2PAdvertiseStop()
+	s.mu.Lock()
+	c := s.hostConn
+	s.hostConn = nil
+	s.mu.Unlock()
+	if c != nil {
+		c.Close()
+	}
+}
+
+func (s *cvfNearbyState) hostStatus() string {
+	s.mu.Lock()
+	port, herr := s.hostPort, s.hostErr
+	s.mu.Unlock()
+	var b strings.Builder
+	b.WriteString("NEARBY  -  waiting for an opponent...\n\n")
+	var ips []string
+	for _, n := range cvfNearbyNets() {
+		ips = append(ips, n.self.String())
+	}
+	if len(ips) == 0 && cvfP2PAvailable {
+		b.WriteString("Nearby iPhones and iPads can join you directly.\n\n")
+	} else if len(ips) == 0 {
+		b.WriteString("Not connected to any network yet.\n\n")
+	} else {
+		fmt.Fprintf(&b, "Your address here: %s   Port: %d\n\n", strings.Join(ips, ", "), port)
+	}
+	if herr != "" {
+		b.WriteString(herr + "\nThe other player can still use Join Game with the address above.\n\n")
+	} else {
+		b.WriteString("The other player picks Online > Join Nearby.\n\n")
+	}
+	b.WriteString(cvfNearbyNoWifiHint())
+	b.WriteString("\n" + cvfStopHostingHint())
+	return b.String()
+}
+
+func cvfNearbyNoWifiHint() string {
+	if cvfP2PAvailable {
+		return "iPhone/iPad to iPhone/iPad works anywhere (keep Wi-Fi on).\n" +
+			"Other devices: share Wi-Fi or a hotspot. No Internet is used.\n"
+	}
+	return "No Wi-Fi around? Turn on the hotspot on one device\n" +
+		"(iPhone: Personal Hotspot, Android/Steam Deck: Hotspot)\n" +
+		"and connect the other device to it. No Internet is used.\n"
+}
+
+// ---------------------------------------------------------------------------
+// Join side
+
+func (s *cvfNearbyState) scanBegin() {
+	s.mu.Lock()
+	if s.scanStop != nil {
+		s.mu.Unlock()
+		return
+	}
+	stop := make(chan struct{})
+	s.scanStop = stop
+	if s.hosts == nil {
+		s.hosts = map[string]*cvfNearbyHost{}
+	}
+	s.scanErr = ""
+	s.mu.Unlock()
+	cvfP2PBrowse(true)
+
+	conn, err := net.ListenPacket("udp4", ":0")
+	if err != nil {
+		s.mu.Lock()
+		s.scanErr = "Cannot search (" + err.Error() + ")"
+		s.scanStop = nil
+		s.mu.Unlock()
+		return
+	}
+
+	// Replies
+	go func() {
+		buf := make([]byte, 512)
+		for {
+			n, from, err := conn.ReadFrom(buf)
+			if err != nil {
+				return
+			}
+			var r cvfNearbyReply
+			if json.Unmarshal(buf[:n], &r) != nil || r.T != "cvfnearby" || r.Port <= 0 || r.Port > 65535 {
+				continue
+			}
+			ua, ok := from.(*net.UDPAddr)
+			if !ok || ua.IP.To4() == nil {
+				continue
+			}
+			if cvfNearbyIsSelf(ua.IP) {
+				continue // our own broadcast echo
+			}
+			ip := ua.IP.To4().String()
+			s.mu.Lock()
+			if s.hosts == nil { // search screen already closed
+				s.mu.Unlock()
+				continue
+			}
+			s.hosts[ip+fmt.Sprint(":", r.Port)] = &cvfNearbyHost{
+				ID: r.ID, Via: "lan", Name: cvfCleanName(r.Name), IP: ip, Port: r.Port, Version: r.Version, seen: time.Now(),
+			}
+			s.mu.Unlock()
+		}
+	}()
+
+	// Probes: a full sweep straight away, then every 2.5 seconds.
+	go func() {
+		defer conn.Close()
+		probe := []byte(cvfNearbyProbe)
+		t := time.NewTicker(2500 * time.Millisecond)
+		defer t.Stop()
+		for {
+			nets := cvfNearbyNets()
+			sent := 0
+			for _, n := range nets {
+				for i, ip := range cvfNearbyTargets(n) {
+					select {
+					case <-stop:
+						return
+					default:
+					}
+					if _, err := conn.WriteTo(probe, &net.UDPAddr{IP: ip, Port: cvfNearbyPort}); err == nil {
+						sent++
+					}
+					if i%64 == 63 {
+						time.Sleep(2 * time.Millisecond) // don't overrun small send buffers
+					}
+				}
+			}
+			s.mu.Lock()
+			for _, h := range s.extra {
+				if a, err := net.ResolveUDPAddr("udp4", h); err == nil {
+					conn.WriteTo(probe, a)
+				}
+			}
+			s.lastSweep = time.Now()
+			switch {
+			case len(nets) == 0 && cvfP2PAvailable:
+				s.scanErr = ""
+			case len(nets) == 0:
+				s.scanErr = "Not connected to any network."
+			case sent == 0:
+				s.scanErr = "Cannot reach the local network. On iPhone/iPad allow\nLocal Network for CvF Online in Settings > Privacy & Security."
+			default:
+				s.scanErr = ""
+			}
+			s.mu.Unlock()
+			select {
+			case <-stop:
+				return
+			case <-t.C:
+			}
+		}
+	}()
+}
+
+func (s *cvfNearbyState) scanEnd() {
+	cvfP2PBrowse(false)
+	s.mu.Lock()
+	if s.scanStop != nil {
+		close(s.scanStop)
+		s.scanStop = nil
+	}
+	s.hosts = nil
+	s.p2p = nil
+	s.mu.Unlock()
+}
+
+// Direct-link hosts reported by the app (JSON list).
+func (s *cvfNearbyState) setP2P(js string) {
+	var in []struct {
+		ID   string `json:"id"`
+		Name string `json:"name"`
+		Ver  string `json:"ver"`
+		RP   int    `json:"rp"`
+	}
+	if json.Unmarshal([]byte(js), &in) != nil {
+		return
+	}
+	var out []cvfNearbyHost
+	for _, h := range in {
+		if h.ID == "" {
+			continue
+		}
+		out = append(out, cvfNearbyHost{ID: h.ID, Via: "p2p", Name: cvfCleanName(h.Name), Port: h.RP, Version: h.Ver})
+	}
+	s.mu.Lock()
+	if s.scanStop != nil {
+		s.p2p = out
+	}
+	s.mu.Unlock()
+}
+
+// Hosts heard from recently, sorted by name, and a status line.
+func (s *cvfNearbyState) list() ([]cvfNearbyHost, string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	var out []cvfNearbyHost
+	for k, h := range s.hosts {
+		if time.Since(h.seen) > cvfNearbyExpire {
+			delete(s.hosts, k)
+			continue
+		}
+		out = append(out, *h)
+	}
+	// A host reachable over the shared network is listed once, using that network.
+	for _, h := range s.p2p {
+		dup := false
+		for _, o := range out {
+			if o.ID != "" && o.ID == h.ID {
+				dup = true
+				break
+			}
+		}
+		if !dup {
+			out = append(out, h)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].Name != out[j].Name {
+			return out[i].Name < out[j].Name
+		}
+		return out[i].IP < out[j].IP
+	})
+	return out, s.scanErr
+}
+
+// ---------------------------------------------------------------------------
+// Touch devices: gesture hints and the player name
+
+// True on phones/tablets while menus are driven by touch (no controller connected).
+func cvfTouchUI() bool {
+	return (runtime.GOOS == "ios" || runtime.GOOS == "android") && cvfTouchMenus
+}
+
+func cvfStopHostingHint() string {
+	if cvfTouchUI() {
+		return "Double-tap to stop hosting."
+	}
+	return "Press Esc to stop hosting."
+}
+
+// A name for players who never typed one ("Player 4821").
+func cvfDefaultName() string {
+	n, _ := rand.Int(rand.Reader, big.NewInt(9000))
+	return fmt.Sprintf("Player %d", 1000+n.Int64())
+}
+
+var cvfNameAsk struct {
+	sync.Mutex
+	waiting bool
+	done    bool
+	result  string
+}
+
+func cvfNameAskBegin() bool {
+	cvfNameAsk.Lock()
+	cvfNameAsk.waiting, cvfNameAsk.done, cvfNameAsk.result = true, false, ""
+	cvfNameAsk.Unlock()
+	if !cvfNativeAskName(cvfDefaultName()) {
+		cvfNameAsk.Lock()
+		cvfNameAsk.waiting = false
+		cvfNameAsk.Unlock()
+		return false
+	}
+	return true
+}
+
+// Called (from the app) with what the player typed; "" if they cancelled.
+func cvfNameAskDone(name string) {
+	cvfNameAsk.Lock()
+	if cvfNameAsk.waiting {
+		cvfNameAsk.waiting, cvfNameAsk.done, cvfNameAsk.result = false, true, name
+	}
+	cvfNameAsk.Unlock()
+}
+
+// ---------------------------------------------------------------------------
+// Lua
+
+func cvfNearbyScriptInit(l *lua.LState) {
+	luaRegister(l, "cvfNearbyHostBegin", func(l *lua.LState) int {
+		cvfNearby.hostBegin(int(numArg(l, 1)), sys.cfg.Netplay.Rollback.Port)
+		return 0
+	})
+	luaRegister(l, "cvfNearbyHostEnd", func(l *lua.LState) int {
+		cvfNearby.hostEnd()
+		return 0
+	})
+	luaRegister(l, "cvfNearbyHostStatus", func(l *lua.LState) int {
+		l.Push(lua.LString(cvfNearby.hostStatus()))
+		return 1
+	})
+	luaRegister(l, "cvfNearbyScanBegin", func(l *lua.LState) int {
+		cvfNearby.scanBegin()
+		return 0
+	})
+	luaRegister(l, "cvfNearbyScanEnd", func(l *lua.LState) int {
+		cvfNearby.scanEnd()
+		return 0
+	})
+	// Returns a table of {name, ip, port, compatible} and a status string.
+	luaRegister(l, "cvfNearbyHosts", func(l *lua.LState) int {
+		hosts, status := cvfNearby.list()
+		cvfOnline.readConfig()
+		cvfOnline.mu.Lock()
+		tag := cvfOnline.buildTag
+		cvfOnline.mu.Unlock()
+		t := l.NewTable()
+		for _, h := range hosts {
+			rt := l.NewTable()
+			rt.RawSetString("name", lua.LString(h.Name))
+			rt.RawSetString("ip", lua.LString(h.IP))
+			rt.RawSetString("id", lua.LString(h.ID))
+			rt.RawSetString("direct", lua.LBool(h.Via == "p2p"))
+			rt.RawSetString("port", lua.LNumber(h.Port))
+			rt.RawSetString("compatible", lua.LBool(h.Version == tag))
+			t.Append(rt)
+		}
+		l.Push(t)
+		l.Push(lua.LString(status))
+		return 2
+	})
+	// Opens the app's relay to a direct-link host. Returns the loopback TCP port to
+	// connect to and the rollback UDP port to use, or nothing if the host is gone.
+	luaRegister(l, "cvfNearbyDirectJoin", func(l *lua.LState) int {
+		if !cvfP2PJoin(strArg(l, 1), cvfP2PJoinTCP, cvfP2PJoinUDP) {
+			return 0
+		}
+		l.Push(lua.LNumber(cvfP2PJoinTCP))
+		l.Push(lua.LNumber(cvfP2PJoinUDP))
+		return 2
+	})
+	luaRegister(l, "cvfNearbyDirectClose", func(l *lua.LState) int {
+		cvfP2PClose()
+		return 0
+	})
+	luaRegister(l, "cvfIsMobile", func(l *lua.LState) int {
+		l.Push(lua.LBool(runtime.GOOS == "ios" || runtime.GOOS == "android"))
+		return 1
+	})
+	luaRegister(l, "cvfTouchUI", func(l *lua.LState) int {
+		l.Push(lua.LBool(cvfTouchUI()))
+		return 1
+	})
+	luaRegister(l, "cvfDefaultName", func(l *lua.LState) int {
+		l.Push(lua.LString(cvfDefaultName()))
+		return 1
+	})
+	// Shows the device's own name box (iPhone/iPad). False if there is none.
+	luaRegister(l, "cvfAskNameBegin", func(l *lua.LState) int {
+		l.Push(lua.LBool(cvfNameAskBegin()))
+		return 1
+	})
+	// Nothing while the box is open, then the typed name ("" if cancelled).
+	luaRegister(l, "cvfAskNamePoll", func(l *lua.LState) int {
+		cvfNameAsk.Lock()
+		done, r := cvfNameAsk.done, cvfNameAsk.result
+		cvfNameAsk.Unlock()
+		if !done {
+			return 0
+		}
+		l.Push(lua.LString(r))
+		return 1
+	})
+	luaRegister(l, "cvfNearbyHint", func(l *lua.LState) int {
+		l.Push(lua.LString(strings.TrimRight(cvfNearbyNoWifiHint(), "\n")))
+		return 1
+	})
+	luaRegister(l, "cvfGetRollbackPort", func(l *lua.LState) int {
+		l.Push(lua.LNumber(sys.cfg.Netplay.Rollback.Port))
+		return 1
+	})
+	luaRegister(l, "cvfSetRollbackPort", func(l *lua.LState) int {
+		if p := int(numArg(l, 1)); p > 0 && p < 65536 {
+			sys.cfg.Netplay.Rollback.Port = p
+		}
+		return 0
+	})
+}
