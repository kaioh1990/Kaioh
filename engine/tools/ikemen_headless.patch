+			b.buf = b.buf[:0]
+			return n, err
+		}
+		if _, err := b.f.Seek(b.pos, io.SeekStart); err != nil {
+			return 0, err
+		}
+		n, err := b.f.Read(b.buf[:cap(b.buf)])
+		b.buf = b.buf[:n]
+		b.bufStart = b.pos
+		if n == 0 {
+			if err == nil {
+				err = io.EOF
+			}
+			return 0, err
+		}
+	}
+	n := copy(p, b.buf[b.pos-b.bufStart:])
+	b.pos += int64(n)
+	return n, nil
