diff --git a/src/cvf_sound_lazy.go b/src/cvf_sound_lazy.go
new file mode 100644
index 0000000..897ab9c
--- /dev/null
+++ b/src/cvf_sound_lazy.go
@@ -0,0 +1,147 @@
+package main
+
+// CvF Online: on-demand loading of .snd sounds.
+//
+// Ikemen normally reads every sound of every .snd file into memory when a
+// character or the fight screen loads. Castlevania Fighter's shared sound
+// bank (data/Xsound.snd) is 687 MB of uncompressed WAVs, which made one match
+// use ~700 MB of RAM - too much for the PS Vita and wasteful everywhere else.
+// Now only each sound's header is read at load time; the samples are read the
+// first time the sound plays and kept in a size-capped LRU cache.
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"strconv"
+	"sync"
+
+	"github.com/ikemen-engine/beep/v2/wav"
+)
+
+type lazySound struct {
+	filename string
+	offset   int64
+	size     uint32
+	state    int8 // 0 = not loaded, 1 = loaded, -1 = corrupted
+	lastUse  uint64
+}
+
+var cvfLazy struct {
+	sync.Mutex
+	loaded  []*Sound
+	bytes   int64
+	tick    uint64
+	limit   int64
+	enabled int8 // 0 unknown, 1 on, -1 off
+}
+
+// CVF_LAZY_SOUNDS=0 restores the original behaviour; CVF_SOUND_CACHE_MB sets the cache size.
+func cvfLazySoundsEnabled() bool {
+	if cvfLazy.enabled == 0 {
+		cvfLazy.enabled = 1
+		if os.Getenv("CVF_LAZY_SOUNDS") == "0" {
+			cvfLazy.enabled = -1
+		}
+		cvfLazy.limit = 96 << 20
+		if isVita {
+			cvfLazy.limit = 24 << 20
+		}
+		if mb, err := strconv.Atoi(os.Getenv("CVF_SOUND_CACHE_MB")); err == nil && mb > 0 {
+			cvfLazy.limit = int64(mb) << 20
+		}
+	}
+	return cvfLazy.enabled == 1
+}
+
+// newLazySound reads only the WAV header at f's current position.
+func newLazySound(f io.ReadSeeker, filename string, offset int64, size uint32) (*Sound, error) {
+	hdrLen := uint32(4096)
+	if size < hdrLen {
+		hdrLen = size
+	}
+	hdr := make([]byte, hdrLen)
+	if _, err := io.ReadFull(f, hdr); err != nil {
+		return nil, err
+	}
+	snd := &Sound{lazy: &lazySound{filename: filename, offset: offset, size: size}}
+	if st, wavfmt, err := wav.Decode(bytes.NewReader(hdr)); err == nil {
+		snd.format = wavfmt
+		snd.length = st.Len()
+	} else {
+		// Unusual header layout: load it fully now, like before.
+		if !snd.ensureLoaded() {
+			return nil, nil
+		}
+	}
+	return snd, nil
+}
+
+// ensureLoaded makes sure the samples are in memory. Returns false if the
+// sound can't be played.
+func (s *Sound) ensureLoaded() bool {
+	l := s.lazy
+	if l == nil {
+		return s.wavData != nil
+	}
+	cvfLazy.Lock()
+	defer cvfLazy.Unlock()
+	switch l.state {
+	case 1:
+		return true
+	case -1:
+		return false
+	}
+	f, err := OpenFile(l.filename)
+	if err != nil {
+		l.state = -1
+		return false
+	}
+	defer f.Close()
+	if _, err := f.Seek(l.offset, io.SeekStart); err != nil {
+		l.state = -1
+		return false
+	}
+	full, err := readSound(f, l.size)
+	if err != nil || full == nil {
+		l.state = -1
+		return false
+	}
+	s.wavData, s.format, s.length = full.wavData, full.format, full.length
+	l.state = 1
+	cvfLazy.tick++
+	l.lastUse = cvfLazy.tick
+	cvfLazy.loaded = append(cvfLazy.loaded, s)
+	cvfLazy.bytes += int64(len(s.wavData))
+	cvfEvictSounds()
+	return true
+}
+
+func (s *Sound) lazyTouch() {
+	if s.lazy == nil {
+		return
+	}
+	cvfLazy.Lock()
+	cvfLazy.tick++
+	s.lazy.lastUse = cvfLazy.tick
+	cvfLazy.Unlock()
+}
+
+// cvfEvictSounds drops the samples of the least recently used sounds until the
+// cache fits. A channel that is still playing an evicted sound keeps its own
+// reference to the data, so nothing is cut off. Caller holds the lock.
+func cvfEvictSounds() {
+	for cvfLazy.bytes > cvfLazy.limit && len(cvfLazy.loaded) > 1 {
+		oldest := 0
+		for i, s := range cvfLazy.loaded {
+			if s.lazy.lastUse < cvfLazy.loaded[oldest].lazy.lastUse {
+				oldest = i
+			}
+		}
+		s := cvfLazy.loaded[oldest]
+		cvfLazy.bytes -= int64(len(s.wavData))
+		s.wavData = nil
+		s.lazy.state = 0
+		cvfLazy.loaded = append(cvfLazy.loaded[:oldest], cvfLazy.loaded[oldest+1:]...)
+	}
+}
diff --git a/src/cvfcook.go b/src/cvfcook.go
new file mode 100644
index 0000000..e9bae25
--- /dev/null
+++ b/src/cvfcook.go
@@ -0,0 +1,314 @@
+package main
+
+// CvF native engine content cooker (ux0:data/CvF/vita_cook.txt).
+//
+// Right after a character is compiled (before any Vita-only bytecode
+// transformation), the compiled states, functions, string pool, constants
+// and [Data]/[Size]/[Velocity]/[Movement] values are written to
+// cooked/<def path>.cvfc. The native C engine loads these files, so it runs
+// exactly the bytecode Ikemen's own compiler produced.
+//
+// Format (little endian): see engine/docs/COOKED_FORMAT.md.
+
+import (
+	"encoding/binary"
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"sort"
+	"strings"
+)
+
+var cookOn = -1
+
+func cookEnabled() bool {
+	if cookOn < 0 {
+		cookOn = 0
+		if FileExist("vita_cook.txt") != "" {
+			cookOn = 1
+		}
+	}
+	return cookOn == 1
+}
+
+type cookW struct{ b []byte }
+
+func (w *cookW) u8(v uint8)   { w.b = append(w.b, v) }
+func (w *cookW) u32(v uint32) { w.b = binary.LittleEndian.AppendUint32(w.b, v) }
+func (w *cookW) i32(v int32)  { w.u32(uint32(v)) }
+func (w *cookW) f64(v float64) {
+	w.b = binary.LittleEndian.AppendUint64(w.b, math.Float64bits(v))
+}
+func (w *cookW) f32(v float32) { w.u32(math.Float32bits(v)) }
+func (w *cookW) str(s string) {
+	w.u32(uint32(len(s)))
+	w.b = append(w.b, s...)
+}
+func (w *cookW) exp(e BytecodeExp) {
+	w.u32(uint32(len(e)))
+	for _, op := range e {
+		w.b = append(w.b, byte(op))
+	}
+}
+func (w *cookW) bool(v bool) {
+	if v {
+		w.u8(1)
+	} else {
+		w.u8(0)
+	}
+}
+
+const (
+	cookCtlBlock    = 0
+	cookCtlSCB      = 1
+	cookCtlCallFunc = 2
+	cookCtlExpr     = 3
+	cookCtlVarAsgn  = 4
+	cookCtlBreak    = 5
+	cookCtlContinue = 6
+	cookCtlNull     = 7
+	cookCtlUnknown  = 255
+)
+
+var scParamType = reflect.TypeOf(scParam{})
+
+func (w *cookW) scb(params []scParam) {
+	w.u32(uint32(len(params)))
+	for _, p := range params {
+		w.u8(p.id)
+		w.u32(uint32(len(p.exp)))
+		for _, e := range p.exp {
+			w.exp(e)
+		}
+	}
+}
+
+func (w *cookW) ctrl(sc StateController) {
+	switch v := sc.(type) {
+	case *StateBlock:
+		w.u8(cookCtlBlock)
+		w.block(v)
+		return
+	case CallFunction:
+		w.u8(cookCtlCallFunc)
+		w.str(v.name)
+		w.exp(v.arg)
+		w.u32(uint32(len(v.ret)))
+		w.b = append(w.b, v.ret...)
+		w.i32(v.numArgs)
+		return
+	case StateExpr:
+		w.u8(cookCtlExpr)
+		w.exp(BytecodeExp(v))
+		return
+	case varAssign:
+		w.u8(cookCtlVarAsgn)
+		w.u8(v.vari)
+		w.exp(v.be)
+		return
+	case LoopBreak:
+		w.u8(cookCtlBreak)
+		return
+	case LoopContinue:
+		w.u8(cookCtlContinue)
+		return
+	case NullStateController:
+		w.u8(cookCtlNull)
+		return
+	}
+	rv := reflect.ValueOf(sc)
+	if rv.Kind() == reflect.Slice && rv.Type().Elem() == scParamType {
+		w.u8(cookCtlSCB)
+		name := strings.TrimPrefix(fmt.Sprintf("%T", sc), "main.")
+		w.str(name)
+		params := make([]scParam, rv.Len())
+		for i := range params {
+			params[i] = rv.Index(i).Interface().(scParam)
+		}
+		w.scb(params)
+		return
+	}
+	w.u8(cookCtlUnknown)
+	w.str(fmt.Sprintf("%T", sc))
+}
+
+func (w *cookW) block(b *StateBlock) {
+	w.i32(b.persistent)
+	w.i32(b.persistentIndex)
+	w.bool(b.ignorehitpause)
+	w.bool(b.ctrlsIgnorehitpause)
+	w.exp(b.trigger)
+	w.bool(b.loopBlock)
+	w.bool(b.nestedInLoop)
+	w.bool(b.forLoop)
+	w.bool(b.forAssign)
+	w.u8(b.forCtrlVar.vari)
+	w.exp(b.forCtrlVar.be)
+	for i := 0; i < 3; i++ {
+		w.exp(b.forExpression[i])
+	}
+	w.i32(b.forBegin)
+	w.i32(b.forEnd)
+	w.i32(b.forIncrement)
+	w.u32(uint32(len(b.ctrls)))
+	for _, sc := range b.ctrls {
+		w.ctrl(sc)
+	}
+	w.bool(b.elseBlock != nil)
+	if b.elseBlock != nil {
+		w.block(b.elseBlock)
+	}
+}
+
+// structFields writes every numeric field of a struct (recursively, arrays
+// flattened) as name=value pairs, so the C side can map them by name.
+func (w *cookW) structFields(prefix string, v reflect.Value, out *[]string, vals *[]float64) {
+	t := v.Type()
+	for i := 0; i < v.NumField(); i++ {
+		f := v.Field(i)
+		name := prefix + t.Field(i).Name
+		switch f.Kind() {
+		case reflect.Struct:
+			w.structFields(name+".", f, out, vals)
+		case reflect.Array:
+			for k := 0; k < f.Len(); k++ {
+				e := f.Index(k)
+				switch e.Kind() {
+				case reflect.Float32, reflect.Float64:
+					*out = append(*out, fmt.Sprintf("%s[%d]", name, k))
+					*vals = append(*vals, e.Float())
+				case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+					*out = append(*out, fmt.Sprintf("%s[%d]", name, k))
+					*vals = append(*vals, float64(e.Int()))
+				}
+			}
+		case reflect.Float32, reflect.Float64:
+			*out = append(*out, name)
+			*vals = append(*vals, f.Float())
+		case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+			*out = append(*out, name)
+			*vals = append(*vals, float64(f.Int()))
+		case reflect.Uint8, reflect.Uint16, reflect.Uint32:
+			*out = append(*out, name)
+			*vals = append(*vals, float64(f.Uint()))
+		case reflect.Bool:
+			*out = append(*out, name)
+			b := 0.0
+			if f.Bool() {
+				b = 1
+			}
+			*vals = append(*vals, b)
+		}
+	}
+}
+
+func (w *cookW) numericBlock(tag string, v any) {
+	var names []string
+	var vals []float64
+	w.structFields("", reflect.ValueOf(v), &names, &vals)
+	w.str(tag)
+	w.u32(uint32(len(names)))
+	for i := range names {
+		w.str(names[i])
+		w.f64(vals[i])
+	}
+}
+
+func cookChar(cdef string, pn int, gi *CharGlobalInfo) {
+	if !cookEnabled() {
+		return
+	}
+	w := &cookW{}
+	w.b = append(w.b, "CVFC"...)
+	w.u32(1) // version
+	w.str(cdef)
+	w.str(gi.name)
+	w.str(gi.displayname)
+	w.str(gi.author)
+	w.u32(uint32(gi.ikemenver[0]) | uint32(gi.ikemenver[1])<<16)
+	w.u32(uint32(gi.ikemenver[2]))
+	w.u32(uint32(gi.mugenver[0]) | uint32(gi.mugenver[1])<<16)
+	w.i32(gi.localcoord[0])
+	w.i32(gi.localcoord[1])
+	w.f32(gi.rawlocalscl)
+	w.i32(gi.attackBase)
+	w.i32(gi.defenceBase)
+	// String pool
+	pool := sys.stringPool[pn].List
+	w.u32(uint32(len(pool)))
+	for _, s := range pool {
+		w.str(s)
+	}
+	// Constants
+	ckeys := make([]string, 0, len(gi.constants))
+	for k := range gi.constants {
+		ckeys = append(ckeys, k)
+	}
+	sort.Strings(ckeys)
+	w.u32(uint32(len(ckeys)))
+	for _, k := range ckeys {
+		tv := gi.constants[k]
+		w.str(k)
+		w.u8(uint8(tv.Type))
+		w.f64(tv.Num)
+		w.str(tv.Str)
+	}
+	// Character data sections
+	w.numericBlock("data", gi.data)
+	w.numericBlock("velocity", gi.velocity)
+	w.numericBlock("movement", gi.movement)
+	// Functions
+	fkeys := make([]string, 0, len(gi.callFuncs))
+	for k := range gi.callFuncs {
+		fkeys = append(fkeys, k)
+	}
+	sort.Strings(fkeys)
+	w.u32(uint32(len(fkeys)))
+	for _, k := range fkeys {
+		f := gi.callFuncs[k]
+		w.str(k)
+		w.i32(f.numVars)
+		w.i32(f.numArgs)
+		w.i32(f.numRets)
+		w.u32(uint32(len(f.ctrls)))
+		for _, sc := range f.ctrls {
+			w.ctrl(sc)
+		}
+	}
+	// States
+	skeys := make([]int, 0, len(gi.states))
+	for k := range gi.states {
+		skeys = append(skeys, int(k))
+	}
+	sort.Ints(skeys)
+	w.u32(uint32(len(skeys)))
+	for _, k := range skeys {
+		sb := gi.states[int32(k)]
+		w.i32(int32(k))
+		w.i32(int32(sb.stateType))
+		w.exp(sb.stateTypeExp)
+		w.i32(int32(sb.moveType))
+		w.exp(sb.moveTypeExp)
+		w.i32(int32(sb.physics))
+		w.exp(sb.physicsExp)
+		w.i32(int32(sb.playerNo))
+		w.scb([]scParam(sb.stateDef))
+		w.u32(uint32(len(sb.ctrlsps)))
+		for _, x := range sb.ctrlsps {
+			w.i32(x)
+		}
+		w.i32(sb.numVars)
+		w.block(&sb.block)
+	}
+	w.b = append(w.b, "END!"...)
+
+	name := strings.NewReplacer("/", "_", "\\", "_", "..", "").Replace(cdef)
+	os.MkdirAll("cooked", 0o755)
+	path := "cooked/" + name + ".cvfc"
+	if err := os.WriteFile(path, w.b, 0o644); err != nil {
+		vitaTrace("cook: cannot write " + path + ": " + err.Error())
+		return
+	}
+	vitaTrace("cook: wrote " + path + " (" + itoa(len(w.b)) + " bytes, " + itoa(len(skeys)) + " states, " + itoa(len(pool)) + " strings)")
+}
diff --git a/src/cvfheadless.go b/src/cvfheadless.go
new file mode 100644
index 0000000..96625b7
--- /dev/null
+++ b/src/cvfheadless.go
@@ -0,0 +1,626 @@
+package main
+
+import (
+	"os"
+	"runtime"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Headless quick-vs match, the entry point of the native C engine's
+// translated simulation (tools/gen/gotoc root "cvfHeadlessMain").
+//
+// It performs what a command-line quick match does in Ikemen GO, minus
+// window, renderer, audio and Lua:
+//   - main.go realMain: command line, LUTs, config
+//   - System.init: the non-platform part
+//   - external/script/main.lua main.f_commandLine (no -loadmotif)
+//   - the Lua "game" function for one match
+//
+// Returns the winning side (1, 2), 0 for a draw, -1 on error.
+// cvfHeadless: running without window/renderer (platform calls are skipped).
+var cvfHeadless bool
+
+// cvfGcSafepoint marks a frame boundary for the native engine's garbage
+// collector (implemented in C; nothing to do under the Go runtime).
+func cvfGcSafepoint(fighting bool) {}
+
+// CVF_FRAMES=n stops after n frames (benchmarks).
+var cvfFrames, cvfMaxFrames int
+
+func cvfHeadlessMain(args []string) int32 {
+	cvfHeadless = true
+	gfx = &nullRenderer{} // GPU resources are created but never drawn
+	CreatePalTexture(256)
+	if n, err := strconv.Atoi(os.Getenv("CVF_FRAMES")); err == nil {
+		cvfMaxFrames = n
+	}
+	// ---- main.go
+	sys.baseDir = "./"
+	os.Args = append([]string{"ikemen-go"}, args...)
+	processCommandLine()
+	if sys.cmdFlags == nil {
+		sys.cmdFlags = make(map[string]string)
+	}
+	initLUTs()
+	configPath := "save/config.ini"
+	if val, ok := sys.cmdFlags["-config"]; ok {
+		configPath = val
+	}
+	cfg, err := loadConfig(configPath)
+	if err != nil {
+		LogMessage("loadConfig: %v", err)
+		return -1
+	}
+	cvfApplyDisplay(cfg)
+	sys.cfg = *cfg
+
+	// ---- System.init without window/renderer/audio/Lua
+	sys.setGameSize(int32(sys.gameWidth), int32(sys.gameHeight))
+	for i := range sys.cgi {
+		sys.cgi[i].palInfo = make(map[int]PalInfo)
+	}
+	sys.resetRemapInput()
+	for i := range sys.stringPool {
+		sys.stringPool[i] = *NewStringPool()
+	}
+
+	// ---- main.lua: main.f_commandLine
+	flags := sys.cmdFlags
+	sys.gameMode = "quickvs"
+	sys.credits = -1
+	sys.cfg.SetValueUpdate("Config.BootLoadingMode", "0")
+	fs, err := loadFightScreen("")
+	if err != nil {
+		LogMessage("loadFightScreen: %v", err)
+		return -1
+	}
+	sys.fightScreen = *fs
+
+	matchWinsDraw := [2]int32{int32(sys.cfg.Options.Match.MaxDrawGames), int32(sys.cfg.Options.Match.MaxDrawGames)}
+	matchWinsSimul := [2]int32{int32(sys.cfg.Options.Simul.Match.Wins), int32(sys.cfg.Options.Simul.Match.Wins)}
+	matchWinsSingle := [2]int32{int32(sys.cfg.Options.Match.Wins), int32(sys.cfg.Options.Match.Wins)}
+	matchWinsTag := [2]int32{int32(sys.cfg.Options.Tag.Match.Wins), int32(sys.cfg.Options.Tag.Match.Wins)}
+	roundTime := int32(sys.cfg.Options.Time)
+	cvfSetFightScreenElements(sys.cfg.Options.GuardBreak, sys.cfg.Options.Dizzy, sys.cfg.Options.RedLife)
+	frames := sys.fightScreen.time.framespercount
+
+	type qvPlayer struct {
+		character      string
+		player, num    int
+		pal            int
+		ai             float32
+		input          int
+	}
+	var players []qvPlayer
+	teamMode := [2]int32{0, 0}
+	numChars := [2]int32{0, 0}
+	assignedPals := map[string]map[int]bool{}
+	for num := 1; num <= MaxPlayerNo; num++ { // main.lua sorts players by -p<num>
+		v, ok := flags["-p"+strconv.Itoa(num)]
+		if !ok {
+			continue
+		}
+		player := 2 - num%2
+		numChars[player-1]++
+		pal := 1
+		if s, ok := flags["-p"+strconv.Itoa(num)+".color"]; ok {
+			pal = int(Atoi(s))
+		} else if s, ok := flags["-p"+strconv.Itoa(num)+".pal"]; ok {
+			pal = int(Atoi(s))
+		} else if ap, ok := assignedPals[v]; ok {
+			for i := 1; i <= 12; i++ {
+				if !ap[i] {
+					pal = i
+					break
+				}
+			}
+		}
+		if assignedPals[v] == nil {
+			assignedPals[v] = map[int]bool{}
+		}
+		assignedPals[v][pal] = true
+		ai := float32(0)
+		if s, ok := flags["-p"+strconv.Itoa(num)+".ai"]; ok {
+			ai = float32(Atof(s))
+		}
+		input := player
+		if s, ok := flags["-p"+strconv.Itoa(num)+".input"]; ok {
+			input = int(Atoi(s))
+		}
+		players = append(players, qvPlayer{character: v, player: player, num: num, pal: pal, ai: ai, input: input})
+		cvfRefresh() // main.lua calls refresh() for every -p<n> flag
+	}
+	if s, ok := flags["-tmode1"]; ok {
+		teamMode[0] = Atoi(s)
+	}
+	if s, ok := flags["-tmode2"]; ok {
+		teamMode[1] = Atoi(s)
+	}
+	if s, ok := flags["-time"]; ok {
+		roundTime = Atoi(s)
+	}
+	if s, ok := flags["-rounds"]; ok {
+		for i := 0; i < 2; i++ {
+			matchWinsSingle[i] = Atoi(s)
+			matchWinsSimul[i] = Atoi(s)
+			matchWinsTag[i] = Atoi(s)
+		}
+	}
+	if s, ok := flags["-draws"]; ok {
+		for i := 0; i < 2; i++ {
+			matchWinsDraw[i] = Atoi(s)
+		}
+	}
+	framesMul := [2]int32{1, 1}
+	for side := 0; side < 2; side++ {
+		if teamMode[side] == 0 && numChars[side] > 1 {
+			teamMode[side] = 1
+		}
+		if teamMode[side] == 3 {
+			framesMul[side] = numChars[side]
+		}
+	}
+	for side := 0; side < 2; side++ {
+		enemy := 1 - side
+		switch teamMode[enemy] {
+		case 1:
+			sys.matchWins[side] = matchWinsSimul[enemy]
+		case 2:
+			sys.matchWins[side] = numChars[enemy]
+		case 3:
+			sys.matchWins[side] = matchWinsTag[enemy]
+		default:
+			sys.matchWins[side] = matchWinsSingle[enemy]
+		}
+		sys.maxDraws[side] = matchWinsDraw[side]
+	}
+	frames = frames * Max(framesMul[0], framesMul[1])
+	sys.curFramesPerCount = frames
+	t := Max(-1, roundTime*frames)
+	if t > 0 && sys.cfg.Config.LegacyTime {
+		t += sys.curFramesPerCount - 1
+	}
+	sys.maxRoundTime = t
+
+	stage := sys.cfg.Debug.StartStage
+	if s, ok := flags["-s"]; ok {
+		for _, v := range []string{s, "stages/" + s, "stages/" + s + ".def"} {
+			if FileExist(v) != "" {
+				stage = v
+				break
+			}
+		}
+	}
+	if _, err := sys.sel.AddStage(stage); err != nil {
+		LogMessage("Unable to add stage: %v", stage)
+		return -1
+	}
+	sys.sel.ClearSelected()
+	sys.matchNo = 1
+	sys.sel.SelectStage(1)
+	for side := 0; side < 2; side++ {
+		cvfSetTeamMode(side, TeamMode(teamMode[side]), numChars[side])
+	}
+	ref := 0
+	charDef := map[string]int{}
+	for _, v := range players {
+		key := strings.ToLower(v.character)
+		charRef, ok := charDef[key]
+		if !ok {
+			sys.sel.AddChar(v.character)
+			charRef = ref
+			charDef[key] = charRef
+			ref++
+		}
+		sys.sel.AddSelectedChar(v.player-1, charRef, v.pal)
+		sys.aiLevel[v.num-1] = Clamp(v.ai, 0, 8)
+		sys.inputRemap[v.num-1] = v.input - 1
+	}
+
+	// main.lua main.f_commandLine: -ip <host> joins, -ip "" hosts (netplay)
+	if host, ok := flags["-ip"]; ok {
+		// with vita_statehash.txt the fixed seed is set before the host
+		// draws the match seed, so test matches are reproducible
+		vitaStateHashEnabled()
+		if !cvfNetplayConnect(host) {
+			return -1
+		}
+	}
+
+	// loadStart("pausemenu=false")
+	if sys.sel.gameParams == nil {
+		sys.sel.gameParams = newGameParamsFromMotif(&sys.motif)
+	}
+	sys.sel.music = make(Music)
+	sys.sel.gameParams.AppendParams(SplitAndTrim(StripComment("pausemenu=false"), ","))
+	sys.sel.music.AppendParams(sys.sel.gameParams.MusicEntries())
+	sys.loaderReset()
+
+	winp := cvfGame()
+	stateDumpFinish()
+	cvfSessionReport(1, winp)
+
+	// CVF_NET_MATCHES="P1:P2[:pal1:pal2] ...": more matches in the same
+	// online session (tests/netplay "session" scenario), as main.lua's netplay
+	// versus loop plays them: the Lua game function returns (it stops the
+	// delay-netplay input and resynchronizes), the character select runs for
+	// CVF_NET_SELECT_FRAMES delay-netplay frames (default 60), then the next
+	// pair is loaded and played. A pair equal to the previous one is a
+	// rematch. Match k > 1 writes statedump.k.txt.
+	for k, m := range strings.Fields(os.Getenv("CVF_NET_MATCHES")) {
+		if _, online := flags["-ip"]; sys.esc || sys.gameEnd || (online && sys.netConnection == nil) {
+			break
+		}
+		f := strings.Split(m, ":")
+		if len(f) < 2 {
+			LogMessage("CVF_NET_MATCHES: bad entry %q", m)
+			return -1
+		}
+		selectFrames := 60
+		if n, err := strconv.Atoi(os.Getenv("CVF_NET_SELECT_FRAMES")); err == nil && n >= 0 {
+			selectFrames = n
+		}
+		for i := 0; i < selectFrames && !sys.esc && !sys.gameEnd; i++ {
+			cvfRefresh()
+		}
+		if sys.esc || sys.gameEnd {
+			break
+		}
+		sys.sel.ClearSelected()
+		sys.sel.SelectStage(1)
+		pals := [2]int{1, 1}
+		if strings.EqualFold(f[0], f[1]) {
+			pals[1] = 2
+		}
+		for side := 0; side < 2; side++ {
+			if len(f) >= 4 {
+				pals[side] = int(Atoi(f[2+side]))
+			}
+			cvfSetTeamMode(side, TM_Single, 1)
+			key := strings.ToLower(f[side])
+			charRef, ok := charDef[key]
+			if !ok {
+				sys.sel.AddChar(f[side])
+				charRef = ref
+				charDef[key] = charRef
+				ref++
+			}
+			sys.sel.AddSelectedChar(side, charRef, pals[side])
+		}
+		stateDumpRotate("statedump." + strconv.Itoa(k+2) + ".txt")
+		sys.sel.gameParams = newGameParamsFromMotif(&sys.motif)
+		sys.sel.music = make(Music)
+		sys.sel.gameParams.AppendParams(SplitAndTrim(StripComment("pausemenu=false"), ","))
+		sys.sel.music.AppendParams(sys.sel.gameParams.MusicEntries())
+		sys.loaderReset()
+		LogMessage("session: match %d: %s vs %s", k+2, f[0], f[1])
+		winp = cvfGame()
+		stateDumpFinish()
+		cvfSessionReport(k+2, winp)
+	}
+	return winp
+}
+
+// After each match of a session: the winner and memory after a full
+// collection (RSS from /proc/self/statm where there is one; the Go heap from
+// runtime.MemStats, which the native engine leaves at zero: its collector
+// reports with CVF_GC_TRACE=1).
+func cvfSessionReport(match int, winp int32) {
+	if os.Getenv("CVF_NET_MATCHES") == "" {
+		return
+	}
+	runtime.GC()
+	var ms runtime.MemStats
+	runtime.ReadMemStats(&ms)
+	rss := int64(-1)
+	if b, err := os.ReadFile("/proc/self/statm"); err == nil {
+		if f := strings.Fields(string(b)); len(f) > 1 {
+			rss = int64(Atoi(f[1])) * 4096 / 1024
+		}
+	}
+	LogMessage("session: match %d done: winner %d, rss %d KB, go heap %d KB, gc %d",
+		match, winp, rss, ms.HeapAlloc/1024, ms.NumGC)
+}
+
+
+
+// The Lua setFightScreenElements function for main.f_commandLine's table
+// {guardbar, stunbar, redlifebar}.
+func cvfSetFightScreenElements(guardbar, stunbar, redlifebar bool) {
+	sys.fightScreen.guardbar = guardbar
+	sys.fightScreen.stunbar = stunbar
+	sys.fightScreen.redlifebar = redlifebar
+	if _, ok := sys.fightScreen.match.enabled[sys.gameMode]; ok {
+		sys.fightScreen.match.active = sys.fightScreen.match.enabled[sys.gameMode]
+	}
+	for _, v := range sys.fightScreen.aiLevels {
+		if _, ok := v.enabled[sys.gameMode]; ok {
+			v.active = v.enabled[sys.gameMode]
+		}
+	}
+	for _, v := range sys.fightScreen.scores {
+		if _, ok := v.enabled[sys.gameMode]; ok {
+			v.active = v.enabled[sys.gameMode]
+		}
+	}
+	for _, v := range sys.fightScreen.winCounts {
+		if _, ok := v.enabled[sys.gameMode]; ok {
+			v.active = v.enabled[sys.gameMode]
+		}
+	}
+}
+
+// The Lua setTeamMode function.
+func cvfSetTeamMode(side int, tm TeamMode, nt int32) {
+	sys.sel.selected[side] = nil
+	sys.tmode[side] = tm
+	if tm == TM_Turns {
+		sys.numSimul[side] = 1
+	} else {
+		sys.numSimul[side] = nt
+	}
+	sys.numTurns[side] = nt
+	if (tm == TM_Simul || tm == TM_Tag) && nt == 1 {
+		sys.tmode[side] = TM_Single
+	}
+}
+
+// The Lua game function for a single match (no netplay, no retries).
+func cvfGame() int32 {
+	sys.keyString = ""
+	sys.keyInput = KeyUnknown
+	sys.gameRunning = true
+	sys.escPending = false
+	sys.endMatch = false
+
+	winp := int32(0)
+	sys.debugRef = [2]int{}
+	sys.roundsExisted = [2]int32{}
+	sys.scoreRounds = [][2]float32{}
+	for i := range sys.fightScreen.winIcons {
+		sys.fightScreen.winIcons[i].clear()
+	}
+	sys.draws = 0
+	sys.statsLog.startMatch()
+
+	// as the Lua game function: reset net inputs, resynchronize on return
+	if sys.netConnection != nil {
+		sys.netConnection.Stop()
+	}
+	defer sys.synchronize()
+
+	for {
+		if sys.roundNo == 1 {
+			sys.charList.clear()
+		}
+		// synchronous load (the Lua path runs it on a goroutine and waits)
+		if sys.loader.state == LS_NotYet {
+			sys.loader.state = LS_Loading
+			sys.loader.load()
+		}
+		if sys.loader.state != LS_Complete {
+			LogMessage("load failed: %v", sys.loader.err)
+			return -1
+		}
+		sys.setGameAspect()
+		sys.initPlayerID()
+		for i := range sys.chars {
+			c := sys.chars[i]
+			if len(c) > 0 {
+				if sys.roundNo == 1 {
+					sys.charList.add(c[0])
+				} else if c[0].roundsExisted() == 0 {
+					sys.removePlayerFromCharList(i)
+					sys.charList.add(c[0])
+				}
+				if c[0].roundsExisted() == 0 {
+					c[0].loadPalettes()
+				}
+				for j := range sys.chars {
+					cj := sys.chars[j]
+					if i != j && len(cj) > 0 {
+						if len(cj[0].cmd) == 0 {
+							cj[0].cmd = make([]CommandList, len(sys.chars))
+						}
+						cj[0].cmd[i].CopyList(c[0].cmd[i])
+					}
+				}
+			}
+		}
+		sys.charList.audit()
+		if sys.roundNo == 1 {
+			sys.endMatch = false
+			sys.teamLeader = [2]int{0, 1}
+			sys.stage.reset()
+		}
+		if sys.runMatch() {
+			continue // match restart: reload and run again
+		}
+		if sys.esc {
+			winp = -1
+		} else {
+			w1 := sys.wins[0] >= sys.matchWins[0]
+			w2 := sys.wins[1] >= sys.matchWins[1]
+			if w1 != w2 {
+				winp = Btoi(w1) + Btoi(w2)*2
+			}
+		}
+		break
+	}
+	sys.gameRunning = false
+	return winp
+}
+
+// The Lua refresh function (one UI frame).
+func cvfRefresh() {
+	sys.luaDiscardDrawQueue()
+	if sys.motif.fadeOut.isActive() {
+		sys.motif.fadeOut.step()
+	} else if sys.motif.fadeIn.isActive() {
+		sys.motif.fadeIn.step()
+	}
+	sys.stepCommandLists()
+	sys.uiFrameCounter++
+	sys.update()
+}
+
+// ---- Netplay (tests/netplay): the -ip part of main.lua main.f_commandLine,
+// scripted inputs and frame pacing for a headless online match.
+
+// The Lua enterNetPlay function.
+func cvfEnterNetPlay(host string) error {
+	if sys.netConnection != nil {
+		return Error("Connection already established.")
+	}
+	sys.sessionWarning = ""
+	sys.chars = [len(sys.chars)][]*Char{}
+	sys.netConnection = NewNetConnection()
+	if sys.cfg.Netplay.RollbackNetcode {
+		rs := NewRollbackSession(sys.cfg.Netplay.Rollback)
+		sys.rollback.session = &rs
+	}
+	if host != "" {
+		if sys.cfg.Netplay.RollbackNetcode {
+			sys.rollback.session.host = host
+		}
+		sys.netConnection.Connect(host, sys.cfg.Netplay.ListenPort)
+	} else if err := sys.netConnection.Accept(sys.cfg.Netplay.ListenPort); err != nil {
+		return err
+	}
+	return nil
+}
+
+// enterNetPlay, wait for connected(), synchronize() (main.lua -ip).
+func cvfNetplayConnect(host string) bool {
+	if err := cvfEnterNetPlay(host); err != nil {
+		LogMessage("enterNetPlay: %v", err)
+		return false
+	}
+	for !(sys.netConnection != nil && sys.netConnection.IsConnected()) {
+		if sys.esc || sys.gameEnd {
+			return false
+		}
+		cvfRefresh()
+	}
+	cvfRefresh()
+	if vitaStateHashEnabled() {
+		// reproducible test runs: the frames counted while waiting for the
+		// peer become the synchronized pre-match time (GameTime), so
+		// count from the connection instead
+		sys.frameCounter = 0
+	}
+	if err := sys.synchronize(); err != nil {
+		LogMessage("synchronize: %v (%v)", err, sys.sessionWarning)
+		return false
+	}
+	// Test relay (tests/netplay/udp_relay.py): send rollback UDP to this port
+	// instead of the one the peer advertised.
+	if p, err := strconv.Atoi(os.Getenv("CVF_NET_PEER_UDP")); err == nil && p > 0 && sys.netConnection != nil {
+		sys.netConnection.rollbackRemotePort = p
+	}
+	cvfRefresh()
+	return true
+}
+
+// Scripted local input (CVF_NET_INPUT=seed): directions and button taps from
+// a hash of the seed and the match time, written into the key state of
+// player 1's keyboard config, which the netplay/rollback code reads as the
+// local input. Being a function of the simulated time only, the inputs are
+// the same whatever the network does (stalls, rollbacks).
+var cvfNetInputSeed = -1
+
+func cvfNetInputTick() {
+	if cvfNetInputSeed < 0 {
+		cvfNetInputSeed = 0
+		if n, err := strconv.Atoi(os.Getenv("CVF_NET_INPUT")); err == nil && n > 0 {
+			cvfNetInputSeed = n
+		}
+	}
+	if cvfNetInputSeed == 0 || len(sys.keyConfig) == 0 {
+		return
+	}
+	if sys.keyState == nil {
+		sys.keyState = make(map[Key]bool)
+	}
+	kc := sys.keyConfig[0]
+	keys := [10]int{kc.dU, kc.dD, kc.dL, kc.dR, kc.bA, kc.bB, kc.bC, kc.bX, kc.bY, kc.bZ}
+	t := uint32(sys.matchTime)
+	h := uint32(cvfNetInputSeed)*2654435761 ^ (t>>3)*40503
+	h ^= h >> 15
+	h *= 2246822519
+	h ^= h >> 13
+	var on [10]bool
+	switch h % 9 { // hold a direction for 8 frames
+	case 1:
+		on[3] = true
+	case 2:
+		on[2] = true
+	case 3:
+		on[0] = true
+	case 4:
+		on[1] = true
+	case 5:
+		on[1], on[3] = true, true
+	case 6:
+		on[1], on[2] = true, true
+	case 7:
+		on[0], on[3] = true, true
+	case 8:
+		on[0], on[2] = true, true
+	}
+	if (h>>8)%3 == 0 && t&7 < 2 { // tap a button on 1 block in 3
+		on[4+(h>>12)%6] = true
+	}
+	for _, k := range keys {
+		if k != 0 {
+			sys.keyState[Key(k)] = false
+		}
+	}
+	for i, k := range keys {
+		if k != 0 && on[i] {
+			sys.keyState[Key(k)] = true
+		}
+	}
+}
+
+// CVF_HEADLESS_FPS=n paces the headless loop at n frames per second (as a
+// windowed game would); unset, it runs as fast as it can.
+var cvfHeadlessFps = -1
+var cvfHeadlessNext time.Time
+
+// System.await without window: no rendering. Yields to the other goroutines
+// (the native engine's are cooperative: netplay and GGPO workers run here).
+func (s *System) cvfHeadlessAwait() bool {
+	s.frameSkip = true
+	cvfFrames++
+	if cvfMaxFrames > 0 && cvfFrames >= cvfMaxFrames {
+		s.gameEnd = true
+	}
+	cvfNetInputTick()
+	if cvfHeadlessFps < 0 {
+		cvfHeadlessFps = 0
+		if n, err := strconv.Atoi(os.Getenv("CVF_HEADLESS_FPS")); err == nil && n > 0 {
+			cvfHeadlessFps = n
+		}
+	}
+	if cvfHeadlessFps > 0 {
+		now := time.Now()
+		if cvfHeadlessNext.IsZero() || now.Sub(cvfHeadlessNext) > time.Second {
+			cvfHeadlessNext = now
+		}
+		wait := time.Second / time.Duration(cvfHeadlessFps)
+		if s.rollback.session != nil {
+			// as System.await: GGPO's time sync stretches the frame
+			wait = s.rollback.session.loopTimer.usToWaitThisLoop()
+		}
+		cvfHeadlessNext = cvfHeadlessNext.Add(wait)
+		if d := cvfHeadlessNext.Sub(now); d > 0 {
+			time.Sleep(d)
+		}
+	} else {
+		runtime.Gosched()
+	}
+	return !s.gameEnd
+}
