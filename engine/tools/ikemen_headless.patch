diff --git a/src/jsoncache.go b/src/jsoncache.go
new file mode 100644
index 0000000..24adbf5
--- /dev/null
+++ b/src/jsoncache.go
@@ -0,0 +1,36 @@
+package main
+
+import (
+	"os"
+	"sync"
+)
+
+var jsonFileCache = struct {
+	sync.Mutex
+	m map[string][]byte
+}{m: map[string][]byte{}}
+
+// jsonFileCached returns the contents of a JSON file. On the Vita the bytes are
+// kept in memory until jsonFileCacheReset is called by a writer.
+func jsonFileCached(path string) ([]byte, error) {
+	if !isVita {
+		return os.ReadFile(path)
+	}
+	jsonFileCache.Lock()
+	defer jsonFileCache.Unlock()
+	if d, ok := jsonFileCache.m[path]; ok {
+		return d, nil
+	}
+	d, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	jsonFileCache.m[path] = d
+	return d, nil
+}
+
+func jsonFileCacheReset() {
+	jsonFileCache.Lock()
+	jsonFileCache.m = map[string][]byte{}
+	jsonFileCache.Unlock()
+}
diff --git a/src/luacache.go b/src/luacache.go
new file mode 100644
index 0000000..4442bf8
--- /dev/null
+++ b/src/luacache.go
@@ -0,0 +1,31 @@
+package main
+
+import (
+	lua "github.com/yuin/gopher-lua"
+)
+
+// luaChunkCache holds compiled versions of Lua snippets the engine runs every
+// frame (Common.Lua "loop()", motif hooks). DoString re-parses and recompiles
+// the source each call, which on the Vita cost ~10 parses per frame.
+var luaChunkCache = map[*lua.LState]map[string]*lua.LFunction{}
+
+func luaDoStringCached(l *lua.LState, src string) error {
+	if l == nil { // headless runner: no Lua state (scripts drive menus only)
+		return nil
+	}
+	m := luaChunkCache[l]
+	if m == nil {
+		m = map[string]*lua.LFunction{}
+		luaChunkCache[l] = m
+	}
+	fn, ok := m[src]
+	if !ok {
+		var err error
+		if fn, err = l.LoadString(src); err != nil {
+			return err
+		}
+		m[src] = fn
+	}
+	l.Push(fn)
+	return l.PCall(0, lua.MultRet, nil)
+}
