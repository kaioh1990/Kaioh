+// Reads a quoted string into c.token
+func (c *CharCompiler) expText(in *string) error {
+	i := strings.Index(*in, "\"")
+	if c.token != "\"" || i < 0 {
+		return Error("Not enclosed in \"")
 	}
+	c.token = (*in)[:i]
+	*in = (*in)[i+1:]
+	return nil
+}
 
