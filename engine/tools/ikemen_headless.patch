diff --git a/src/render_gles32_batch.go b/src/render_gles32_batch.go
new file mode 100644
index 0000000..1201391
--- /dev/null
+++ b/src/render_gles32_batch.go
@@ -0,0 +1,276 @@
+//go:build android || vita || cvf
+
+package main
+
+import (
+	"os"
+	"unsafe"
+
+	gl "github.com/leonkasovan/gl/v3.2/gles2"
+)
+
+// Vita sprite batching.
+//
+// vitaGL charges a few hundred microseconds per glDrawArrays (uniform buffer
+// upload, vertex copy, sceGxm setup), so quads drawn through the sprite shader
+// are not submitted immediately. RenderQuad/RenderQuadBatch append the current
+// vertex data to a pending triangle strip (joined with degenerate triangles,
+// exactly like the tiled-background path) and the strip is drawn by vitaFlush,
+// which every GL state change in the renderer calls first. Because a flush
+// precedes any state change, each queued quad is drawn with exactly the state
+// it would have been drawn with immediately, so the output is unchanged.
+//
+// The atlas rectangles (spriteUV, palUV) are the only per-sprite state that
+// differ between consecutive sprites in practice, so on the Vita they are
+// vertex attributes instead of uniforms (see vita_shaders.go).
+
+const (
+	vitaBatchFloats   = 12 // x y u v | spriteUV(4) | palUV(4)
+	vitaBatchMaxVerts = 8192
+)
+
+type vitaBatch struct {
+	enabled bool
+	pend    []float32 // fixed allocation: its base pointer never changes
+	n       int       // pending vertices
+	cur     []float32 // vertex data of the last SetVertexData (x y u v per vertex)
+	spUV    [4]float32
+	palUV   [4]float32
+	locSp   uint32
+	locPal  uint32
+	ptrOK   bool // attribute pointers of the sprite VAO point at pend
+	flushes int
+	quads   int
+
+	// Lazy sprite-shader uniforms: SetUniform*Sub records the wanted value in
+	// r.uniArr* and marks it dirty; the GL-side value (have*) is only updated
+	// when a quad is queued, so a value that is set and restored between two
+	// draws (e.g. clipOn around every windowed sprite) costs nothing, and a
+	// real change flushes the pending strip before the upload.
+	lazy  bool
+	haveI [64]struct {
+		v  int32
+		ok bool
+	}
+	haveF [64]struct {
+		v [4]float32
+		n uint8
+	}
+	haveM [64]struct {
+		v  [16]float32
+		ok bool
+	}
+	dirty     [3 * 64]bool
+	dirtyList []int32 // kind<<8 | loc
+
+	// Two sampler slots (tex, texB) for the sprite atlas, chosen per quad
+	// through palUV.w, so sprites alternating between two atlases batch.
+	slotLoc  [2]int32 // uniform locations of tex / texB
+	slotUnit [2]int32 // texture unit each slot samples (-1: none)
+	slotUse  [2]uint64
+	slotTick uint64
+	texSel   float32 // palUV.w of the next queued quad
+}
+
+// vitaSelectTexSlot points one of the two atlas samplers at the given
+// texture unit (lazily, as a uniform change) and records which one the next
+// quad uses.
+func (r *Renderer_GLES32) vitaSelectTexSlot(unit int32) {
+	b := &r.vb
+	b.slotTick++
+	for i := 0; i < 2; i++ {
+		if b.slotUnit[i] == unit {
+			b.slotUse[i] = b.slotTick
+			b.texSel = float32(i)
+			return
+		}
+	}
+	i := 0
+	if b.slotLoc[1] >= 0 && b.slotUse[1] < b.slotUse[0] {
+		i = 1
+	}
+	b.slotUnit[i], b.slotUse[i] = unit, b.slotTick
+	b.texSel = float32(i)
+	r.SetUniformISub(b.slotLoc[i], unit)
+}
+
+// vitaMarkDirty records a lazily set sprite-shader uniform (kind 0 int, 1 float, 2 matrix).
+func (r *Renderer_GLES32) vitaMarkDirty(kind, loc int32) {
+	b := &r.vb
+	k := kind*64 + loc
+	if !b.dirty[k] {
+		b.dirty[k] = true
+		b.dirtyList = append(b.dirtyList, kind<<8|loc)
+	}
+}
+
+// vitaSyncUniforms uploads the dirty sprite-shader uniforms whose value
+// differs from the GL side, flushing the pending strip first.
+func (r *Renderer_GLES32) vitaSyncUniforms() {
+	b := &r.vb
+	if len(b.dirtyList) == 0 {
+		return
+	}
+	for _, d := range b.dirtyList {
+		kind, loc := d>>8, d&0xff
+		b.dirty[kind*64+loc] = false
+		switch kind {
+		case 0:
+			w, h := &r.uniArrI[loc], &b.haveI[loc]
+			if h.ok && h.v == w.v {
+				continue
+			}
+			r.vitaFlush()
+			h.ok, h.v = true, w.v
+			gl.Uniform1i(loc, w.v)
+		case 1:
+			w, h := &r.uniArrF[loc], &b.haveF[loc]
+			if h.n == w.n && h.v == w.v {
+				continue
+			}
+			r.vitaFlush()
+			h.n, h.v = w.n, w.v
+			switch w.n {
+			case 1:
+				gl.Uniform1f(loc, w.v[0])
+			case 2:
+				gl.Uniform2f(loc, w.v[0], w.v[1])
+			case 3:
+				gl.Uniform3f(loc, w.v[0], w.v[1], w.v[2])
+			case 4:
+				gl.Uniform4f(loc, w.v[0], w.v[1], w.v[2], w.v[3])
+			}
+		case 2:
+			w, h := &r.uniArrM[loc], &b.haveM[loc]
+			if h.ok && h.v == w.v {
+				continue
+			}
+			r.vitaFlush()
+			h.ok, h.v = true, w.v
+			gl.UniformMatrix4fv(loc, 1, false, &h.v[0])
+		}
+	}
+	b.dirtyList = b.dirtyList[:0]
+}
+
+func (r *Renderer_GLES32) vitaBatchInit() {
+	if !isVita || !vitaClientArrays() || r.spriteShader == nil {
+		return
+	}
+	if _, err := os.Stat("vita_nobatch.txt"); err == nil {
+		Logcat("vita: sprite batching off (vita_nobatch.txt)")
+		return
+	}
+	locSp, okSp := r.spriteShader.attributes["spriteUV"]
+	locPal, okPal := r.spriteShader.attributes["palUV"]
+	if !okSp || !okPal || locSp < 0 || locPal < 0 {
+		Logcat("vita: sprite batching off (atlas attributes missing)")
+		return
+	}
+	b := &r.vb
+	b.locSp, b.locPal = uint32(locSp), uint32(locPal)
+	b.slotLoc = [2]int32{-1, -1}
+	b.slotUnit = [2]int32{-1, -1}
+	if loc, ok := r.spriteShader.uniforms["tex"]; ok {
+		b.slotLoc[0] = loc
+	}
+	if loc, ok := r.spriteShader.uniforms["texB"]; ok && loc >= 0 {
+		b.slotLoc[1] = loc
+	}
+	b.pend = make([]float32, vitaBatchMaxVerts*vitaBatchFloats)
+	b.cur = make([]float32, 0, 1024)
+	b.dirtyList = make([]int32, 0, 64)
+	b.enabled = true
+	b.lazy = true
+	Logcat("vita: sprite batching on")
+}
+
+// vitaBatching reports whether quads are currently being queued.
+func (r *Renderer_GLES32) vitaBatching() bool {
+	return r.vb.enabled && r.program == r.spriteShader.program
+}
+
+// vitaFlush draws the pending strip. Called before any GL state change.
+func (r *Renderer_GLES32) vitaFlush() {
+	b := &r.vb
+	n := b.n
+	if n == 0 {
+		return
+	}
+	b.n = 0 // re-entrancy: the binds below call back into vitaFlush
+	b.flushes++
+	stride := int32(vitaBatchFloats * 4)
+	r.bindVertexArray(r.spriteVAO)
+	r.bindBuffer(gl.ARRAY_BUFFER, 0)
+	if !b.ptrOK {
+		base := unsafe.Pointer(&b.pend[0])
+		gl.VertexAttribPointer(r.vitaLocPos, 2, gl.FLOAT, false, stride, base)
+		gl.VertexAttribPointer(r.vitaLocUV, 2, gl.FLOAT, false, stride, unsafe.Pointer(&b.pend[2]))
+		gl.VertexAttribPointer(b.locSp, 4, gl.FLOAT, false, stride, unsafe.Pointer(&b.pend[4]))
+		gl.VertexAttribPointer(b.locPal, 4, gl.FLOAT, false, stride, unsafe.Pointer(&b.pend[8]))
+		b.ptrOK = true
+	}
+	gl.DrawArrays(gl.TRIANGLE_STRIP, 0, int32(n))
+}
+
+// vitaQueueQuads appends the current vertex data (a triangle strip of quads)
+// to the pending strip, joining it to the previous quad with two degenerate
+// vertices as appendTransformedQuadTriangles does.
+func (r *Renderer_GLES32) vitaQueueQuads(vertexCount int) {
+	b := &r.vb
+	if vertexCount <= 0 || len(b.cur) < vertexCount*4 {
+		return
+	}
+	r.vitaSyncUniforms()
+	need := vertexCount
+	if b.n > 0 {
+		need += 2
+	}
+	if b.n+need > vitaBatchMaxVerts {
+		r.vitaFlush()
+		need = vertexCount
+	}
+	if need > vitaBatchMaxVerts {
+		return // never happens with the engine's tile batches
+	}
+	b.quads++
+	p := b.pend
+	o := b.n * vitaBatchFloats
+	palv := b.palUV
+	palv[3] = b.texSel // palUV.w is unused by the palette lookup: it selects tex/texB
+	sp, pal := &b.spUV, &palv
+	if b.n > 0 {
+		// duplicate the last pending vertex, then the first new one
+		copy(p[o:o+vitaBatchFloats], p[o-vitaBatchFloats:o])
+		o += vitaBatchFloats
+		p[o], p[o+1], p[o+2], p[o+3] = b.cur[0], b.cur[1], b.cur[2], b.cur[3]
+		copy(p[o+4:o+8], sp[:])
+		copy(p[o+8:o+12], pal[:])
+		o += vitaBatchFloats
+	}
+	for i := 0; i < vertexCount; i++ {
+		c := b.cur[i*4 : i*4+4]
+		p[o], p[o+1], p[o+2], p[o+3] = c[0], c[1], c[2], c[3]
+		copy(p[o+4:o+8], sp[:])
+		copy(p[o+8:o+12], pal[:])
+		o += vitaBatchFloats
+	}
+	b.n += need
+}
+
+// vitaSetVertexData stores the quad strip for the next RenderQuad*.
+func (r *Renderer_GLES32) vitaSetVertexData(values []float32) {
+	b := &r.vb
+	if cap(b.cur) < len(values) {
+		b.cur = make([]float32, len(values), len(values)*2)
+	}
+	b.cur = b.cur[:len(values)]
+	copy(b.cur, values)
+}
+
+// vitaBatchStats is appended to the perf log line.
+func (r *Renderer_GLES32) vitaBatchStats() (flushes, quads int) {
+	flushes, quads = r.vb.flushes, r.vb.quads
+	r.vb.flushes, r.vb.quads = 0, 0
+	return
+}
