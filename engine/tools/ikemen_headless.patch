+
+func (b *vitaBufFile) Seek(offset int64, whence int) (int64, error) {
+	switch whence {
+	case io.SeekStart:
+		b.pos = offset
+	case io.SeekCurrent:
+		b.pos += offset
+	case io.SeekEnd:
+		end, err := b.f.Seek(offset, io.SeekEnd)
+		if err != nil {
+			return b.pos, err
+		}
+		b.pos = end
+	}
+	if b.pos < 0 {
+		b.pos = 0
+	}
+	return b.pos, nil
+}
