+// Helper for equal/not equal. Caller handles the negation itself
+func (c *CharCompiler) eqne(in *string, f func(not bool) error) error {
+	not, err := c.checkEquality(in)
+	if err != nil {
+		return err
+	}
+	if err := f(not); err != nil {
+		return err
+	}
+	return nil
+}
