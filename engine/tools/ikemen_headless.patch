diff --git a/src/spec_match.go b/src/spec_match.go
new file mode 100644
index 0000000..b171e3e
--- /dev/null
+++ b/src/spec_match.go
@@ -0,0 +1,378 @@
+package main
+
+import (
+	"regexp"
+	"strings"
+)
+
+// Match specialisation (PS Vita).
+//
+// CvF's shared states ([Statedef -3] in data/player.st and friends) are full
+// of controllers that only matter for one particular character, e.g.
+//
+//	trigger1 = enemynear,name="Stella" && enemynear,stateno=2001 && ...
+//
+// Every tick, for every player, the engine resolves the redirect, builds the
+// name string and compares it, only to find the trigger false. Once a round
+// has started the names involved are fixed, so those controllers can never
+// fire for the rest of the round.
+//
+// At compile time we record, for each controller in a negative statedef, the
+// "name facts" its trigger lines require: top-level && terms of the form
+// name="X", authorname="X", enemy[near][(0|1)],name="X" or ...,authorname="X".
+// At the start of each round, for each root character, we build a reduced
+// controller list without the controllers whose triggers are provably false
+// for this match:
+//
+//   - some triggerall line has a false fact, or
+//   - every triggerN has at least one line with a false fact.
+//
+// Anything not provably false is kept. Controllers whose trigger text
+// mentions "rand" are never removed: skipping them would change how many
+// random numbers are drawn, and the Vita must stay bit-identical with the PC
+// build for online play. Facts about enemies are only used in 1-vs-1 matches
+// (single mode on both sides), where the opponent cannot change mid-round.
+//
+// The reduced list is used only for the character it was built for, in the
+// round it was built for; everything else runs the full list. Removing
+// controllers whose triggers are false (and free of side effects) cannot
+// change behaviour: a false trigger skips the controller and leaves its
+// persistence counter alone.
+
+type nameFact struct {
+	who    int8 // 0 self, 1 first enemy, 2 second enemy
+	author bool
+	val    string
+	// kind 0: name/authorname fact above. kind 1: the term is false whenever
+	// the character has no partner (bare "numpartner", "numpartner > N" with
+	// N >= 0, or "abs(partner,var(N)) = M" with M != 0: the failed redirect
+	// yields undefined, abs keeps it, and = compares it as 0).
+	kind int8
+}
+
+type specGuard struct {
+	all  [][]nameFact // per triggerall line: facts (any false => line false)
+	trig [][]nameFact // per triggerN: facts from all its lines (any false => trigger false)
+	// trigUnknown[i]: triggerN has no facts, so it can never be proven false.
+	trigUnknown []bool
+}
+
+type specList struct {
+	owner   *Char
+	gen     uint32
+	ctrls   []StateController
+	runs    []scRunFn
+	isBlock []bool
+}
+
+var specGen uint32 = 1
+var specStats struct{ kept, removed int }
+
+var specNoPartnerRe = regexp.MustCompile(`(?i)^(?:numpartner|numpartner\s*>\s*\d+|abs\s*\(\s*partner\s*,\s*var\s*\(\s*\d+\s*\)\s*\)\s*=\s*-?0*[1-9]\d*)$`)
+
+var specFactRe = regexp.MustCompile(`(?i)^(?:(enemynear|enemy)\s*(?:\(\s*([01])\s*\))?\s*,\s*)?(name|authorname)\s*=\s*"([^"]*)"$`)
+
+var specOn = -1
+
+// specEnabled: on the Vita unless ux0:data/CvF/vita_nospec.txt exists (or
+// fusion is disabled with vita_nofuse.txt).
+func specEnabled() bool {
+	if specOn < 0 {
+		specOn = 0
+		if fuseEnabled() && FileExist("vita_nospec.txt") == "" {
+			specOn = 1
+		}
+	}
+	return specOn == 1
+}
+
+// specSplitAnd splits an expression at top-level "&&".
+func specSplitAnd(s string) []string {
+	var out []string
+	depth, start := 0, 0
+	inStr := false
+	for i := 0; i < len(s); i++ {
+		ch := s[i]
+		switch {
+		case ch == '"':
+			inStr = !inStr
+		case inStr:
+		case ch == '(' || ch == '[':
+			depth++
+		case ch == ')' || ch == ']':
+			depth--
+		case ch == '&' && depth == 0 && i+1 < len(s) && s[i+1] == '&':
+			out = append(out, s[start:i])
+			start = i + 2
+			i++
+		}
+	}
+	return append(out, s[start:])
+}
+
+// specStripParens removes parentheses that wrap the whole term.
+func specStripParens(t string) string {
+	for {
+		t = strings.TrimSpace(t)
+		if len(t) < 2 || t[0] != '(' || t[len(t)-1] != ')' {
+			return t
+		}
+		depth := 0
+		inStr := false
+		wraps := true
+		for i := 0; i < len(t); i++ {
+			ch := t[i]
+			if ch == '"' {
+				inStr = !inStr
+			}
+			if inStr {
+				continue
+			}
+			if ch == '(' {
+				depth++
+			} else if ch == ')' {
+				depth--
+				if depth == 0 && i != len(t)-1 {
+					wraps = false
+					break
+				}
+			}
+		}
+		if !wraps {
+			return t
+		}
+		t = t[1 : len(t)-1]
+	}
+}
+
+func specLineFacts(line string) []nameFact {
+	var facts []nameFact
+	for _, term := range specSplitAnd(line) {
+		t := specStripParens(term)
+		if specNoPartnerRe.MatchString(t) {
+			facts = append(facts, nameFact{kind: 1})
+			continue
+		}
+		m := specFactRe.FindStringSubmatch(t)
+		if m == nil {
+			continue
+		}
+		f := nameFact{author: strings.EqualFold(m[3], "authorname"), val: m[4]}
+		switch {
+		case m[1] == "":
+			f.who = 0
+		case m[2] == "1":
+			f.who = 2
+		default:
+			f.who = 1
+		}
+		facts = append(facts, f)
+	}
+	return facts
+}
+
+// specRegister is called by the compiler for each controller block of a
+// negative statedef, with the raw text of its trigger lines.
+func specRegister(b *StateBlock, all []string, trig [][]string, trexist []int8) {
+	if !specEnabled() || b == nil {
+		return
+	}
+	for _, l := range all {
+		if strings.Contains(strings.ToLower(l), "rand") {
+			return
+		}
+	}
+	for _, t := range trig {
+		for _, l := range t {
+			if strings.Contains(strings.ToLower(l), "rand") {
+				return
+			}
+		}
+	}
+	g := &specGuard{}
+	useful := false
+	for _, l := range all {
+		f := specLineFacts(l)
+		if len(f) > 0 {
+			g.all = append(g.all, f)
+			useful = true
+		}
+	}
+	for i := 0; i < len(trexist); i++ {
+		if trexist[i] == 0 {
+			break // evaluation stops at the first missing trigger
+		}
+		var facts []nameFact
+		if trexist[i] > 0 && i < len(trig) {
+			for _, l := range trig[i] {
+				facts = append(facts, specLineFacts(l)...)
+			}
+		}
+		g.trig = append(g.trig, facts)
+		g.trigUnknown = append(g.trigUnknown, trexist[i] > 0 && len(facts) == 0)
+	}
+	if !useful {
+		allProvable := len(g.trig) > 0
+		for _, u := range g.trigUnknown {
+			if u {
+				allProvable = false
+			}
+		}
+		if !allProvable {
+			return
+		}
+	}
+	b.specGuard = g
+}
+
+type specFacts struct {
+	noPartner            bool // single mode on both sides and no partner slot in use
+	selfName, selfAuthor string
+	enemyKnown           bool // exactly one enemy, 1-vs-1
+	enemyName, enemyAuth string
+}
+
+func (f *specFacts) isFalse(n nameFact) bool {
+	if n.kind == 1 {
+		return f.noPartner
+	}
+	switch n.who {
+	case 0:
+		if n.author {
+			return !specEq(f.selfAuthor, n.val)
+		}
+		return !specEq(f.selfName, n.val)
+	case 1:
+		if !f.enemyKnown {
+			return false
+		}
+		if n.author {
+			return !specEq(f.enemyAuth, n.val)
+		}
+		return !specEq(f.enemyName, n.val)
+	default:
+		// A second enemy does not exist in 1-vs-1: the redirect fails and
+		// the term is false.
+		return f.enemyKnown
+	}
+}
+
+func (f *specFacts) anyFalse(ns []nameFact) bool {
+	for _, n := range ns {
+		if f.isFalse(n) {
+			return true
+		}
+	}
+	return false
+}
+
+func (f *specFacts) guardFalse(g *specGuard) bool {
+	if g == nil {
+		return false
+	}
+	for _, l := range g.all {
+		if f.anyFalse(l) {
+			return true
+		}
+	}
+	if len(g.trig) == 0 {
+		return false
+	}
+	for i, t := range g.trig {
+		if g.trigUnknown[i] {
+			return false
+		}
+		if len(t) > 0 && !f.anyFalse(t) {
+			return false
+		}
+	}
+	return true
+}
+
+// specEq matches the engine's string comparison (case-insensitive, as
+// BytecodeExp.eq does with toLowS).
+func specEq(a, b string) bool { return strings.ToLower(a) == strings.ToLower(b) }
+
+// specBlock builds the reduced controller list of b (and nested blocks).
+func specBlock(b *StateBlock, c *Char, f *specFacts) {
+	if b == nil || b.loopBlock {
+		return
+	}
+	b.runFns()
+	var out []StateController
+	changed := false
+	for _, sc := range b.ctrls {
+		if sb, ok := sc.(*StateBlock); ok {
+			if sb.persistent == 1 && f.guardFalse(sb.specGuard) {
+				changed = true
+				specStats.removed++
+				continue
+			}
+			specBlock(sb, c, f)
+			if sb.elseBlock != nil {
+				specBlock(sb.elseBlock, c, f)
+			}
+		}
+		specStats.kept++
+		out = append(out, sc)
+	}
+	if !changed {
+		b.spec = nil
+		return
+	}
+	s := &specList{owner: c, gen: specGen, ctrls: out}
+	s.runs = make([]scRunFn, len(out))
+	s.isBlock = make([]bool, len(out))
+	for i, sc := range out {
+		s.runs[i] = scRunFunc(sc)
+		_, s.isBlock[i] = sc.(*StateBlock)
+	}
+	b.spec = s
+}
+
+// specChar (re)builds the reduced lists of c's negative states for the
+// current round.
+func specChar(c *Char) {
+	c.specGen = specGen
+	if !specEnabled() || c.helperIndex != 0 {
+		return
+	}
+	gi := c.gi()
+	if gi == nil {
+		return
+	}
+	f := &specFacts{selfName: gi.name, selfAuthor: gi.author}
+	if sys.tmode[0] == TM_Single && sys.tmode[1] == TM_Single {
+		var e *Char
+		n := 0
+		for i := range sys.chars {
+			if len(sys.chars[i]) > 0 && sys.chars[i][0] != nil && c.isEnemyOf(sys.chars[i][0]) {
+				e = sys.chars[i][0]
+				n++
+			}
+		}
+		if n == 1 && e.gi() != nil {
+			f.enemyKnown = true
+			f.enemyName, f.enemyAuth = e.gi().name, e.gi().author
+		}
+		// numPartner() is 0 outside simul/tag, and partner() finds no one
+		// when the partner slot is empty.
+		f.noPartner = c.numPartner() == 0 && c.partner(0, false) == nil
+	}
+	specStats.kept, specStats.removed = 0, 0
+	for no, sb := range gi.states {
+		if no < 0 && sb != nil {
+			specBlock(&sb.block, c, f)
+		}
+	}
+	vitaTrace("spec: p" + itoa(c.playerNo) + " " + gi.name + " vs " + f.enemyName +
+		": removed " + itoa(specStats.removed) + " controllers, kept " + itoa(specStats.kept))
+}
+
+// specRound invalidates all reduced lists (called at round start).
+func specRound() {
+	specGen++
+	if cjitOn == 1 {
+		vitaTrace(cjitStatsLine())
+	}
+}
