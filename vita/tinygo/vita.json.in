{
  "llvm-target": "armv7-unknown-none-eabihf",
  "cpu": "cortex-a9",
  "features": "+armv7-a,+dsp,+fp64,+d32,+neon,+vfp2,+vfp2sp,+vfp3,+vfp3d16,+vfp3d16sp,+vfp3sp,-aes,-fp-armv8,-fp16,-sha2,-thumb-mode,-vfp4",
  "build-tags": [
    "vita",
    "linux",
    "arm"
  ],
  "goos": "linux",
  "goarch": "arm",
  "gc": "conservative",
  "scheduler": "tasks",
  "linker": "ld.lld",
  "rtlib": "",
  "libc": "",
  "default-stack-size": 131072,
  "cflags": [
    "--target=armv7-unknown-none-eabihf",
    "-mcpu=cortex-a9",
    "-mfpu=neon",
    "-mfloat-abi=hard",
    "-isystem",
    "@V@/arm-vita-eabi/include",
    "-D__vita__",
    "-ffunction-sections",
    "-fdata-sections"
  ],
  "ldflags": [
    "-q",
    "--no-gc-sections",
    "--wrap=write",
    "--pic-veneer",
    "-zseparate-loadable-segments",
    "--no-rosegment",
    "-znorelro",
    "--image-base=0x81000000",
    "-zmax-page-size=0x10000",
    "-znognustack",
    "-L@V@/lib/gcc/arm-vita-eabi/15.2.0",
    "-L@V@/arm-vita-eabi/lib",
    "@V@/lib/gcc/arm-vita-eabi/15.2.0/crti.o",
    "@V@/lib/gcc/arm-vita-eabi/15.2.0/crtbegin.o",
    "@V@/arm-vita-eabi/lib/crt0.o",
    "--start-group",
    "-lSceFiber_stub",
    "-lgcc",
    "-lc",
    "-lm",
    "-lpthread",
    "-lSceRtc_stub",
    "-lSceSysmem_stub",
    "-lSceKernelThreadMgr_stub",
    "-lSceKernelModulemgr_stub",
    "-lSceIofilemgr_stub",
    "-lSceProcessmgr_stub",
    "-lSceLibKernel_stub",
    "-lSceNet_stub",
    "-lSceNetCtl_stub",
    "-lSceSysmodule_stub",
    "--end-group",
    "@V@/lib/gcc/arm-vita-eabi/15.2.0/crtend.o",
    "@V@/lib/gcc/arm-vita-eabi/15.2.0/crtn.o"
  ],
  "extra-files": [
    "src/runtime/asm_arm.S",
    "targets/vita_shim.c",
    "targets/vita_fiber.c",
    "targets/vita_fiber.S"
  ]
}