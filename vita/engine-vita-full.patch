+	case io.SeekCurrent:
+		b.pos += offset
+	case io.SeekEnd:
+		end, err := b.f.Seek(offset, io.SeekEnd)
+		if err != nil {
+			return b.pos, err
+		}
+		b.pos = end
+	}
+	if b.pos < 0 {
+		b.pos = 0
+	}
+	return b.pos, nil
