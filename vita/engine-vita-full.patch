diff --git a/src/vita_shaders.go b/src/vita_shaders.go
new file mode 100644
index 0000000..6b48d47
--- /dev/null
+++ b/src/vita_shaders.go
@@ -0,0 +1,191 @@
+//go:build vita
+
+package main
+
+import "strings"
+
+// GLSL 1.x versions of the engine's shaders for vitaGL's GLSL->CG translator
+// (no #version 320 es, no gl_VertexID, attribute/varying, texture2D).
+
+func vitaShaderSources(name string) (vert, frag string, ok bool) {
+	switch name {
+	case "Main Shader":
+		return vitaSpriteVert, vitaSpriteFrag, true
+	case "Main Shader (no clip)":
+		// Fallback if the translator rejects the clipping code.
+		return strings.Replace(vitaSpriteVert, "clippos = gl_Position;", "", 1),
+			strings.Replace(vitaSpriteFrag, vitaClipFrag, "", 1), true
+	case "Identity Postprocess":
+		return vitaIdentVert, vitaIdentFrag, true
+	case "font shader":
+		return vitaFontVert, vitaFontFrag, true
+	}
+	return "", "", false
+}
+
+const vitaSpriteVert = `
+uniform mat4 modelview;
+uniform mat4 projection;
+attribute vec2 position;
+attribute vec2 uv;
+// Atlas rects travel per vertex (constant across a quad) so that sprites with
+// different atlas positions can share one draw call (render_gles32_batch.go).
+attribute vec4 spriteUV;
+attribute vec4 palUV;
+varying vec2 texcoord;
+varying vec4 clippos;
+varying vec4 vSpriteUV;
+varying vec4 vPalUV;
+void main(void) {
+	texcoord = uv;
+	vSpriteUV = spriteUV;
+	vPalUV = palUV;
+	gl_Position = projection * (modelview * vec4(position, 0.0, 1.0));
+	clippos = gl_Position;
+}
+`
+
+const vitaHSV = `
+vec3 ikemenRgbToHsv(vec3 c) {
+	vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
+	vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
+	vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
+	float d = q.x - min(q.w, q.y);
+	float e = 1.0e-10;
+	return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
+}
+vec3 ikemenHsvToRgb(vec3 c) {
+	vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
+	vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
+	return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
+}
+vec3 ikemenHueShift(vec3 color, float dhue) {
+	vec3 hsv = ikemenRgbToHsv(color);
+	hsv.x = mod(hsv.x + dhue, 1.0);
+	return ikemenHsvToRgb(hsv);
+}
+`
+
+const vitaSpriteFrag = `
+uniform sampler2D tex;
+uniform sampler2D pal;
+uniform vec4 tint;
+uniform vec3 add;
+uniform vec3 mult;
+uniform float alpha;
+uniform float gray;
+uniform float hue;
+uniform int mask;
+uniform int isFlat;
+uniform int isRgba;
+uniform int isTrapez;
+uniform int neg;
+varying vec4 vSpriteUV;
+varying vec4 vPalUV;
+uniform int clipOn;
+uniform vec4 clipRect;
+uniform int fxOn;
+varying vec2 texcoord;
+varying vec4 clippos;
+` + vitaHSV + `
+void main(void) {
+` + vitaClipFrag + `	vec4 c;
+	// Fast path: paletted sprite with no colour effects (the common case,
+	// and the GPU is fill-rate bound at 960x540). fxOn is set by the engine
+	// when any of hue/neg/gray/add/mult/tint/mask/isFlat/isRgba is active.
+	if (fxOn == 0) {
+		vec2 atlasUV = clamp(texcoord, vSpriteUV.xy, vSpriteUV.zw - 0.0001);
+		c = texture2D(tex, atlasUV);
+		c = texture2D(pal, vec2(vPalUV.x + vPalUV.z * c.r * 0.9966, vPalUV.y));
+		c.a *= alpha;
+		gl_FragColor = c;
+		return;
+	}
+	vec3 neg_base = vec3(1.0);
+	vec3 final_add = add;
+	vec4 final_mul = vec4(mult, alpha);
+	if (isFlat != 0) {
+		c = tint;
+		neg_base *= c.a;
+		final_add *= c.a;
+		final_mul.rgb *= alpha;
+	} else {
+		vec2 atlasUV = clamp(texcoord, vSpriteUV.xy, vSpriteUV.zw - 0.0001);
+		c = texture2D(tex, atlasUV);
+		if (isRgba != 0) {
+			if (mask == -1) c.a = 1.0;
+			neg_base *= c.a;
+			final_add *= c.a;
+			final_mul.rgb *= alpha;
+		} else {
+			c = texture2D(pal, vec2(vPalUV.x + vPalUV.z * c.r * 0.9966, vPalUV.y));
+			if (mask == -1) c.a = 1.0;
+		}
+	}
+	if (hue != 0.0) c.rgb = ikemenHueShift(c.rgb, hue);
+	if (neg != 0) c.rgb = neg_base - c.rgb;
+	c.rgb = mix(vec3((c.r + c.g + c.b) / 3.0), c.rgb, 1.0 - gray);
+	c.rgb += final_add;
+	c *= final_mul;
+	if (isFlat == 0) c.rgb = mix(c.rgb, tint.rgb * c.a, tint.a);
+	gl_FragColor = c;
+}
+`
+
+const vitaIdentVert = `
+attribute vec2 VertCoord;
+varying vec2 texcoord;
+void main(void) {
+	gl_Position = vec4(VertCoord, 0.0, 1.0);
+	texcoord = (VertCoord + 1.0) / 2.0;
+}
+`
+
+const vitaIdentFrag = `
+uniform sampler2D Texture;
+varying vec2 texcoord;
+void main(void) {
+	gl_FragColor = texture2D(Texture, texcoord);
+}
+`
+
+const vitaFontVert = `
+uniform vec2 resolution;
+attribute vec2 vert;
+attribute vec2 vertTexCoord;
+varying vec2 fragTexCoord;
+void main(void) {
+	fragTexCoord = vertTexCoord;
+	vec2 res = max(resolution, vec2(1.0, 1.0));
+	vec2 clipSpace = (vert / res) * 2.0 - 1.0;
+	gl_Position = vec4(clipSpace * vec2(1.0, -1.0), 0.0, 1.0);
+}
+`
+
+const vitaFontFrag = `
+uniform vec4 textColor;
+uniform vec3 palAdd;
+uniform vec3 palMul;
+uniform float palGray;
+uniform float palHue;
+uniform int palNeg;
+uniform sampler2D tex;
+varying vec2 fragTexCoord;
+` + vitaHSV + `
+void main(void) {
+	vec4 texColor = texture2D(tex, fragTexCoord);
+	vec4 c = min(textColor, vec4(1.0)) * vec4(1.0, 1.0, 1.0, texColor.r);
+	if (palHue != 0.0) c.rgb = ikemenHueShift(c.rgb, palHue);
+	if (palNeg != 0) c.rgb = c.aaa - c.rgb;
+	c.rgb = mix(vec3((c.r + c.g + c.b) / 3.0), c.rgb, 1.0 - palGray);
+	c.rgb += palAdd * c.a;
+	c.rgb *= palMul;
+	gl_FragColor = c;
+}
+`
+
+const vitaClipFrag = `	if (clipOn != 0) {
+		vec2 cp = clippos.xy / clippos.w;
+		if (cp.x < clipRect.x || cp.y < clipRect.y || cp.x > clipRect.z || cp.y > clipRect.w) discard;
+	}
+`
