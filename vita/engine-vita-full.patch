diff --git a/src/jsoncache.go b/src/jsoncache.go
new file mode 100644
index 0000000..24adbf5
--- /dev/null
+++ b/src/jsoncache.go
@@ -0,0 +1,36 @@
+package main
+
+import (
+	"os"
+	"sync"
+)
+
+var jsonFileCache = struct {
+	sync.Mutex
+	m map[string][]byte
+}{m: map[string][]byte{}}
+
+// jsonFileCached returns the contents of a JSON file. On the Vita the bytes are
+// kept in memory until jsonFileCacheReset is called by a writer.
+func jsonFileCached(path string) ([]byte, error) {
+	if !isVita {
+		return os.ReadFile(path)
+	}
+	jsonFileCache.Lock()
+	defer jsonFileCache.Unlock()
+	if d, ok := jsonFileCache.m[path]; ok {
+		return d, nil
+	}
+	d, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	jsonFileCache.m[path] = d
+	return d, nil
+}
+
+func jsonFileCacheReset() {
+	jsonFileCache.Lock()
+	jsonFileCache.m = map[string][]byte{}
+	jsonFileCache.Unlock()
+}
