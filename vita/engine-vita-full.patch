+// vitaBufFile is a read-buffered io.ReadSeekCloser over an *os.File.
+type vitaBufFile struct {
+	f        *os.File
+	buf      []byte // buffered bytes starting at file offset bufStart
+	bufStart int64
+	pos      int64 // logical position
+}
+
+func (b *vitaBufFile) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	if b.pos < b.bufStart || b.pos >= b.bufStart+int64(len(b.buf)) {
+		// Large reads bypass the buffer.
+		if len(p) >= cap(b.buf) {
+			if _, err := b.f.Seek(b.pos, io.SeekStart); err != nil {
+				return 0, err
+			}
+			n, err := b.f.Read(p)
+			b.pos += int64(n)
+			b.buf = b.buf[:0]
+			return n, err
+		}
+		if _, err := b.f.Seek(b.pos, io.SeekStart); err != nil {
+			return 0, err
+		}
+		n, err := b.f.Read(b.buf[:cap(b.buf)])
+		b.buf = b.buf[:n]
+		b.bufStart = b.pos
+		if n == 0 {
+			if err == nil {
+				err = io.EOF
+			}
+			return 0, err
+		}
+	}
+	n := copy(p, b.buf[b.pos-b.bufStart:])
+	b.pos += int64(n)
+	return n, nil
+}
+
+func (b *vitaBufFile) Seek(offset int64, whence int) (int64, error) {
+	switch whence {
+	case io.SeekStart:
+		b.pos = offset
+	case io.SeekCurrent:
+		b.pos += offset
+	case io.SeekEnd:
+		end, err := b.f.Seek(offset, io.SeekEnd)
+		if err != nil {
+			return b.pos, err
+		}
+		b.pos = end
+	}
+	if b.pos < 0 {
+		b.pos = 0
+	}
+	return b.pos, nil
+}
+
+func (b *vitaBufFile) Close() error { return b.f.Close() }
