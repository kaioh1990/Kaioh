+func (be BytecodeExp) pushTrigger(c *Char, t OpCode) {
+	switch t {
+	case OC_stateno:
+		sys.bcStack.PushI(c.ss.no)
+	case OC_prevstateno:
+		sys.bcStack.PushI(c.ss.prevno)
+	case OC_life:
+		sys.bcStack.PushI(c.life)
+	case OC_lifemax:
+		sys.bcStack.PushI(c.lifeMax)
+	case OC_roundstate:
+		sys.bcStack.PushI(sys.roundState())
+	case OC_time:
+		sys.bcStack.PushI(c.ss.time)
+	case OC_alive:
+		sys.bcStack.PushB(c.alive())
+	case OC_ctrl:
+		sys.bcStack.PushB(c.ctrl())
+	case OC_anim:
+		sys.bcStack.PushI(c.animNo)
+	case OC_numpartner:
+		sys.bcStack.PushI(c.numPartner())
+	case OC_numenemy:
+		sys.bcStack.PushI(c.numEnemy())
+	case OC_gametime:
+		sys.bcStack.PushI(sys.gameTime())
+	case OC_power:
+		sys.bcStack.PushI(c.getPower())
+	case OC_facing:
+		sys.bcStack.PushI(int32(c.facing))
+	case OC_hitpausetime:
+		sys.bcStack.PushI(c.hitPauseTime)
+	case OC_movecontact:
+		sys.bcStack.PushI(c.moveContact())
+	case OC_movehit:
+		sys.bcStack.PushI(c.moveHit())
+	case OC_teamside:
+		sys.bcStack.PushI(int32(c.teamside) + 1)
+	case OC_id:
+		sys.bcStack.PushI(c.id)
+	default:
+		c.panic("fused trigger: unsupported opcode")
+	}
+}
+
+// cmpConst applies a comparison opcode between the stack top and a constant.
+func (be BytecodeExp) cmpConst(cmp OpCode, k BytecodeValue) {
+	switch cmp {
+	case OC_eq:
+		be.eq(sys.bcStack.Top(), k)
+	case OC_ne:
+		be.ne(sys.bcStack.Top(), k)
+	case OC_lt:
+		be.lt(sys.bcStack.Top(), k)
+	case OC_gt:
+		be.gt(sys.bcStack.Top(), k)
+	case OC_le:
+		be.le(sys.bcStack.Top(), k)
+	default:
+		be.ge(sys.bcStack.Top(), k)
+	}
