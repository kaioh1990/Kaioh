+// PS Vita platform glue: vitaGL display instead of an SDL window, game data
+// in ux0:data/CvF, CPU at 444 MHz.
+
+/*
+#include <stdlib.h>
+#include <psp2/power.h>
+#include <unistd.h>
+#include <string.h>
+#include <psp2/io/fcntl.h>
+
+// Engine log: ux0:data/cvftest.log (stdout/stderr also land here, see the
+// TinyGo Vita shim). Cleared at every start.
+// One descriptor for the whole run (shared with the shim's stdout/stderr):
+// reopening the file for every line cost a memory-card open per log line.
+int vita_log_fd(void);
+void vlog(const char *s) {
+	SceUID fd = vita_log_fd();
+	if (fd < 0) return;
+	sceIoWrite(fd, s, strlen(s));
+	sceIoWrite(fd, "\n", 1);
+}
+static void vita_crash_install(void);
+__attribute__((constructor)) static void vlog_start(void) {
+	sceIoRemove("ux0:data/cvftest.log");
+	vlog("CvF Online for PS Vita - engine log");
+	vita_crash_install();
+}
+
+// Crash reporter: if kubridge is installed, write registers and a backtrace
+// (link-time addresses) to the log on a data/prefetch abort. Weak import, so
+// the game still starts without kubridge.
+#include <stdio.h>
+#include <kubridge.h>
+#include <psp2/kernel/processmgr.h>
+extern char __exidx_start[];
+#define CVF_LINK_EXIDX 0x810000b4u
+static void crash_line(const char *fmt, unsigned a, unsigned b, unsigned c, unsigned d) {
+	char buf[96]; snprintf(buf, sizeof buf, fmt, a, b, c, d); vlog(buf);
+}
+static void crash_dump(unsigned type, unsigned *r, unsigned sp, unsigned lr, unsigned pc, unsigned far, unsigned fsr) {
+	unsigned base = (unsigned)__exidx_start - (CVF_LINK_EXIDX - 0x81000000u);
+	unsigned lim = base + 0x6a0000u;
+#define L(x) (((x) >= base && (x) < lim) ? (x) - base + 0x81000000u : (x))
+	vlog("=== CRASH ===");
+	crash_line("type %u pc %08x lr %08x far %08x", type, L(pc), L(lr), far);
+	crash_line("fsr %08x sp %08x base %08x", fsr, sp, base, 0);
+	for (int i = 0; i < 12; i += 4) crash_line("r%u-: %08x %08x %08x", i, L(r[i]), L(r[i+1]), L(r[i+2]));
+	crash_line("r3 %08x r7 %08x r11 %08x r12 %08x", L(r[3]), L(r[7]), L(r[11]), L(r[12]));
+	unsigned *s = (unsigned *)(sp & ~3u); unsigned found[32]; int n = 0;
+	for (int i = 0; i < 4096 && n < 32; i++) {
+		unsigned v = s[i];
+		if (v >= base + 0x14b000u && v < lim) found[n++] = v - base + 0x81000000u;
+	}
+	for (int i = 0; i < n; i += 4) crash_line("bt %08x %08x %08x %08x", found[i], i+1<n?found[i+1]:0, i+2<n?found[i+2]:0, i+3<n?found[i+3]:0);
+	vlog("=== END ===");
+	sceKernelExitProcess(0);
+}
+static void crash_new(KuKernelExceptionContext *c) { crash_dump(c->exceptionType, &c->r0, c->sp, c->lr, c->pc, c->FAR, c->FSR); }
+static void crash_old(KuKernelAbortContext *c) { crash_dump(c->abortType, &c->r0, c->sp, c->lr, c->pc, c->FAR, c->FSR); }
+// An unresolved weak import stub is "movw r12,#0; movt r12,#0; bx r12";
+// calling it jumps to address 0, so check before calling.
+static int stub_resolved(void *fn) {
+	unsigned *w = (unsigned *)((unsigned)fn & ~1u);
+	if ((w[0] & 0xFFF0F000u) != 0xE300C000u || (w[1] & 0xFFF0F000u) != 0xE340C000u) return 0;
+	unsigned lo = ((w[0] >> 4) & 0xF000u) | (w[0] & 0xFFFu);
+	unsigned hi = ((w[1] >> 4) & 0xF000u) | (w[1] & 0xFFFu);
+	return ((hi << 16) | lo) != 0;
+}
+static void vita_crash_install(void) {
+	KuKernelExceptionHandler old1; KuKernelAbortHandler old2;
+	if (!stub_resolved((void *)kuKernelRegisterExceptionHandler)) {
+		vlog("crash handler: kubridge not installed");
+		return;
+	}
+	int a = kuKernelRegisterExceptionHandler(KU_KERNEL_EXCEPTION_TYPE_DATA_ABORT, crash_new, &old1, NULL);
+	int b = kuKernelRegisterExceptionHandler(KU_KERNEL_EXCEPTION_TYPE_PREFETCH_ABORT, crash_new, &old1, NULL);
+	int u = kuKernelRegisterExceptionHandler(KU_KERNEL_EXCEPTION_TYPE_UNDEFINED_INSTRUCTION, crash_new, &old1, NULL);
+	if (a < 0) a = kuKernelRegisterAbortHandler(crash_old, &old2, NULL);
+	char buf[96]; snprintf(buf, sizeof buf, "crash handler: %08x %08x %08x", a, b, u); vlog(buf);
+}
+extern void _init(void);
+static unsigned crc_tab[256];
+static void vita_crc_log(const char *tag) {
+	if (!crc_tab[1]) for (unsigned i = 0; i < 256; i++) { unsigned c = i; for (int k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320u ^ (c >> 1) : c >> 1; crc_tab[i] = c; }
+	unsigned base = (unsigned)__exidx_start - (CVF_LINK_EXIDX - 0x81000000u);
+	unsigned len = ((unsigned)_init & ~1u) - base;
+	const unsigned char *p = (const unsigned char *)base; unsigned c = 0xFFFFFFFFu;
+	for (unsigned i = 0; i < len; i++) c = crc_tab[(c ^ p[i]) & 0xFF] ^ (c >> 8);
+	char buf[96]; snprintf(buf, sizeof buf, "crc %s base %08x len %08x crc %08x", tag, base, len, ~c); vlog(buf);
+}
+// Image verifier: re-applies the module's relocations from app0:ikvita.velf
+// to a copy of the code segment and compares it with what the loader put in
+// memory. Logs the first differences (offsets are relative to the segment).
+static void vita_verify_image(void) {
+	unsigned base0 = (unsigned)__exidx_start - (CVF_LINK_EXIDX - 0x81000000u);
+	unsigned len = ((unsigned)_init & ~1u) - base0;
+	SceUID fd = sceIoOpen("app0:ikvita.velf", SCE_O_RDONLY, 0);
+	if (fd < 0) { vlog("verify: no app0:ikvita.velf"); return; }
+	unsigned char eh[52];
+	sceIoRead(fd, eh, 52);
+	unsigned phoff = *(unsigned *)(eh + 28); unsigned short phnum = *(unsigned short *)(eh + 44);
+	unsigned ph[8][8]; if (phnum > 8) phnum = 8;
+	sceIoLseek(fd, phoff, SCE_SEEK_SET); sceIoRead(fd, ph, 32 * phnum);
+	int i0 = -1, ir = -1, n = 0;
+	for (int i = 0; i < phnum; i++) { if (ph[i][0] == 1) { if (n++ == 0) i0 = i; } if (ph[i][0] == 0x60000000) ir = i; }
+	if (i0 < 0 || ir < 0) { vlog("verify: bad velf"); sceIoClose(fd); return; }
+	unsigned char *img = malloc(ph[i0][4]); unsigned char *rel = malloc(ph[ir][4]);
+	if (!img || !rel) { vlog("verify: no memory"); sceIoClose(fd); free(img); free(rel); return; }
+	sceIoLseek(fd, ph[i0][1], SCE_SEEK_SET); sceIoRead(fd, img, ph[i0][4]);
+	sceIoLseek(fd, ph[ir][1], SCE_SEEK_SET); sceIoRead(fd, rel, ph[ir][4]);
+	sceIoClose(fd);
+	// seg1 base: find a reloc into seg 0 data that targets seg 1 and read it back.
+	unsigned base1 = 0; int nrel = 0, napplied = 0;
+	for (int pass = 0; pass < 2; pass++) {
+		unsigned char *r = rel, *end = rel + ph[ir][4];
+		while (r < end) {
+			unsigned w0 = *(unsigned *)r, a, o;
+			unsigned symseg = (w0 >> 4) & 15, code = (w0 >> 8) & 255, datseg = (w0 >> 16) & 15;
+			if (w0 & 15) { unsigned w1 = *(unsigned *)(r + 4); o = (w0 >> 20) | ((w1 & 0x3FF) << 12); a = w1 >> 10; r += 8; }
+			else { a = *(unsigned *)(r + 4); o = *(unsigned *)(r + 8); r += 12; }
+			if (pass == 0) { nrel++;
+				if (!base1 && datseg == 0 && symseg == 1 && code == 2 && o < len) base1 = *(unsigned *)(base0 + o) - a;
+				continue; }
+			if (datseg != 0 || o + 4 > ph[i0][4]) continue;
+			unsigned S = symseg == 0 ? base0 : base1, T = S + a;
+			unsigned char *P = img + o;
+			if (code == 2 || code == 38) { *(unsigned *)P = T; napplied++; }
+			else if (code == 43 || code == 44) { unsigned ins = *(unsigned *)P, v = code == 43 ? (T & 0xFFFF) : (T >> 16);
+				*(unsigned *)P = (ins & 0xFFF0F000u) | ((v & 0xF000) << 4) | (v & 0xFFF); napplied++; }
+			else if (code == 47 || code == 48) { unsigned short h1 = *(unsigned short *)P, h2 = *(unsigned short *)(P + 2);
+				unsigned v = code == 47 ? (T & 0xFFFF) : (T >> 16);
+				h1 = (h1 & 0xFBF0) | ((v >> 12) & 0xF) | (((v >> 11) & 1) << 10);
+				h2 = (h2 & 0x8F00) | (((v >> 8) & 7) << 12) | (v & 0xFF);
+				*(unsigned short *)P = h1; *(unsigned short *)(P + 2) = h2; napplied++; }
+		}
+	}
+	char buf[120];
+	snprintf(buf, sizeof buf, "verify: base0 %08x base1 %08x relocs %d applied %d", base0, base1, nrel, napplied); vlog(buf);
+	int diffs = 0;
+	for (unsigned o = 0; o + 4 <= len; o += 4) {
+		unsigned m = *(unsigned *)(base0 + o), e = *(unsigned *)(img + o);
+		if (m != e) {
+			if (diffs < 24) { snprintf(buf, sizeof buf, "verify: off %06x mem %08x exp %08x", o, m, e); vlog(buf); }
+			diffs++;
+		}
+	}
+	snprintf(buf, sizeof buf, "verify: %d differing words", diffs); vlog(buf);
+	free(img); free(rel);
+}
+int vglInitExtended(int legacy_pool_size, int width, int height, int ram_threshold, int msaa);
+void vglSwapBuffers(unsigned char has_commondialog);
+void *vglGetProcAddress(const char *name);
+// vitaGL lacks many GLES3 entry points; a NULL function pointer would crash
+// when called, so those become no-ops returning 0.
+static unsigned long long vita_gl_missing(void) { return 0; }
+static void *vita_gl_proc(const char *name) {
+	void *p = vglGetProcAddress(name);
+	return p ? p : (void *)vita_gl_missing;
+}
+
+static void vita_libc_chdir(const char *p) { chdir(p); }
+static int vita_arm_clock;
+static void vita_clock(void) {
+	// 500 MHz is accepted when an overclock plugin (PSVshell, ...) unlocks
+	// it; the stock kernel rejects it and keeps the previous setting.
+	if (scePowerSetArmClockFrequency(500) < 0) scePowerSetArmClockFrequency(444);
+	scePowerSetBusClockFrequency(222);
+	scePowerSetGpuClockFrequency(222);
+	scePowerSetGpuXbarClockFrequency(166);
+	vita_arm_clock = scePowerGetArmClockFrequency();
+}
+static int vita_get_arm_clock(void) { return vita_arm_clock; }
+// vitaNowUs: process time in microseconds (cheap, for the timing profiler).
+static unsigned int vita_now_us(void) { return (unsigned int)sceKernelGetProcessTimeLow(); }
+*/
+import "C"
+
+import (
+	"os"
+	"runtime"
+	"time"
+	"unsafe"
+)
+
+const isVita = true
+
+const (
+	vitaScreenW = 960
+	vitaScreenH = 544
+	vitaDataDir = "ux0:data/CvF"
+)
+
+// vitaPlatformInit runs at the very start of realMain.
+func vitaPlatformInit() {
+	C.vita_clock()
+	vitaTrace("cpu: arm clock " + itoa(int(C.vita_get_arm_clock())) + " MHz")
+	// Image verifier (found the loader's JUMP24 rewrite) is off for release:
+	// it read and relocated the 50 MB velf on every boot.
+	if _, err := os.Stat("app0:ikvita.velf"); err == nil {
+		vitaCRC("start")
+		C.vita_verify_image()
+	}
+	cd := C.CString(vitaDataDir)
+	C.vita_libc_chdir(cd) // for C libraries (libxmp, SDL) that open files themselves
+	C.free(unsafe.Pointer(cd))
+	if err := os.Chdir(vitaDataDir); err != nil {
+		Logcat("vita: chdir " + vitaDataDir + " failed: " + err.Error())
+	}
+}
+
+var vitaGLStarted bool
+
+func vitaGLInit() {
+	if vitaGLStarted {
+		return
+	}
+	// 16 MB threshold keeps some main RAM free for the rest of the engine.
+	r := C.vglInitExtended(0, vitaScreenW, vitaScreenH, 16*1024*1024, 0)
+	Logcat("vita: vglInitExtended -> " + itoa(int(r)))
+	vitaGLStarted = true
+}
+
+func vitaGLSwap() {
+	t := time.Now()
+	C.vglSwapBuffers(0)
+	d := time.Since(t)
+	vitaPerf.swap += d
+	vitaPerf.swaps++
+	vitaPerf.totalSwap += d
+	vitaPerf.totalSwaps++
+}
+
+func vitaGetProcAddress(name string) unsafe.Pointer {
+	n := C.CString(name)
+	defer C.free(unsafe.Pointer(n))
+	return C.vita_gl_proc(n)
+}
+
+func itoa(i int) string {
+	neg := i < 0
+	if neg {
+		i = -i
+	}
+	b := []byte{}
+	for {
+		b = append([]byte{byte('0' + i%10)}, b...)
+		i /= 10
+		if i == 0 {
+			break
+		}
+	}
+	if neg {
+		b = append([]byte{'-'}, b...)
+	}
+	return string(b)
+}
+
+func fmtHex(v uint32) string {
+	const d = "0123456789abcdef"
+	b := make([]byte, 8)
+	for i := 7; i >= 0; i-- {
+		b[i] = d[v&15]
+		v >>= 4
+	}
+	return string(b)
+}
+
+func init() { vitaTrace("main: package init reached") }
+
+var vitaStartTime = time.Now()
+
+func vitaTrace(s string) {
+	// Timestamp (seconds since launch) so the log shows how long loading takes.
+	ms := int(time.Since(vitaStartTime) / time.Millisecond)
+	s = "[" + itoa(ms/1000) + "." + itoa(ms%1000/100) + "s] " + s
+	cs := C.CString(s)
+	C.vlog(cs)
+	C.free(unsafe.Pointer(cs))
+}
+
+func vitaCRC(tag string) {
+	cs := C.CString(tag)
+	C.vita_crc_log(cs)
+	C.free(unsafe.Pointer(cs))
+}
+
+var vitaMemLast time.Time
+
+func vitaMem(tag string) {
+	// Collect at load checkpoints: TinyGo's heap otherwise fragments until a
+	// large allocation fails even though most of the heap is garbage.
+	// Rate-limited: a full collection plus ReadMemStats (which walks the whole
+	// heap) at every file load added seconds to boot and fight loading.
+	// The runtime now uses the whole committed heap from the start, so
+	// fragmentation is no longer a risk; collecting here only cost time.
+	if !vitaTraceOn || time.Since(vitaMemLast) < 3*time.Second {
+		return
+	}
+	runtime.GC()
+	vitaMemLast = time.Now()
+	var m runtime.MemStats
+	runtime.ReadMemStats(&m)
+	vitaTrace("mem " + tag + ": inuse " + itoa(int(m.HeapInuse>>20)) + " MB, sys " + itoa(int(m.HeapSys>>20)) + " MB, gc " + itoa(int(m.NumGC)))
+}
+
+var vitaMemGCFlag = -1
+
+// vitaMemGC: diagnostics only; create save/vita_memgc to force a GC before each memory report.
+func vitaMemGC() bool {
+	if vitaMemGCFlag < 0 {
+		vitaMemGCFlag = 0
+		if _, err := os.Stat("save/vita_memgc"); err == nil {
+			vitaMemGCFlag = 1
+		}
+	}
+	return vitaMemGCFlag == 1
+}
+
+// vitaTraceOn enables the detailed startup trace until the main config is normalized.
+var vitaTraceOn = false
+var vitaTraceDeep = false
+
+// Frame-time report written to the log every 300 frames (about 5 s at 60 fps).
+var vitaPerf struct {
+	last    time.Time
+	n, skip int
+	sum     time.Duration
+	max     time.Duration
+	swap    time.Duration // time blocked in vglSwapBuffers (waiting on the GPU / vsync)
+	swaps   int
+
+	totalSwap  time.Duration
+	totalSwaps int
+
+	// CPU time in game logic (action+uiAction) and in cueDraw+renderFrame
+	// (the latter is near zero on frames whose drawing is skipped).
+	t0    time.Time
+	part  [2]time.Duration
+	partN [2]int
+}
+
+func vitaPerfBegin() { vitaPerf.t0 = time.Now() }
+func vitaPerfEnd(i int) {
+	vitaPerf.part[i] += time.Since(vitaPerf.t0)
+	vitaPerf.partN[i]++
+}
+
+var vitaPerfAlloc uint64
+
+func vitaPerfTick(skipped bool) {
+	now := time.Now()
+	if !vitaPerf.last.IsZero() {
+		d := now.Sub(vitaPerf.last)
+		vitaPerf.sum += d
+		if d > vitaPerf.max {
+			vitaPerf.max = d
+		}
+		vitaPerf.n++
+		if skipped {
+			vitaPerf.skip++
+		}
+	}
+	vitaPerf.last = now
+	if vitaPerf.n >= 300 {
+		avg := vitaPerf.sum / time.Duration(vitaPerf.n)
+		vitaTrace("perf: " + itoa(vitaPerf.n) + " frames, avg " + itoa(int(avg/time.Microsecond)) + " us (" +
+			itoa(int(time.Second/avg)) + " fps), max " + itoa(int(vitaPerf.max/time.Millisecond)) + " ms, draws skipped " +
+			itoa(vitaPerf.skip) + ", GPU wait " + itoa(int(vitaPerf.swap/time.Millisecond)) + " ms in " + itoa(vitaPerf.swaps) + " swaps, alloc " +
+			itoa(int((runtime.VitaTotalAlloc()-vitaPerfAlloc)>>10)) + " KB, logic " +
+			itoa(int(vitaPerf.part[0]/time.Microsecond)/max(1, vitaPerf.partN[0])) + " us/tick, draw " +
+			itoa(int(vitaPerf.part[1]/time.Microsecond)/max(1, vitaPerf.n-vitaPerf.skip)) + " us/drawn frame; us/tick:" +
+			vitaPhaseReport(vitaPerf.partN[0]) + vitaBatchReport())
+		vitaPerf.part, vitaPerf.partN = [2]time.Duration{}, [2]int{}
+		vitaPerfAlloc = runtime.VitaTotalAlloc()
+		vitaPerf.n, vitaPerf.skip, vitaPerf.sum, vitaPerf.max, vitaPerf.swap, vitaPerf.swaps = 0, 0, 0, 0, 0, 0
+	}
+}
+
+// Render diagnostics: during the first match, cycle through modes that skip
+// parts of the fight's drawing, 8 seconds each, and log how fast each runs.
+// 0 = everything, 1 = no stage, 2 = no characters/effects, 3 = no lifebars,
+// 4 = none of the above. After one cycle it stays on mode 0.
+var vitaDiag struct {
+	mode, frames int
+	start        time.Time
+	swapAt       time.Duration
+	swapsAt      int
+	done         bool
+	inFight      bool
+	probes       int
+	cycle        bool
+}
+
+var vitaDiagNames = [...]string{"everything", "no stage", "no characters/effects", "no lifebars", "nothing (clear only)"}
+
+func vitaDiagFrame() {
+	vitaDiag.inFight = true
+	vitaExplodLog()
+	if vitaDiag.done {
+		return
+	}
+	now := time.Now()
+	if vitaDiag.start.IsZero() {
+		// Mode cycling is opt-in: create ux0:data/CvF/vita_diag.txt to enable it.
+		if _, err := os.Stat("vita_diag.txt"); err != nil {
+			vitaDiag.cycle = false
+		} else {
+			vitaDiag.cycle = true
+		}
+		vitaDiag.start, vitaDiag.swapAt, vitaDiag.swapsAt = now, vitaPerf.totalSwap, vitaPerf.totalSwaps
+		vitaTrace("diag: fight drawing started, mode 0 (" + vitaDiagNames[0] + ")")
+	}
+	vitaDiag.frames++
+	if el := now.Sub(vitaDiag.start); el >= 8*time.Second {
+		ms := int(el / time.Millisecond)
+		gw := int((vitaPerf.totalSwap - vitaDiag.swapAt) / time.Millisecond)
+		sw := vitaPerf.totalSwaps - vitaDiag.swapsAt
+		fps10 := 0
+		if ms > 0 {
+			fps10 = vitaDiag.frames * 10000 / ms
+		}
+		vitaTrace("diag: mode " + itoa(vitaDiag.mode) + " (" + vitaDiagNames[vitaDiag.mode] + "): " + itoa(vitaDiag.frames) +
+			" fight draws in " + itoa(ms) + " ms (" + itoa(fps10/10) + "." + itoa(fps10%10) + " per s), " + itoa(sw) + " swaps, GPU wait " + itoa(gw) + " ms")
+		vitaDiag.mode++
+		if !vitaDiag.cycle || vitaDiag.mode >= len(vitaDiagNames) {
+			vitaDiag.mode, vitaDiag.done = 0, true
+			vitaTrace("diag: done, drawing everything")
+			return
+		}
+		vitaDiag.start, vitaDiag.frames, vitaDiag.swapAt, vitaDiag.swapsAt = now, 0, vitaPerf.totalSwap, vitaPerf.totalSwaps
+		vitaTrace("diag: mode " + itoa(vitaDiag.mode) + " (" + vitaDiagNames[vitaDiag.mode] + ")")
+	}
+}
+
+func vitaDiagSkip(part int) bool {
+	m := vitaDiag.mode
+	return m == part || m == 4
+}
+
+var vitaProbeLast time.Time
+
+// vitaDiagProbeDue reports whether to sample pixels this frame: once per
+// second while fight drawing is active (vitaDiagFrame ran this frame).
+func vitaDiagProbeDue() bool {
+	if !vitaDiag.inFight {
+		return false
+	}
+	vitaDiag.inFight = false
+	if time.Since(vitaProbeLast) < time.Second || vitaDiag.probes >= 40 {
+		return false
+	}
+	vitaProbeLast = time.Now()
+	vitaDiag.probes++
+	return true
+}
+
+var vitaCensusDone int
+
+// vitaDrawCensusDue is true for the sprite-list passes of one frame, two
+// seconds into the first fight.
+func vitaDrawCensusDue() bool {
+	if vitaCensusDone >= 6 || vitaDiag.mode != 0 || vitaDiag.done || vitaDiag.start.IsZero() || time.Since(vitaDiag.start) < 2*time.Second {
+		return false
+	}
+	vitaCensusDone++
+	return true
+}
+
+// vitaDrawCensus logs what the sprite list contains (diagnostics: fights draw
+// ~400 sprites per frame).
+func vitaDrawCensus(dl DrawList, sortList []int, layerno int32) {
+	type key struct {
+		g, n   uint16
+		trans  TransType
+		sa, da int16
+		blank  bool
+		w, h   uint16
+	}
+	cnt := map[key]int{}
+	for _, idx := range sortList {
+		s := dl[idx]
+		k := key{blank: s.isBlank()}
+		if s.anim != nil && s.anim.spr != nil {
+			k.g, k.n = s.anim.spr.Group, s.anim.spr.Number
+			k.w, k.h = s.anim.spr.Size[0], s.anim.spr.Size[1]
+			k.trans, k.sa, k.da = s.anim.curtrans, int16(s.anim.interpolate_blend_srcalpha), int16(s.anim.interpolate_blend_dstalpha)
+		}
+		cnt[k]++
+	}
+	vitaTrace("census layer " + itoa(int(layerno)) + ": " + itoa(len(sortList)) + " sprites, " + itoa(len(cnt)) + " kinds")
+	for i := 0; i < 15 && len(cnt) > 0; i++ {
+		var best key
+		bn := -1
+		for k, v := range cnt {
+			if v > bn {
+				best, bn = k, v
+			}
+		}
+		delete(cnt, best)
+		vitaTrace("  " + itoa(bn) + "x spr " + itoa(int(best.g)) + "," + itoa(int(best.n)) + " size " + itoa(int(best.w)) + "x" + itoa(int(best.h)) +
+			" trans " + itoa(int(best.trans)) + " alpha " + itoa(int(best.sa)) + "/" + itoa(int(best.da)) + " blank " + itoa(int(Btoi(best.blank))))
+	}
+}
+
+var vitaExplodLogLast time.Time
+
+// vitaExplodLog: diagnostics for explods piling up during fights.
+func vitaExplodLog() {
+	if time.Since(vitaExplodLogLast) < time.Second || vitaDiag.probes >= 40 {
+		return
+	}
+	vitaExplodLogLast = time.Now()
+	out := "explods:"
+	for i := range sys.explods {
+		if len(sys.explods[i]) == 0 {
+			continue
+		}
+		out += " p" + itoa(i) + "=" + itoa(len(sys.explods[i]))
+	}
+	out += " tick " + itoa(sys.tickCount) + " old " + itoa(sys.oldTickCount) + " tf " + itoa(int(Btoi(sys.tickFrame()))) + " tnf " + itoa(int(Btoi(sys.tickNextFrame()))) + " paused " + itoa(int(Btoi(sys.paused))) + " super " + itoa(int(sys.supertime)) + " pause " + itoa(int(sys.pausetime))
+	n := 0
+	for i := range sys.explods {
+		for _, e := range sys.explods[i] {
+			if n >= 3 {
+				break
+			}
+			n++
+			out += " [id " + itoa(int(e.id)) + " t " + itoa(int(e.time)) + " rt " + itoa(int(e.removetime)) + " pause " + itoa(int(Btoi(e.pauseBool))) +
+				" smt " + itoa(int(e.supermovetime)) + " pmt " + itoa(int(e.pausemovetime)) + " ihp " + itoa(int(Btoi(e.ignorehitpause)))
+			if p := e.parent(); p != nil {
+				out += " pact " + itoa(int(p.acttmp))
+			} else {
+				out += " noparent"
+			}
+			out += "]"
+		}
+	}
+	vitaTrace(out)
+}
+
+var vitaClientArraysFlag = -1
+
+// vitaClientArrays: sprite vertices go through client-side arrays unless
+// ux0:data/CvF/vita_vbo.txt exists (fallback to the old glBufferData path).
+func vitaClientArrays() bool {
+	if vitaClientArraysFlag < 0 {
+		vitaClientArraysFlag = 1
+		if _, err := os.Stat("vita_vbo.txt"); err == nil {
+			vitaClientArraysFlag = 0
+		}
+		vitaTrace("render: client vertex arrays " + itoa(vitaClientArraysFlag))
+	}
+	return vitaClientArraysFlag == 1
+}
+
+// vitaGCTrigger sets how many bytes may be allocated between collections.
+// Fights use a large budget so collections fall between rounds instead of
+// stalling the game every few seconds.
+func vitaGCTrigger(n uintptr) { runtime.VitaSetGCTrigger(n) }
+
+var vitaRoundGCAt uint64
+
+// vitaRoundGC collects at a round transition (screen is fading) when enough
+// has been allocated since the last one.
+func vitaRoundGC() {
+	if t := runtime.VitaTotalAlloc(); t-vitaRoundGCAt > 24<<20 {
+		runtime.GC()
+		vitaRoundGCAt = runtime.VitaTotalAlloc()
+	}
+}
+
+func vitaNowUs() uint32 { return uint32(C.vita_now_us()) }
+
+// vitaFBOForced keeps the offscreen scene pass (ux0:data/CvF/vita_fbo.txt), for
+// comparison if direct rendering misbehaves.
+var vitaFBOForced bool
+var vitaFBOFlagChecked bool
+
+func vitaFBOCheck() {
+	if !vitaFBOFlagChecked {
+		vitaFBOFlagChecked = true
+		if _, err := os.Stat("vita_fbo.txt"); err == nil {
+			vitaFBOForced = true
+		}
+		vitaTrace("render: direct to display " + itoa(int(Btoi(!vitaFBOForced))))
+	}
+}
+
+// Phase timers: time between consecutive vitaPhase calls is charged to the
+// phase named by the earlier call. Summed per perf window.
+const (
+	phIdle = iota
+	phOther
+	phStage
+	phCharPrepare
+	phCharRun
+	phCharFinish
+	phCharUpdate
+	phFightScreen
+	phCollision
+	phExplod
+	phUI
+	phCueDraw
+	phRender
+	phCount
+)
+
+var vitaPhaseNames = [phCount]string{"idle", "other", "stage", "cprep", "crun", "cfin", "cupd", "fscr", "coll", "expl", "ui", "cue", "rend"}
+var vitaPhaseUs [phCount]uint32
+var vitaPhaseCur = phIdle
+var vitaPhaseT0 uint32
+
+func vitaPhase(ph int) {
+	now := vitaNowUs()
+	vitaPhaseUs[vitaPhaseCur] += now - vitaPhaseT0
+	vitaPhaseT0 = now
+	vitaPhaseCur = ph
+}
+
+func vitaPhaseReport(ticks int) string {
+	if ticks < 1 {
+		ticks = 1
+	}
+	out := ""
+	for i := phOther; i < phCount; i++ {
+		out += " " + vitaPhaseNames[i] + " " + itoa(int(vitaPhaseUs[i])/ticks)
+		vitaPhaseUs[i] = 0
+	}
+	vitaPhaseUs[phIdle] = 0
+	return out
+}
+
+var vitaHalfTick int
+var vitaHalfFlag = -1
+
+// vitaHalfRate: draw every other tick during matches. Off with
+// ux0:data/CvF/vita_60.txt (the old catch-up behaviour).
+func vitaHalfRate() bool {
+	if vitaHalfFlag < 0 {
+		vitaHalfFlag = 1
+		if _, err := os.Stat("vita_60.txt"); err == nil {
+			vitaHalfFlag = 0
+		}
+		vitaTrace("render: half rate in fights " + itoa(vitaHalfFlag))
+	}
+	return vitaHalfFlag == 1 && sys.gameRunning && !sys.motif.me.active && sys.rollback.session == nil
+}
+
+// vitaBatchReport: sprite draw batching counters since the last perf line.
+func vitaBatchReport() string {
+	r, ok := gfx.(*Renderer_GLES32)
+	if !ok {
+		return ""
+	}
+	f, q := r.vitaBatchStats()
+	return "; batch " + itoa(q) + " quads in " + itoa(f) + " draws"
+}
