+-- CvF Online: Yes/No confirmation (defaults to No)
+function main.f_cvfConfirm(question)
+	local yes = false
+	local frame = 0
+	local ts = motif.title_info.connecting.TextSpriteData
+	resetKey()
+	while true do
+		frame = frame + 1
+		if frame > 10 then
+			if esc() or getInput(-1, motif[main.group].menu.cancel.key) then
+				sndPlay(motif.Snd, motif[main.group].cancel.snd[1], motif[main.group].cancel.snd[2])
+				yes = false
+				break
+			elseif getInput(-1, motif[main.group].menu.next.key) or getInput(-1, motif[main.group].menu.previous.key) then
+				yes = not yes
+				sndPlay(motif.Snd, motif[main.group].cursor.move.snd[1], motif[main.group].cursor.move.snd[2])
+			elseif getInput(-1, motif[main.group].menu.done.key) then
+				sndPlay(motif.Snd, motif[main.group].cursor.done.snd.default[1], motif[main.group].cursor.done.snd.default[2])
+				break
+			end
+		end
+		clearColor(motif[main.background].bgclearcolor[1], motif[main.background].bgclearcolor[2], motif[main.background].bgclearcolor[3])
+		bgDraw(motif[main.background].BGDef, 0)
+		rectDraw(motif.title_info.connecting.overlay.RectData)
+		textImgReset(ts)
+		textImgSetPos(ts, nil, 100)
+		textImgSetText(ts, question .. '\n\n' .. (yes and '> YES <      NO  ' or '  YES      > NO <'))
+		textImgDraw(ts)
+		bgDraw(motif[main.background].BGDef, 1)
+		refresh()
+	end
+	resetKey()
+	return yes
+end
+
+-- CvF Online: during netplay, "any player" menu input only listens to the host (player 1),
+-- so only the host drives the shared menus and stage select.
+do
+	local rawGetInput, rawGetInputTime = getInput, getInputTime
+	getInput = function(p, ...)
+		if p == -1 and netPlay() then
+			p = 1
+		end
+		return rawGetInput(p, ...)
+	end
+	getInputTime = function(p, ...)
+		if p == -1 and netPlay() then
+			p = 1
+		end
+		return rawGetInputTime(p, ...)
+	end
+end
