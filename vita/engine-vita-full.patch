+
+// vitaMotifFixes patches the CvF screenpack: its select-screen portraits are
+// sheets holding both the P1 and the mirrored P2 face side by side, which
+// showed a duplicated, mirrored head-shot at 960x540. Clip each side's face
+// to its half of the screen, as the screenpack intends.
+//
+// Its stage font (st10.fnt) is a picture font: every glyph is a whole stage
+// banner and the advance is zero, so the default "Stage %i: %s" text drew
+// the banners for S, t, a, g, e and the stage letter on top of each other.
+// Print only the stage's letter, and '*' (the "Random" banner) for random.
+func vitaMotifFixes(t string) string {
+	if strings.Contains(t, "font/st10.fnt") && !strings.Contains(t, "stage.active.text") {
+		for _, k := range []string{"stage.active", "stage.active2", "stage.done"} {
+			t = strings.Replace(t, "\n"+k+".font=4,0,1\n", "\n"+k+".font=4,0,1\n"+k+".text=%s\n", 1)
+		}
+		t = strings.Replace(t, "\nstage.done.text=%s\n", "\nstage.done.text=%s\nstage.random.text=*\n", 1)
+	}
+	if strings.Contains(t, "p1.face.window") || !strings.Contains(t, "\np2.face.offset=320,16\n") {
+		return t
+	}
+	t = strings.Replace(t, "\np1.face.offset=0,16\n", "\np1.face.offset=0,16\np1.face.window=0,0,160,240\n", 1)
+	t = strings.Replace(t, "\np2.face.offset=320,16\n", "\np2.face.offset=320,16\np2.face.window=160,0,320,240\n", 1)
+	return t
+}
