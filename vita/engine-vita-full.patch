+package main
+
+// Trigger hoisting for the Vita.
+//
+// CvF's shared player.st is one [Statedef -3] with 877 controllers, most of
+// them guarded by "triggerall = numenemy" or "triggerall = numpartner". Each
+// guard compiles to "<op> jz8 0 pop" at the start of the controller's
+// trigger, and is re-evaluated for every controller on every tick.
+//
+// hoistTriggers wraps each run of consecutive controllers that share such a
+// guard in one parent block whose trigger is the guard alone, and strips the
+// guard from the children. The guard is pure, so evaluating it once per run
+// gives the same result as once per controller; everything else (order,
+// persistence, ignorehitpause) is untouched because the children keep their
+// own blocks.
+
+func hoistTriggers(sb *StateBytecode) {
+	if !fuseEnabled() || sb == nil {
+		return
+	}
+	hoistBlock(&sb.block)
+}
+
+// hoistGuard returns the guard opcode if the trigger starts with a hoistable
+// "triggerall" guard, and the length of that prefix.
+func hoistGuard(t BytecodeExp) (OpCode, int) {
+	if len(t) >= 4 && t[1] == OC_jz8 && t[2] == 0 && t[3] == OC_pop {
+		switch t[0] {
+		case OC_numenemy, OC_numpartner:
+			return t[0], 4
+		}
+	}
+	return 0, 0
+}
+
+func hoistBlock(b *StateBlock) {
+	if b == nil || b.loopBlock || len(b.ctrls) < 2 {
+		return
+	}
+	var out []StateController
+	i := 0
+	for i < len(b.ctrls) {
+		sbi, ok := b.ctrls[i].(*StateBlock)
+		var g OpCode
+		var gl int
+		if ok && !sbi.loopBlock && sbi.elseBlock == nil {
+			g, gl = hoistGuard(sbi.trigger)
+		}
+		if gl == 0 {
+			out = append(out, b.ctrls[i])
+			i++
+			continue
+		}
+		// Extend the run.
+		j := i + 1
+		for j < len(b.ctrls) {
+			sbj, ok := b.ctrls[j].(*StateBlock)
+			if !ok || sbj.loopBlock || sbj.elseBlock != nil {
+				break
+			}
+			if gj, glj := hoistGuard(sbj.trigger); gj != g || glj != gl {
+				break
+			}
+			j++
+		}
+		if j-i < 2 {
+			out = append(out, b.ctrls[i])
+			i++
+			continue
+		}
+		parent := newStateBlock()
+		parent.trigger = BytecodeExp{g}
+		parent.ignorehitpause = true      // children do their own hit-pause checks
+		parent.ctrlsIgnorehitpause = true // likewise
+		for k := i; k < j; k++ {
+			ch := b.ctrls[k].(*StateBlock)
+			ch.trigger = stripPrefix(ch.trigger, gl)
+			parent.ctrls = append(parent.ctrls, ch)
+		}
+		out = append(out, parent)
+		i = j
+	}
+	b.ctrls = out
+	b.runs = nil
+}
+
+// stripPrefix removes the guard; a trigger that was only the guard becomes
+// empty (always true), and a trigger that was "guard; <rest>" where rest was
+// pushed as a plain value keeps the rest.
+func stripPrefix(t BytecodeExp, n int) BytecodeExp {
+	rest := t[n:]
+	if len(rest) == 0 {
+		return nil
+	}
+	// A trailing "value; jmp8 0" from the trigger builder is harmless.
+	return append(BytecodeExp(nil), rest...)
+}
