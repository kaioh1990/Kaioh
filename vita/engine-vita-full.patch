+package main
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"unsafe"
+)
+
+// Debug aid for compiler work: hashes everything CharCompiler.Compile
+// produced for one character (state bytecode, blocks, controller parameters,
+// functions, string pool, console warnings) so a change to the compiler can
+// be checked for identical output. Vita-only, enabled by the file
+// ux0:data/CvF/vita_bchash.txt; one log line per character.
+
+// vitaBCHashEnabled reports whether the compiled-output hash should be logged.
+func vitaBCHashEnabled() bool {
+	if !isVita {
+		return false
+	}
+	_, err := os.Stat("vita_bchash.txt")
+	return err == nil
+}
+
+// vitaBCHashLog logs the hash of a character's compiled states.
+// consoleFrom is len(sys.consoleText) before compiling.
+func vitaBCHashLog(def string, pn int, gi *CharGlobalInfo, states map[int32]*StateBytecode, consoleFrom int) {
+	h := newBCHasher()
+	keys := make([]int, 0, len(states))
+	for k := range states {
+		keys = append(keys, int(k))
+	}
+	sort.Ints(keys)
+	for _, k := range keys {
+		h.u64(uint64(int64(k)))
+		h.value(reflect.ValueOf(states[int32(k)]))
+	}
+	hStates := h.sum
+	h.value(reflect.ValueOf(gi.callFuncs))
+	hFuncs := h.sum
+	h.value(reflect.ValueOf(sys.stringPool[pn].List))
+	h.value(reflect.ValueOf(sys.stringPool[pn].ListLow))
+	if consoleFrom > len(sys.consoleText) {
+		consoleFrom = 0
+	}
+	h.value(reflect.ValueOf(sys.consoleText[consoleFrom:]))
+	vitaTrace(fmt.Sprintf("bchash: %s states=%d bytes=%d pool=%d warn=%d states=%016x funcs=%016x all=%016x",
+		def, len(states), h.bytes, len(sys.stringPool[pn].List), len(sys.consoleText)-consoleFrom,
+		hStates, hFuncs, h.sum))
+}
+
+type bcHasher struct {
+	sum   uint64
+	bytes int
+	seen  map[uintptr]int
+}
+
+func newBCHasher() *bcHasher {
+	return &bcHasher{sum: 14695981039346656037, seen: make(map[uintptr]int)}
+}
+
+func (h *bcHasher) byte1(b byte) {
+	h.sum ^= uint64(b)
+	h.sum *= 1099511628211
+}
+
+func (h *bcHasher) u64(v uint64) {
+	for i := 0; i < 8; i++ {
+		h.byte1(byte(v >> (8 * i)))
+	}
+}
+
+func (h *bcHasher) str(s string) {
+	h.u64(uint64(len(s)))
+	for i := 0; i < len(s); i++ {
+		h.byte1(s[i])
+	}
+}
+
+func (h *bcHasher) value(v reflect.Value) {
+	if !v.IsValid() {
+		h.byte1(0xff)
+		return
+	}
+	switch v.Kind() {
+	case reflect.Bool:
+		if v.Bool() {
+			h.byte1(1)
+		} else {
+			h.byte1(0)
+		}
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		h.u64(uint64(v.Int()))
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
+		h.u64(v.Uint())
+	case reflect.Float32, reflect.Float64:
+		h.u64(uint64(int64(v.Float() * 65536)))
+	case reflect.String:
+		h.str(v.String())
+	case reflect.Slice:
+		if v.IsNil() {
+			h.byte1(0xfe)
+			return
+		}
+		n := v.Len()
+		h.u64(uint64(n))
+		if v.Type().Elem().Kind() == reflect.Uint8 {
+			// Bytecode: hash the raw bytes directly
+			if n > 0 {
+				b := unsafe.Slice((*byte)(v.UnsafePointer()), n)
+				for _, x := range b {
+					h.byte1(x)
+				}
+				h.bytes += n
+			}
+			return
+		}
+		for i := 0; i < n; i++ {
+			h.value(v.Index(i))
+		}
+	case reflect.Array:
+		n := v.Len()
+		for i := 0; i < n; i++ {
+			h.value(v.Index(i))
+		}
+	case reflect.Struct:
+		n := v.NumField()
+		for i := 0; i < n; i++ {
+			h.value(v.Field(i))
+		}
+	case reflect.Ptr:
+		if v.IsNil() {
+			h.byte1(0xfd)
+			return
+		}
+		p := v.Pointer()
+		if id, ok := h.seen[p]; ok {
+			// Shared pointer: hash its first-visit order instead of the address
+			h.byte1(0xfc)
+			h.u64(uint64(id))
+			return
+		}
+		h.seen[p] = len(h.seen)
+		h.value(v.Elem())
+	case reflect.Interface:
+		if v.IsNil() {
+			h.byte1(0xfb)
+			return
+		}
+		e := v.Elem()
+		h.str(e.Type().String())
+		h.value(e)
+	case reflect.Map:
+		if v.IsNil() {
+			h.byte1(0xfa)
+			return
+		}
+		keys := v.MapKeys()
+		h.u64(uint64(len(keys)))
+		sort.Slice(keys, func(i, j int) bool {
+			return fmt.Sprint(keys[i].Interface()) < fmt.Sprint(keys[j].Interface())
+		})
+		for _, k := range keys {
+			h.value(k)
+			h.value(v.MapIndex(k))
+		}
+	case reflect.Func:
+		if v.IsNil() {
+			h.byte1(0xf9)
+		} else {
+			h.byte1(0xf8)
+		}
+	default:
+		// Channels and unsafe pointers are not compiler output
+		h.byte1(0xf7)
+	}
+}
