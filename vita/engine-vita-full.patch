 func (s *SDLSpeaker) Play(st beep.Streamer) {
diff --git a/src/bc_fuse.go b/src/bc_fuse.go
new file mode 100644
index 0000000..f3ed928
--- /dev/null
+++ b/src/bc_fuse.go
@@ -0,0 +1,355 @@
+package main
+
+// Peephole fusion for the Vita bytecode interpreter.
+//
+// Fight logic on the Vita is dominated by the interpreter loop, about 60k
+// operations per tick per player with CvF's shared -3 state, and each
+// dispatch costs more than the work it does. fuseBytecode rewrites the most
+// common two-op sequences into single fused opcodes:
+//
+//	int8 n; var         -> var8 n nop        (also fvar, sysvar)
+//	int8 n; eq/ne/..    -> eq8 n nop ...
+//	jz8 k; pop          -> jz8p k nop        (the "triggerall" separator)
+//
+// Every rewrite keeps the byte length, so no jump target moves; the padding
+// byte is a real no-op opcode in case anything lands on it. The walker only
+// steps across opcodes whose operand size it knows and stops at the first it
+// doesn't, so an unknown opcode can never be mis-decoded.
+
+var fuseFlag = -1
+
+// fuseEnabled: on the Vita unless ux0:data/CvF/vita_nofuse.txt exists
+// (also disables trigger hoisting), for A/B checks with the state hash.
+func fuseEnabled() bool {
+	if fuseFlag < 0 {
+		fuseFlag = 0
+		if isVita && FileExist("vita_nofuse.txt") == "" {
+			fuseFlag = 1
+		}
+	}
+	return fuseFlag == 1
+}
+
+var fuseStats struct{ exprs, fused int }
+
+func fuseBytecode(sb *StateBytecode) {
+	if !fuseEnabled() || sb == nil {
+		return
+	}
+	fuseExp(sb.stateTypeExp)
+	fuseExp(sb.moveTypeExp)
+	fuseExp(sb.physicsExp)
+	fuseBlock(&sb.block)
+}
+
+func fuseBlock(b *StateBlock) {
+	if b == nil {
+		return
+	}
+	fuseExp(b.trigger)
+	fuseExp(b.forCtrlVar.be)
+	for i := range b.forExpression {
+		fuseExp(b.forExpression[i])
+	}
+	if b.elseBlock != nil {
+		fuseBlock(b.elseBlock)
+	}
+	for _, sc := range b.ctrls {
+		switch c := sc.(type) {
+		case *StateBlock:
+			fuseBlock(c)
+		case StateExpr:
+			fuseExp(BytecodeExp(c))
+		case varAssign:
+			fuseExp(c.be)
+		default:
+			fuseController(sc)
+		}
+	}
+}
+
+// fuseController fuses the parameter expressions of a state controller. The
+// controllers are all StateControllerBase ([]byte of "paramID; count;
+// expr-length; expr..." entries) wrapped in distinct named types; sc_runfn.go
+// knows them all, so it provides the conversion.
+func fuseController(sc StateController) {
+	scb, ok := scBase(sc)
+	if !ok {
+		return
+	}
+	for _, p := range scb {
+		for _, e := range p.exp {
+			fuseExp(e)
+		}
+	}
+}
+
+// opLen returns the operand length of a base opcode, or -1 when the walker
+// must stop (unknown opcode, or a nested block it handles separately).
+func opLen(op OpCode) int {
+	switch op {
+	case OC_jud8, OC_jz8, OC_jnz8, OC_jmp8, OC_int8, OC_localvar,
+		OC_statetype, OC_movetype, OC_teammode:
+		return 1
+	case OC_jz, OC_jnz, OC_jmp, OC_int, OC_float, OC_string, OC_hitdefattr:
+		return 4
+	case OC_int64:
+		return 8
+	case OC_var8, OC_fvar8, OC_sysvar8, OC_eq8, OC_ne8, OC_lt8, OC_gt8, OC_le8, OC_ge8, OC_jz8p, OC_jnz8p:
+		return 2
+	case OC_eq32, OC_ne32, OC_lt32, OC_gt32, OC_le32, OC_ge32:
+		return 5
+	case OC_range_ii8, OC_range_ie8, OC_range_ei8, OC_range_ee8:
+		return 4
+	case OC_range_ii32, OC_range_ie32, OC_range_ei32, OC_range_ee32:
+		return 10
+	case OC_tcmp8:
+		return 6
+	case OC_tcmp32:
+		return 9
+	case OC_trange8:
+		return 8
+	case OC_trange32:
+		return 14
+	case OC_tvcmp8:
+		return 8
+	case OC_player, OC_parent, OC_root, OC_helper, OC_target, OC_partner, OC_enemy,
+		OC_enemynear, OC_playerid, OC_playerindex, OC_p2, OC_stateowner, OC_helperindex,
+		OC_run_redir, OC_run_caller:
+		return -2 // 4-byte length + nested block
+	case OC_ex_, OC_ex2_, OC_ex3_, OC_const_, OC_assign_:
+		return -1 // sub-opcodes with their own operands: stop here
+	}
+	if op < OC_ex3_ {
+		return 0 // plain trigger / operator
+	}
+	return -1
+}
+
+func fuseExp(be BytecodeExp) {
+	if len(be) == 0 {
+		return
+	}
+	fuseStats.exprs++
+	fuseExp1(be)
+	fuseLines(be)
+}
+
+func fuseExp1(be BytecodeExp) {
+	i := 0
+	for i < len(be) {
+		op := be[i]
+		// Fusions: check the two-op patterns at i.
+		if op == OC_int8 && i+2 < len(be) {
+			var f OpCode
+			switch be[i+2] {
+			case OC_var:
+				f = OC_var8
+			case OC_fvar:
+				f = OC_fvar8
+			case OC_sysvar:
+				f = OC_sysvar8
+			case OC_eq:
+				f = OC_eq8
+			case OC_ne:
+				f = OC_ne8
+			case OC_lt:
+				f = OC_lt8
+			case OC_gt:
+				f = OC_gt8
+			case OC_le:
+				f = OC_le8
+			case OC_ge:
+				f = OC_ge8
+			}
+			if f != 0 {
+				be[i], be[i+2] = f, OC_nop
+				fuseStats.fused++
+				i += 3
+				continue
+			}
+		}
+		if op == OC_int8 && i+5 < len(be) && be[i+2] == OC_int8 && be[i+4] >= OC_range_ii && be[i+4] <= OC_range_ee {
+			// int8 a; int8 b; range -> range8 a b nop nop
+			be[i] = be[i+4] - OC_range_ii + OC_range_ii8
+			be[i+2] = be[i+3] // b
+			be[i+3], be[i+4] = OC_nop, OC_nop
+			fuseStats.fused++
+			i += 5
+			continue
+		}
+		if op == OC_int && i+5 < len(be) {
+			var f OpCode
+			switch be[i+5] {
+			case OC_eq:
+				f = OC_eq32
+			case OC_ne:
+				f = OC_ne32
+			case OC_lt:
+				f = OC_lt32
+			case OC_gt:
+				f = OC_gt32
+			case OC_le:
+				f = OC_le32
+			case OC_ge:
+				f = OC_ge32
+			}
+			if f != 0 {
+				be[i], be[i+5] = f, OC_nop
+				fuseStats.fused++
+				i += 6
+				continue
+			}
+			if i+10 < len(be) && be[i+5] == OC_int && be[i+10] >= OC_range_ii && be[i+10] <= OC_range_ee {
+				// int a; int b; range -> range32 a b nop nop
+				be[i] = be[i+10] - OC_range_ii + OC_range_ii32
+				copy(be[i+5:i+9], be[i+6:i+10])
+				be[i+9], be[i+10] = OC_nop, OC_nop
+				fuseStats.fused++
+				i += 11
+				continue
+			}
+		}
+		if (op == OC_jz8 || op == OC_jnz8) && i+2 < len(be) && be[i+2] == OC_pop {
+			// Only when the jump can't land on the pop we're removing: a
+			// forward jump of k lands at i+2+k, which equals the pop only
+			// for k == 0 (meaning "end of expression"), so this is always safe.
+			if op == OC_jz8 {
+				be[i] = OC_jz8p
+			} else {
+				be[i] = OC_jnz8p
+			}
+			be[i+2] = OC_nop
+			fuseStats.fused++
+			i += 3
+			continue
+		}
+		n := opLen(op)
+		switch {
+		case n >= 0:
+			i += 1 + n
+		case n == -2:
+			if i+5 > len(be) {
+				return
+			}
+			l := int(bcI32([]OpCode(be), i+1))
+			if l < 0 || i+5+l > len(be) {
+				return
+			}
+			fuseExp(be[i+5 : i+5+l])
+			i += 5 + l
+		default:
+			return
+		}
+	}
+}
+
+// isSimpleTrigger reports whether t is a one-byte trigger pushTrigger handles.
+func isSimpleTrigger(t OpCode) bool {
+	switch t {
+	case OC_stateno, OC_prevstateno, OC_life, OC_lifemax, OC_roundstate, OC_time, OC_alive, OC_ctrl,
+		OC_anim, OC_numpartner, OC_numenemy, OC_gametime, OC_power, OC_facing, OC_hitpausetime,
+		OC_movecontact, OC_movehit, OC_teamside, OC_id:
+		return true
+	}
+	return false
+}
+
+func isCmp8(op OpCode) bool  { return op >= OC_eq8 && op <= OC_ge8 }
+func isCmp32(op OpCode) bool { return op >= OC_eq32 && op <= OC_ge32 }
+func cmpOf8(op OpCode) OpCode {
+	switch op {
+	case OC_eq8:
+		return OC_eq
+	case OC_ne8:
+		return OC_ne
+	case OC_lt8:
+		return OC_lt
+	case OC_gt8:
+		return OC_gt
+	case OC_le8:
+		return OC_le
+	}
+	return OC_ge
+}
+func cmpOf32(op OpCode) OpCode { return cmpOf8(op - OC_eq32 + OC_eq8) }
+
+// fuseLines runs after fuseExp1 and folds "T; cmp k; jz8p 0" lines.
+func fuseLines(be BytecodeExp) {
+	i := 0
+	for i < len(be) {
+		op := be[i]
+		if isSimpleTrigger(op) {
+			// T; cmp8 n nop; jz8p 0 nop  (7 bytes)
+			if i+6 < len(be) && isCmp8(be[i+1]) && be[i+4] == OC_jz8p && be[i+5] == 0 {
+				t, cmp, n := op, cmpOf8(be[i+1]), be[i+2]
+				be[i], be[i+1], be[i+2], be[i+3] = OC_tcmp8, t, cmp, n
+				be[i+4], be[i+5], be[i+6] = OC_nop, OC_nop, OC_nop
+				fuseStats.fused++
+				i += 7
+				continue
+			}
+			// T; cmp32 n(4) nop; jz8p 0 nop  (10 bytes)
+			if i+9 < len(be) && isCmp32(be[i+1]) && be[i+7] == OC_jz8p && be[i+8] == 0 {
+				t, cmp := op, cmpOf32(be[i+1])
+				var k [4]OpCode
+				copy(k[:], be[i+2:i+6])
+				be[i], be[i+1], be[i+2] = OC_tcmp32, t, cmp
+				copy(be[i+3:i+7], k[:])
+				be[i+7], be[i+8], be[i+9] = OC_nop, OC_nop, OC_nop
+				fuseStats.fused++
+				i += 10
+				continue
+			}
+			// T; rangeR8 a b nop nop; jz8p 0 nop  (9 bytes)
+			if i+8 < len(be) && be[i+1] >= OC_range_ii8 && be[i+1] <= OC_range_ee8 && be[i+6] == OC_jz8p && be[i+7] == 0 {
+				t, r, a, b := op, be[i+1]-OC_range_ii8+OC_range_ii, be[i+2], be[i+3]
+				be[i], be[i+1], be[i+2], be[i+3], be[i+4] = OC_trange8, t, r, a, b
+				be[i+5], be[i+6], be[i+7], be[i+8] = OC_nop, OC_nop, OC_nop, OC_nop
+				fuseStats.fused++
+				i += 9
+				continue
+			}
+			// T; rangeR32 a(4) b(4) nop nop; jz8p 0 nop  (15 bytes)
+			if i+14 < len(be) && be[i+1] >= OC_range_ii32 && be[i+1] <= OC_range_ee32 && be[i+12] == OC_jz8p && be[i+13] == 0 {
+				t, r := op, be[i+1]-OC_range_ii32+OC_range_ii
+				var ab [8]OpCode
+				copy(ab[:], be[i+2:i+10])
+				be[i], be[i+1], be[i+2] = OC_trange32, t, r
+				copy(be[i+3:i+11], ab[:])
+				be[i+11], be[i+12], be[i+13], be[i+14] = OC_nop, OC_nop, OC_nop, OC_nop
+				fuseStats.fused++
+				i += 15
+				continue
+			}
+		}
+		if op == OC_var8 || op == OC_fvar8 || op == OC_sysvar8 {
+			// var8 v nop; cmp8 n nop; jz8p 0 nop  (9 bytes)
+			if i+8 < len(be) && isCmp8(be[i+3]) && be[i+6] == OC_jz8p && be[i+7] == 0 {
+				v, cmp, n := be[i+1], cmpOf8(be[i+3]), be[i+4]
+				be[i], be[i+1], be[i+2], be[i+3], be[i+4] = OC_tvcmp8, op, v, cmp, n
+				be[i+5], be[i+6], be[i+7], be[i+8] = OC_nop, OC_nop, OC_nop, OC_nop
+				fuseStats.fused++
+				i += 9
+				continue
+			}
+		}
+		n := opLen(op)
+		switch {
+		case n >= 0:
+			i += 1 + n
+		case n == -2:
+			if i+5 > len(be) {
+				return
+			}
+			l := int(bcI32([]OpCode(be), i+1))
+			if l < 0 || i+5+l > len(be) {
+				return
+			}
+			fuseLines(be[i+5 : i+5+l])
+			i += 5 + l
+		default:
+			return
+		}
+	}
+}
diff --git a/src/bcprof.go b/src/bcprof.go
new file mode 100644
index 0000000..4cacca4
--- /dev/null
+++ b/src/bcprof.go
@@ -0,0 +1,250 @@
+package main
+
+import (
+	"fmt"
+	"sort"
+)
+
+// Diagnostics for where fight CPU time goes.
+//
+// bcOpProf (compile-time, emulator): count bytecode operations per
+// (player, helper, state) and per controller of the first player's -3.
+//
+// hwProf (run-time, PS Vita): the same breakdown in microseconds, measured
+// once during the first match (ticks 120..720 of round state 2+) and written
+// to the log.
+const bcOpProf = false
+
+var bcOps uint64
+var bcOpHist [256]uint64
+var bcPairHist map[uint16]uint64 = map[uint16]uint64{}
+var bcPrevOp OpCode
+var bcExHist = map[uint16]uint64{}
+
+var hwProf bool
+var hwProfDone bool
+
+type bcProfKey struct {
+	pn  int
+	hid int32
+	st  int32
+}
+
+var bcProfMap = map[bcProfKey]uint64{}
+var bcProfFrames int
+
+func bcProfNow() uint64 {
+	if bcOpProf {
+		return bcOps
+	}
+	return uint64(vitaNowUs())
+}
+
+func bcProfRun(c *Char, sb *StateBytecode, st int32) bool {
+	if !bcOpProf && !hwProf {
+		return sb.run(c)
+	}
+	if st == -3 && c.playerNo == 0 && c.helperIndex == 0 {
+		bcProfTop = &sb.block
+	}
+	o := bcProfNow()
+	r := sb.run(c)
+	k := bcProfKey{c.playerNo, c.helperId, st}
+	if c.helperIndex == 0 {
+		k.hid = -1
+	} else if st >= 0 {
+		k.st = -100 // all helper states together
+	}
+	bcProfMap[k] += uint64(uint32(bcProfNow() - o))
+	return r
+}
+
+// bcProfFrame is called once per game tick.
+func bcProfFrame() {
+	if (!bcOpProf && !isVita) || hwProfDone {
+		return
+	}
+	if sys.roundState() < 2 {
+		return
+	}
+	bcProfFrames++
+	switch {
+	case bcProfFrames < 120:
+		return
+	case bcProfFrames == 120:
+		// Start measuring.
+		hwProf = isVita && !bcOpProf
+		bcProfMap = map[bcProfKey]uint64{}
+		bcOps = 0
+		for i := range bcProfCtlOps {
+			bcProfCtlOps[i] = 0
+		}
+		bcProfStart = bcProfNow()
+		return
+	case bcProfFrames < 720:
+		return
+	}
+	hwProf, hwProfDone = false, true
+	n := uint64(600)
+	unit := "us"
+	if bcOpProf {
+		unit = "ops"
+	}
+	type kv struct {
+		k bcProfKey
+		v uint64
+	}
+	var all []kv
+	var sum uint64
+	for k, v := range bcProfMap {
+		all = append(all, kv{k, v})
+		sum += v
+	}
+	sort.Slice(all, func(i, j int) bool { return all[i].v > all[j].v })
+	if bcOpProf {
+		type ov struct {
+			o OpCode
+			v uint64
+		}
+		var hs []ov
+		for o, v := range bcOpHist {
+			if v > 0 {
+				hs = append(hs, ov{OpCode(o), v})
+			}
+		}
+		sort.Slice(hs, func(i, j int) bool { return hs[i].v > hs[j].v })
+		for i, e := range hs {
+			if i >= 40 {
+				break
+			}
+			vitaTrace("bcprof: op " + itoa(int(e.o)) + " " + itoa(int(e.v/n)))
+		}
+		type pv struct {
+			p uint16
+			v uint64
+		}
+		var ps []pv
+		for p, v := range bcExHist {
+			ps = append(ps, pv{p, v})
+		}
+		sort.Slice(ps, func(i, j int) bool { return ps[i].v > ps[j].v })
+		for i, e := range ps {
+			if i >= 30 {
+				break
+			}
+			vitaTrace("bcprof: ex " + itoa(int(e.p>>8)) + "," + itoa(int(e.p&255)) + " " + itoa(int(e.v/n)))
+		}
+		ps = nil
+		for p, v := range bcPairHist {
+			ps = append(ps, pv{p, v})
+		}
+		sort.Slice(ps, func(i, j int) bool { return ps[i].v > ps[j].v })
+		for i, e := range ps {
+			if i >= 40 {
+				break
+			}
+			vitaTrace("bcprof: pair " + itoa(int(e.p>>8)) + "," + itoa(int(e.p&255)) + " " + itoa(int(e.v/n)))
+		}
+	}
+	vitaTrace("bcprof: " + unit + " per tick in char states " + itoa(int(sum/n)) + " (whole window " + itoa(int(uint64(uint32(bcProfNow()-bcProfStart))/n)) + ")")
+	for i, e := range all {
+		if i >= 30 {
+			break
+		}
+		vitaTrace("bcprof: " + itoa(int(e.v/n)) + " p" + itoa(e.k.pn) + " h" + itoa(int(e.k.hid)) + " st " + itoa(int(e.k.st)))
+	}
+	bcProfCtlDump(n)
+}
+
+var bcProfStart uint64
+var bcProfTop *StateBlock
+var bcProfCtlOps []uint64
+var bcProfCtlSc []StateController
+
+func bcProfCtl(i int, sc StateController, ops uint64) {
+	for len(bcProfCtlOps) <= i {
+		bcProfCtlOps = append(bcProfCtlOps, 0)
+		bcProfCtlSc = append(bcProfCtlSc, nil)
+	}
+	bcProfCtlOps[i] += uint64(uint32(ops))
+	bcProfCtlSc[i] = sc
+}
+
+func bcProfCtlDump(n uint64) {
+	// Totals per block of 32 controllers, in file order.
+	var line []byte
+	for i := 0; i < len(bcProfCtlOps); i += 32 {
+		var t uint64
+		for j := i; j < i+32 && j < len(bcProfCtlOps); j++ {
+			t += bcProfCtlOps[j]
+		}
+		line = append(line, []byte(itoa(i)+":"+itoa(int(t/n))+" ")...)
+	}
+	vitaTrace("bcprof: -3 has " + itoa(len(bcProfCtlOps)) + " ctrls; per 32: " + string(line))
+	idx := make([]int, len(bcProfCtlOps))
+	for i := range idx {
+		idx[i] = i
+	}
+	sort.Slice(idx, func(a, b int) bool { return bcProfCtlOps[idx[a]] > bcProfCtlOps[idx[b]] })
+	for k, i := range idx {
+		if k >= 25 {
+			break
+		}
+		name := fmt.Sprintf("%T", bcProfCtlSc[i])
+		if sb, ok := bcProfCtlSc[i].(*StateBlock); ok && len(sb.ctrls) > 0 {
+			name = fmt.Sprintf("%T", sb.ctrls[0])
+		}
+		vitaTrace("bcprof: ctl " + itoa(i) + " " + itoa(int(bcProfCtlOps[i]*100/n)) + "/100 " + name)
+	}
+}
+
+// State hash (ux0:data/CvF/vita_statehash.txt): fixed random seed and, during
+// a match, a log line every 30 ticks with a hash of the players' state. Used
+// to check that bytecode fusion/hoisting changes nothing: two emulator runs
+// with and without them must produce identical lines.
+var vitaStateHashOn = -1
+
+func vitaStateHashEnabled() bool {
+	if vitaStateHashOn < 0 {
+		vitaStateHashOn = 0
+		if FileExist("vita_statehash.txt") != "" {
+			vitaStateHashOn = 1
+			Srand(12345)
+		}
+	}
+	return vitaStateHashOn == 1
+}
+
+var stateHashTick int
+
+func vitaStateHashTick() {
+	if !isVita || !vitaStateHashEnabled() || sys.roundState() < 1 {
+		return
+	}
+	stateHashTick++
+	if stateHashTick%30 != 0 {
+		return
+	}
+	var h uint32 = 2166136261
+	mix := func(v uint32) { h = (h ^ v) * 16777619 }
+	for pn := 0; pn < 2 && pn < len(sys.chars); pn++ {
+		for _, c := range sys.chars[pn] {
+			mix(uint32(c.ss.no))
