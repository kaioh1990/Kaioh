@@ -1452,6 +1464,34 @@ func newSpriteData() *SpriteData {
 	}
 }
 
+var spriteDataPool struct {
+	chunks [][]SpriteData
+	chunk  int
+	idx    int
+}
+
+func spriteDataPoolNext() *SpriteData {
+	p := &spriteDataPool
+	for {
+		if p.chunk >= len(p.chunks) {
+			p.chunks = append(p.chunks, make([]SpriteData, 64))
+		}
+		if p.idx < len(p.chunks[p.chunk]) {
+			sd := &p.chunks[p.chunk][p.idx]
+			p.idx++
+			return sd
+		}
+		p.chunk++
+		p.idx = 0
+	}
+}
+
+// spriteDataPoolReset makes the pool reusable; called when the frame's
+// sprite lists are cleared.
+func spriteDataPoolReset() {
+	spriteDataPool.chunk, spriteDataPool.idx = 0, 0
+}
+
 func (sd *SpriteData) isBlank() bool {
 	return sd.scl[0] == 0 || sd.scl[1] == 0 || sd.anim == nil || sd.anim.isBlank()
