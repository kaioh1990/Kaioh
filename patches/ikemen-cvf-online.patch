+func (u *UdpProtocol) EndPollLoop() {
+	if u.RemoteChecksumsThisFrame.Len() > 0 {
+		highestFrameNum := u.RemoteChecksumsThisFrame.Greatest()
+		u.RemoteChecksums.Set(highestFrameNum.Key, highestFrameNum.Value)
+	}
+}
