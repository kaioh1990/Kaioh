diff --git a/src/cvf_detmath.go b/src/cvf_detmath.go
new file mode 100644
index 0000000..0e4430f
--- /dev/null
+++ b/src/cvf_detmath.go
@@ -0,0 +1,268 @@
+// CvF Online: deterministic copies of math.Exp/Log/Pow/Hypot/Log2.
+//
+// Go's math package uses hand-written assembly for Exp (amd64, arm64), Log and
+// Hypot (amd64). Those give slightly different results on Intel/AMD vs Apple
+// chips, which desyncs rollback netplay between a PC and a Mac/iPad. These are
+// the portable pure-Go versions from the Go standard library, so every CPU
+// computes bit-identical results (all builds also disable FMA fusion).
+//
+// Derived from Go's src/math (exp.go, log.go, pow.go, hypot.go, log10.go):
+// Copyright 2009 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license (Go LICENSE).
+
+package main
+
+import "math"
+
+func cvfExp(x float64) float64 {
+	const (
+		Ln2Hi = 6.93147180369123816490e-01
+		Ln2Lo = 1.90821492927058770002e-10
+		Log2e = 1.44269504088896338700e+00
+
+		Overflow  = 7.09782712893383973096e+02
+		Underflow = -7.45133219101941108420e+02
+		NearZero  = 1.0 / (1 << 28) // 2**-28
+	)
+
+	// special cases
+	switch {
+	case math.IsNaN(x):
+		return x
+	case x > Overflow: // handles case where x is +∞
+		return math.Inf(1)
+	case x < Underflow: // handles case where x is -∞
+		return 0
+	case -NearZero < x && x < NearZero:
+		return 1 + x
+	}
+
+	// reduce; computed as r = hi - lo for extra precision.
+	var k int
+	switch {
+	case x < 0:
+		k = int(Log2e*x - 0.5)
+	case x > 0:
+		k = int(Log2e*x + 0.5)
+	}
+	hi := x - float64(k)*Ln2Hi
+	lo := float64(k) * Ln2Lo
+
+	// compute
+	return cvfExpmulti(hi, lo, k)
+}
+func cvfExpmulti(hi, lo float64, k int) float64 {
+	const (
+		P1 = 1.66666666666666657415e-01  /* 0x3FC55555; 0x55555555 */
+		P2 = -2.77777777770155933842e-03 /* 0xBF66C16C; 0x16BEBD93 */
+		P3 = 6.61375632143793436117e-05  /* 0x3F11566A; 0xAF25DE2C */
+		P4 = -1.65339022054652515390e-06 /* 0xBEBBBD41; 0xC5D26BF1 */
+		P5 = 4.13813679705723846039e-08  /* 0x3E663769; 0x72BEA4D0 */
+	)
+
+	r := hi - lo
+	t := r * r
+	c := r - t*(P1+t*(P2+t*(P3+t*(P4+t*P5))))
+	y := 1 - ((lo - (r*c)/(2-c)) - hi)
+	// TODO(rsc): make sure math.Ldexp can handle boundary k
+	return math.Ldexp(y, k)
+}
+
+func cvfLog(x float64) float64 {
+	const (
+		Ln2Hi = 6.93147180369123816490e-01 /* 3fe62e42 fee00000 */
+		Ln2Lo = 1.90821492927058770002e-10 /* 3dea39ef 35793c76 */
+		L1    = 6.666666666666735130e-01   /* 3FE55555 55555593 */
+		L2    = 3.999999999940941908e-01   /* 3FD99999 9997FA04 */
+		L3    = 2.857142874366239149e-01   /* 3FD24924 94229359 */
+		L4    = 2.222219843214978396e-01   /* 3FCC71C5 1D8E78AF */
+		L5    = 1.818357216161805012e-01   /* 3FC74664 96CB03DE */
+		L6    = 1.531383769920937332e-01   /* 3FC39A09 D078C69F */
+		L7    = 1.479819860511658591e-01   /* 3FC2F112 DF3E5244 */
+	)
+
+	// special cases
+	switch {
+	case math.IsNaN(x) || math.IsInf(x, 1):
+		return x
+	case x < 0:
+		return math.NaN()
+	case x == 0:
+		return math.Inf(-1)
+	}
+
+	// reduce
+	f1, ki := math.Frexp(x)
+	if f1 < math.Sqrt2/2 {
+		f1 *= 2
+		ki--
+	}
+	f := f1 - 1
+	k := float64(ki)
+
+	// compute
+	s := f / (2 + f)
+	s2 := s * s
+	s4 := s2 * s2
+	t1 := s2 * (L1 + s4*(L3+s4*(L5+s4*L7)))
+	t2 := s4 * (L2 + s4*(L4+s4*L6))
+	R := t1 + t2
+	hfsq := 0.5 * f * f
+	return k*Ln2Hi - ((hfsq - (s*(hfsq+R) + k*Ln2Lo)) - f)
+}
+
+func cvfIsOddInt(x float64) bool {
+	if math.Abs(x) >= (1 << 53) {
+		// 1 << 53 is the largest exact integer in the float64 format.
+		// Any number outside this range will be truncated before the decimal point and therefore will always be
+		// an even integer.
+		// Without this check and if x overflows int64 the int64(xi) conversion below may produce incorrect results
+		// on some architectures (and does so on arm64). See issue #57465.
+		return false
+	}
+
+	xi, xf := math.Modf(x)
+	return xf == 0 && int64(xi)&1 == 1
+}
+
+func cvfPow(x, y float64) float64 {
+	switch {
+	case y == 0 || x == 1:
+		return 1
+	case y == 1:
+		return x
+	case math.IsNaN(x) || math.IsNaN(y):
+		return math.NaN()
+	case x == 0:
+		switch {
+		case y < 0:
+			if math.Signbit(x) && cvfIsOddInt(y) {
+				return math.Inf(-1)
+			}
+			return math.Inf(1)
+		case y > 0:
+			if math.Signbit(x) && cvfIsOddInt(y) {
+				return x
+			}
+			return 0
+		}
+	case math.IsInf(y, 0):
+		switch {
+		case x == -1:
+			return 1
+		case (math.Abs(x) < 1) == math.IsInf(y, 1):
+			return 0
+		default:
+			return math.Inf(1)
+		}
+	case math.IsInf(x, 0):
+		if math.IsInf(x, -1) {
+			return cvfPow(1/x, -y) // Pow(-0, -y)
+		}
+		switch {
+		case y < 0:
+			return 0
+		case y > 0:
+			return math.Inf(1)
+		}
+	case y == 0.5:
+		return math.Sqrt(x)
+	case y == -0.5:
+		return 1 / math.Sqrt(x)
+	}
+
+	yi, yf := math.Modf(math.Abs(y))
+	if yf != 0 && x < 0 {
+		return math.NaN()
+	}
+	if yi >= 1<<63 {
+		// yi is a large even int that will lead to overflow (or underflow to 0)
+		// for all x except -1 (x == 1 was handled earlier)
+		switch {
+		case x == -1:
+			return 1
+		case (math.Abs(x) < 1) == (y > 0):
+			return 0
+		default:
+			return math.Inf(1)
+		}
+	}
+
+	// ans = a1 * 2**ae (= 1 for now).
+	a1 := 1.0
+	ae := 0
+
+	// ans *= x**yf
+	if yf != 0 {
+		if yf > 0.5 {
+			yf--
+			yi++
+		}
+		a1 = cvfExp(yf * cvfLog(x))
+	}
+
+	// ans *= x**yi
+	// by multiplying in successive squarings
+	// of x according to bits of yi.
+	// accumulate powers of two into exp.
+	x1, xe := math.Frexp(x)
+	for i := int64(yi); i != 0; i >>= 1 {
+		if xe < -1<<12 || 1<<12 < xe {
+			// catch xe before it overflows the left shift below
+			// Since i !=0 it has at least one bit still set, so ae will accumulate xe
+			// on at least one more iteration, ae += xe is a lower bound on ae
+			// the lower bound on ae exceeds the size of a float64 exp
+			// so the final call to math.Ldexp will produce under/overflow (0/math.Inf)
+			ae += xe
+			break
+		}
+		if i&1 == 1 {
+			a1 *= x1
+			ae += xe
+		}
+		x1 *= x1
+		xe <<= 1
+		if x1 < .5 {
+			x1 += x1
+			xe--
+		}
+	}
+
+	// ans = a1*2**ae
+	// if y < 0 { ans = 1 / ans }
+	// but in the opposite order
+	if y < 0 {
+		a1 = 1 / a1
+		ae = -ae
+	}
+	return math.Ldexp(a1, ae)
+}
+
+func cvfHypot(p, q float64) float64 {
+	p, q = math.Abs(p), math.Abs(q)
+	// special cases
+	switch {
+	case math.IsInf(p, 1) || math.IsInf(q, 1):
+		return math.Inf(1)
+	case math.IsNaN(p) || math.IsNaN(q):
+		return math.NaN()
+	}
+	if p < q {
+		p, q = q, p
+	}
+	if p == 0 {
+		return 0
+	}
+	q = q / p
+	return p * math.Sqrt(1+q*q)
+}
+
+func cvfLog2(x float64) float64 {
+	frac, exp := math.Frexp(x)
+	// Make sure exact powers of two give an exact answer.
+	// Don't depend on Log(0.5)*(1/math.Ln2)+exp being exactly exp-1.
+	if frac == 0.5 {
+		return float64(exp - 1)
+	}
+	return cvfLog(frac)*(1/math.Ln2) + float64(exp)
+}
diff --git a/src/cvf_online.go b/src/cvf_online.go
new file mode 100644
index 0000000..585f32e
--- /dev/null
+++ b/src/cvf_online.go
@@ -0,0 +1,788 @@
+package main
+
+// Castlevania Fighter online helpers:
+//   - shows the host's public/LAN address and port while waiting for an opponent
+//   - opens the netplay ports on the router automatically (UPnP IGD, no dependencies)
+//   - talks to a small lobby server so players can find each other without typing IPs
+//
+// Everything network-related runs in goroutines; Lua only polls cached state, so the
+// menus never block on the network.
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"encoding/xml"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	lua "github.com/yuin/gopher-lua"
+)
+
+const cvfOnlineConfigFile = "data/cvf_online.ini"
+const cvfOnlineProfileFile = "save/cvf_online_profile.json"
+
+type cvfOnlineState struct {
+	mu sync.Mutex
+
+	lobbyURL    string
+	buildTag    string
+	playerName  string
+	configRead  bool
+	httpClient  *http.Client
+	publicIP    string
+	publicIPErr string
+	publicBusy  bool
+
+	upnpStatus string
+	upnpMapped []upnpMapping
+
+	hosting       bool
+	hostPort      int
+	roomID        string
+	roomToken     string
+	roomOpen      string // "", "yes", "no"
+	lobbyHostErr  string
+	hostStop      chan struct{}
+	rooms         []cvfRoom
+	roomsErr      string
+	roomsBusy     bool
+	roomsFetched  time.Time
+	roomsRequests int
+}
+
+type cvfRoom struct {
+	ID      string `json:"id"`
+	Name    string `json:"name"`
+	IP      string `json:"ip"`
+	Port    int    `json:"port"`
+	UDPPort int    `json:"udp_port"`
+	Version string `json:"version"`
+	Open    string `json:"open"`
+	AgeSec  int    `json:"age_sec"`
+}
+
+var cvfOnline = &cvfOnlineState{
+	httpClient: &http.Client{Timeout: 70 * time.Second}, // free hosts can take ~1 min to wake up
+	buildTag:   "cvf-online-1",
+}
+
+func (s *cvfOnlineState) readConfig() {
+	if s.configRead {
+		return
+	}
+	s.configRead = true
+	if f, err := os.Open(cvfOnlineConfigFile); err == nil {
+		sc := bufio.NewScanner(f)
+		for sc.Scan() {
+			line := strings.TrimSpace(sc.Text())
+			if i := strings.Index(line, ";"); i >= 0 {
+				line = strings.TrimSpace(line[:i])
+			}
+			k, v, ok := strings.Cut(line, "=")
+			if !ok {
+				continue
+			}
+			k, v = strings.ToLower(strings.TrimSpace(k)), strings.TrimSpace(v)
+			switch k {
+			case "lobbyurl":
+				s.lobbyURL = strings.TrimRight(v, "/")
+			case "buildtag":
+				if v != "" {
+					s.buildTag = v
+				}
+			}
+		}
+		f.Close()
+	}
+	if b, err := os.ReadFile(cvfOnlineProfileFile); err == nil {
+		var p struct {
+			Name string `json:"name"`
+		}
+		if json.Unmarshal(b, &p) == nil {
+			s.playerName = p.Name
+		}
+	}
+}
+
+func (s *cvfOnlineState) saveProfile() {
+	b, _ := json.Marshal(map[string]string{"name": s.playerName})
+	os.MkdirAll(filepath.Dir(cvfOnlineProfileFile), 0755)
+	os.WriteFile(cvfOnlineProfileFile, b, 0644)
+}
+
+// ---------------------------------------------------------------------------
+// Addresses
+
+func cvfLocalIPs() []string {
+	var out []string
+	ifaces, _ := net.Interfaces()
+	for _, ifc := range ifaces {
+		if ifc.Flags&net.FlagUp == 0 || ifc.Flags&net.FlagLoopback != 0 {
+			continue
+		}
+		addrs, _ := ifc.Addrs()
+		for _, a := range addrs {
+			if ipn, ok := a.(*net.IPNet); ok {
+				if ip4 := ipn.IP.To4(); ip4 != nil && !ip4.IsLinkLocalUnicast() {
+					out = append(out, ip4.String())
+				}
+			}
+		}
+	}
+	return out
+}
+
+func (s *cvfOnlineState) fetchPublicIP() {
+	s.mu.Lock()
+	if s.publicBusy || s.publicIP != "" {
+		s.mu.Unlock()
+		return
+	}
+	s.publicBusy = true
+	lobby := s.lobbyURL
+	s.mu.Unlock()
+
+	go func() {
+		ip, err := "", fmt.Errorf("no lobby configured")
+		sources := []string{}
+		if lobby != "" {
+			sources = append(sources, lobby+"/api/ip")
+		}
+		sources = append(sources, "https://api.ipify.org?format=json")
+		for _, u := range sources {
+			ip, err = s.getIP(u)
+			if err == nil && ip != "" {
+				break
+			}
+		}
+		s.mu.Lock()
+		s.publicBusy = false
+		if err == nil && ip != "" {
+			s.publicIP, s.publicIPErr = ip, ""
+		} else {
+			s.publicIPErr = "unknown"
+		}
+		s.mu.Unlock()
+	}()
+}
+
+func (s *cvfOnlineState) getIP(u string) (string, error) {
+	c := &http.Client{Timeout: 15 * time.Second}
+	resp, err := c.Get(u)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+	var v struct {
+		IP string `json:"ip"`
+	}
+	if err := json.NewDecoder(io.LimitReader(resp.Body, 4096)).Decode(&v); err != nil {
+		return "", err
+	}
+	if net.ParseIP(v.IP) == nil {
+		return "", fmt.Errorf("bad ip")
+	}
+	return v.IP, nil
+}
+
+// ---------------------------------------------------------------------------
+// Minimal UPnP IGD client (SSDP discovery + SOAP AddPortMapping/DeletePortMapping)
+
+type upnpMapping struct {
+	controlURL, service string
+	port                int
+	proto               string
+}
+
+type upnpDevice struct {
+	controlURL, service, localIP string
+}
+
+func upnpDiscover() (*upnpDevice, error) {
+	conn, err := net.ListenPacket("udp4", ":0")
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	dst := &net.UDPAddr{IP: net.IPv4(239, 255, 255, 250), Port: 1900}
+	for _, st := range []string{
+		"urn:schemas-upnp-org:device:InternetGatewayDevice:1",
+		"urn:schemas-upnp-org:device:InternetGatewayDevice:2",
+		"urn:schemas-upnp-org:service:WANIPConnection:1",
+	} {
+		msg := "M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nST: " + st +
+			"\r\nMAN: \"ssdp:discover\"\r\nMX: 2\r\n\r\n"
+		conn.WriteTo([]byte(msg), dst)
+	}
+	conn.SetReadDeadline(time.Now().Add(3 * time.Second))
+	buf := make([]byte, 4096)
+	seen := map[string]bool{}
+	for {
+		n, _, err := conn.ReadFrom(buf)
+		if err != nil {
+			return nil, fmt.Errorf("no UPnP router found")
+		}
+		loc := ""
+		for _, line := range strings.Split(string(buf[:n]), "\r\n") {
+			if k, v, ok := strings.Cut(line, ":"); ok && strings.EqualFold(strings.TrimSpace(k), "location") {
+				loc = strings.TrimSpace(v)
+			}
+		}
+		if loc == "" || seen[loc] {
+			continue
+		}
+		seen[loc] = true
+		if d, err := upnpDescribe(loc); err == nil {
+			return d, nil
+		}
+	}
+}
+
+func upnpDescribe(loc string) (*upnpDevice, error) {
+	c := &http.Client{Timeout: 4 * time.Second}
+	resp, err := c.Get(loc)
+	if err != nil {
+		return nil, err
+	}
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	resp.Body.Close()
+	type svc struct {
+		ServiceType string `xml:"serviceType"`
+		ControlURL  string `xml:"controlURL"`
+	}
+	dec := xml.NewDecoder(bytes.NewReader(body))
+	var found *svc
+	for {
+		tok, err := dec.Token()
+		if err != nil {
+			break
+		}
+		if se, ok := tok.(xml.StartElement); ok && se.Name.Local == "service" {
+			var s svc
+			if dec.DecodeElement(&s, &se) == nil &&
+				(strings.Contains(s.ServiceType, "WANIPConnection") || strings.Contains(s.ServiceType, "WANPPPConnection")) {
+				found = &s
+				break
+			}
+		}
+	}
+	if found == nil {
+		return nil, fmt.Errorf("no WAN service")
+	}
+	base, _ := url.Parse(loc)
+	ctl, err := base.Parse(found.ControlURL)
+	if err != nil {
+		return nil, err
+	}
+	// Which local address reaches the router?
+	host := base.Hostname()
+	localIP := ""
+	if c, err := net.Dial("udp4", net.JoinHostPort(host, "1900")); err == nil {
+		localIP = c.LocalAddr().(*net.UDPAddr).IP.String()
+		c.Close()
+	}
+	return &upnpDevice{controlURL: ctl.String(), service: found.ServiceType, localIP: localIP}, nil
+}
+
+func upnpSOAP(controlURL, service, action, args string) error {
+	body := `<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" ` +
+		`s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"><s:Body><u:` + action +
+		` xmlns:u="` + service + `">` + args + `</u:` + action + `></s:Body></s:Envelope>`
+	req, err := http.NewRequest("POST", controlURL, strings.NewReader(body))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", `text/xml; charset="utf-8"`)
+	req.Header.Set("SOAPAction", `"`+service+`#`+action+`"`)
+	c := &http.Client{Timeout: 5 * time.Second}
+	resp, err := c.Do(req)
+	if err != nil {
+		return err
+	}
+	io.Copy(io.Discard, io.LimitReader(resp.Body, 1<<16))
+	resp.Body.Close()
+	if resp.StatusCode != 200 {
+		return fmt.Errorf("router refused (%d)", resp.StatusCode)
+	}
+	return nil
+}
+
+func upnpAdd(d *upnpDevice, port int, proto string) error {
+	args := fmt.Sprintf("<NewRemoteHost></NewRemoteHost><NewExternalPort>%d</NewExternalPort>"+
+		"<NewProtocol>%s</NewProtocol><NewInternalPort>%d</NewInternalPort>"+
+		"<NewInternalClient>%s</NewInternalClient><NewEnabled>1</NewEnabled>"+
+		"<NewPortMappingDescription>Castlevania Fighter Online</NewPortMappingDescription>"+
+		"<NewLeaseDuration>7200</NewLeaseDuration>", port, proto, port, d.localIP)
+	return upnpSOAP(d.controlURL, d.service, "AddPortMapping", args)
+}
+
+func upnpDelete(m upnpMapping) {
+	args := fmt.Sprintf("<NewRemoteHost></NewRemoteHost><NewExternalPort>%d</NewExternalPort>"+
+		"<NewProtocol>%s</NewProtocol>", m.port, m.proto)
+	upnpSOAP(m.controlURL, m.service, "DeletePortMapping", args)
+}
+
+func (s *cvfOnlineState) openPorts(tcpPort, udpPort int) {
+	s.mu.Lock()
+	s.upnpStatus = "Opening router port automatically..."
+	s.mu.Unlock()
+	go func() {
+		d, err := upnpDiscover()
+		if err != nil {
+			s.mu.Lock()
+			s.upnpStatus = "Router auto-setup unavailable"
+			s.mu.Unlock()
+			return
+		}
+		var maps []upnpMapping
+		var errs []string
+		try := func(p int, proto string) {
+			if p <= 0 {
+				return
+			}
+			if err := upnpAdd(d, p, proto); err != nil {
+				errs = append(errs, proto)
+			} else {
+				maps = append(maps, upnpMapping{d.controlURL, d.service, p, proto})
+			}
+		}
+		if tcpPort > 0 {
+			try(tcpPort, "TCP")
+		}
+		try(udpPort, "UDP")
+		s.mu.Lock()
+		s.upnpMapped = append(s.upnpMapped, maps...)
+		if len(errs) == 0 {
+			s.upnpStatus = "Router port opened automatically"
+		} else {
+			s.upnpStatus = "Router refused auto-setup (" + strings.Join(errs, "/") + ")"
+		}
+		s.mu.Unlock()
+	}()
+}
+
+func (s *cvfOnlineState) closePorts() {
+	s.mu.Lock()
+	maps := s.upnpMapped
+	s.upnpMapped = nil
+	s.upnpStatus = ""
+	s.mu.Unlock()
+	if len(maps) > 0 {
+		go func() {
+			for _, m := range maps {
+				upnpDelete(m)
+			}
+		}()
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Lobby client
+
+func (s *cvfOnlineState) post(path string, v any, out any) error {
+	b, _ := json.Marshal(v)
+	resp, err := s.httpClient.Post(s.lobbyURL+path, "application/json", bytes.NewReader(b))
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode/100 != 2 {
+		msg, _ := io.ReadAll(io.LimitReader(resp.Body, 512))
+		return fmt.Errorf("lobby: %s", strings.TrimSpace(string(msg)))
+	}
+	if out != nil {
+		return json.NewDecoder(io.LimitReader(resp.Body, 1<<20)).Decode(out)
+	}
+	return nil
+}
+
+func (s *cvfOnlineState) hostBegin(port, udpPort int) {
+	s.readConfig()
+	s.hostEnd()
+	s.mu.Lock()
+	s.hosting, s.hostPort = true, port
+	s.roomID, s.roomToken, s.roomOpen, s.lobbyHostErr = "", "", "", ""
+	stop := make(chan struct{})
+	s.hostStop = stop
+	name, lobby, tag := s.playerName, s.lobbyURL, s.buildTag
+	s.mu.Unlock()
+
+	s.fetchPublicIP()
+	s.openPorts(port, udpPort)
+
+	if lobby == "" {
+		return
+	}
+	if name == "" {
+		name = "Player"
+	}
+	go func() {
+		// Give UPnP a moment so the lobby's reachability check sees the open port.
+		select {
+		case <-stop:
+			return
+		case <-time.After(3 * time.Second):
+		}
+		var r struct {
+			ID    string `json:"id"`
+			Token string `json:"token"`
+			IP    string `json:"ip"`
+		}
+		for {
+			err := s.post("/api/rooms", map[string]any{"name": name, "port": port, "udp_port": udpPort, "version": tag}, &r)
+			if err == nil {
+				break
+			}
+			s.mu.Lock()
+			s.lobbyHostErr = "Lobby unreachable, retrying"
+			s.mu.Unlock()
+			select {
+			case <-stop:
+				return
+			case <-time.After(10 * time.Second):
+			}
+		}
+		s.mu.Lock()
+		s.lobbyHostErr = ""
+		if s.hostStop != stop {
+			s.mu.Unlock()
+			s.post("/api/rooms/"+r.ID+"/leave", map[string]string{"token": r.Token}, nil)
+			return
+		}
+		s.roomID, s.roomToken = r.ID, r.Token
+		if r.IP != "" && s.publicIP == "" {
+			s.publicIP = r.IP
+		}
+		s.mu.Unlock()
+		t := time.NewTicker(10 * time.Second)
+		defer t.Stop()
+		for {
+			var hb struct {
+				Open string `json:"open"`
+			}
+			err := s.post("/api/rooms/"+r.ID+"/heartbeat", map[string]string{"token": r.Token}, &hb)
+			s.mu.Lock()
+			if err == nil {
+				s.roomOpen = hb.Open
+				s.lobbyHostErr = ""
+			}
+			s.mu.Unlock()
+			select {
+			case <-stop:
+				s.post("/api/rooms/"+r.ID+"/leave", map[string]string{"token": r.Token}, nil)
+				return
+			case <-t.C:
+			}
+		}
+	}()
+}
+
+func (s *cvfOnlineState) hostEnd() {
+	s.mu.Lock()
+	if s.hostStop != nil {
+		close(s.hostStop)
+		s.hostStop = nil
+	}
+	s.hosting = false
+	s.roomID, s.roomToken, s.roomOpen = "", "", ""
+	s.mu.Unlock()
+}
+
+func (s *cvfOnlineState) hostStatus() string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	var b strings.Builder
+	b.WriteString("Waiting for an opponent...\n\n")
+	pub := s.publicIP
+	if pub == "" {
+		if s.publicIPErr != "" {
+			pub = "(could not detect)"
+		} else {
+			pub = "(detecting...)"
+		}
+	}
+	fmt.Fprintf(&b, "Internet address: %s   Port: %d\n", pub, s.hostPort)
+	if ips := cvfLocalIPs(); len(ips) > 0 {
+		fmt.Fprintf(&b, "Same network (LAN): %s\n", strings.Join(ips, ", "))
+	}
+	if s.upnpStatus != "" {
+		b.WriteString(s.upnpStatus + "\n")
+		if strings.HasPrefix(s.upnpStatus, "Router auto-setup unavailable") || strings.HasPrefix(s.upnpStatus, "Router refused") {
+			fmt.Fprintf(&b, "If nobody can join: forward TCP+UDP %d on your router\nor use a VPN like Tailscale.\n", s.hostPort)
+		}
+	}
+	switch {
+	case s.lobbyURL == "":
+		b.WriteString("\nShare your Internet address with your opponent.\n")
+	case s.lobbyHostErr != "":
+		b.WriteString("\n" + s.lobbyHostErr + " - share your address instead.\n")
+	case s.roomID == "":
+		b.WriteString("\nListing you in the lobby...\n")
+	default:
+		fmt.Fprintf(&b, "\nListed in the lobby as \"%s\"\n", s.playerName)
+		b.WriteString("Other players can now pick you in Online > Lobby.\n")
+	}
+	b.WriteString("\nPress Esc to stop hosting.")
+	return b.String()
+}
+
+func (s *cvfOnlineState) refreshRooms() {
+	s.readConfig()
+	s.mu.Lock()
+	if s.roomsBusy || s.lobbyURL == "" {
+		if s.lobbyURL == "" {
+			s.roomsErr = "No lobby server configured (data/cvf_online.ini)"
+		}
+		s.mu.Unlock()
+		return
+	}
+	s.roomsBusy = true
+	if s.roomsFetched.IsZero() {
+		s.roomsErr = "Connecting to the lobby (can take up to a minute)..."
+	}
+	s.mu.Unlock()
+	go func() {
+		resp, err := s.httpClient.Get(s.lobbyURL + "/api/rooms")
+		var rooms []cvfRoom
+		if err == nil {
+			if resp.StatusCode == 200 {
+				err = json.NewDecoder(io.LimitReader(resp.Body, 1<<20)).Decode(&rooms)
+			} else {
+				err = fmt.Errorf("status %d", resp.StatusCode)
+			}
+			resp.Body.Close()
+		}
+		s.mu.Lock()
+		s.roomsBusy = false
+		if err != nil {
+			s.roomsErr = "Lobby unreachable, retrying..."
+		} else {
+			sort.SliceStable(rooms, func(i, j int) bool { return rooms[i].AgeSec < rooms[j].AgeSec })
+			s.rooms, s.roomsErr, s.roomsFetched = rooms, "", time.Now()
+		}
+		s.mu.Unlock()
+	}()
+}
+
+var cvfNameRe = regexp.MustCompile(`[^\p{L}\p{N} _.\-!?']`)
+
+func cvfCleanName(n string) string {
+	n = strings.TrimSpace(cvfNameRe.ReplaceAllString(n, ""))
+	if r := []rune(n); len(r) > 20 {
+		n = string(r[:20])
+	}
+	return n
+}
