+-- CvF Nearby: list players hosting on the same Wi-Fi or hotspot and join one
+function main.f_nearbyJoin()
+	local sel = 1
+	local ts = motif.title_info.connecting.TextSpriteData
+	cvfNearbyScanBegin()
+	resetKey()
+	while true do
+		local hosts, status = cvfNearbyHosts()
+		if sel > #hosts then sel = math.max(1, #hosts) end
+		if esc() or getInput(-1, motif[main.group].menu.cancel.key) then
+			sndPlay(motif.Snd, motif[main.group].cancel.snd[1], motif[main.group].cancel.snd[2])
+			cvfNearbyScanEnd()
+			return
+		elseif #hosts > 0 and getInput(-1, motif[main.group].menu.next.key) then
+			sel = sel % #hosts + 1
+			sndPlay(motif.Snd, motif[main.group].cursor.move.snd[1], motif[main.group].cursor.move.snd[2])
+		elseif #hosts > 0 and getInput(-1, motif[main.group].menu.previous.key) then
+			sel = (sel - 2) % #hosts + 1
+			sndPlay(motif.Snd, motif[main.group].cursor.move.snd[1], motif[main.group].cursor.move.snd[2])
+		elseif #hosts > 0 and getInput(-1, motif[main.group].menu.done.key) then
+			local h = hosts[sel]
+			sndPlay(motif.Snd, motif[main.group].cursor.done.snd.default[1], motif[main.group].cursor.done.snd.default[2])
+			cvfNearbyScanEnd()
+			main.f_waitForPreloads(true)
+			local oldPort = cvfGetNetplayPort()
+			local oldRollback = cvfGetRollbackPort()
+			local ip, port = h.ip, h.port
+			if h.direct then
+				-- iPhone/iPad direct link: the app relays the match through this device
+				local tcp, udp = cvfNearbyDirectJoin(h.id)
+				if tcp ~= nil then
+					ip, port = '127.0.0.1', tcp
+					cvfSetRollbackPort(udp)
+				else
+					ip = nil
+				end
+			end
+			local ok = false
+			if ip ~= nil then
+				cvfSetNetplayPort(port)
+				main.cvfNearby = true
+				ok = main.f_connect(ip, h.name)
+				main.cvfNearby = false
+			end
+			if ok then
+				if synchronize() then
+					enterSyncedNetplayMenu()
+				end
+				replayStop()
+				exitNetPlay()
+				exitReplay()
+				showSessionWarning()
+			end
+			cvfSetNetplayPort(oldPort)
+			cvfSetRollbackPort(oldRollback)
+			if h.direct then
+				cvfNearbyDirectClose()
+			end
+			cvfNearbyScanBegin()
+			resetKey()
+		end
+		-- draw
+		clearColor(motif[main.background].bgclearcolor[1], motif[main.background].bgclearcolor[2], motif[main.background].bgclearcolor[3])
+		bgDraw(motif[main.background].BGDef, 0)
+		rectDraw(motif.title_info.connecting.overlay.RectData)
+		local lines = {'NEARBY  -  players close to you', ''}
+		if #hosts == 0 then
+			table.insert(lines, status ~= '' and status or 'Searching...')
+			table.insert(lines, '')
+			table.insert(lines, 'The other player picks Online > Host Nearby.')
+			table.insert(lines, '')
+			table.insert(lines, cvfNearbyHint())
+		else
+			local first = math.max(1, math.min(sel - 4, #hosts - 8))
+			for i = first, math.min(#hosts, first + 8) do
+				local h = hosts[i]
+				local tag = h.compatible and '' or '  (different version)'
+				table.insert(lines, (i == sel and '> ' or '   ') .. h.name .. tag)
+			end
+		end
+		table.insert(lines, '')
+		table.insert(lines, main.f_cvfListHelp())
+		textImgReset(ts)
+		textImgSetPos(ts, nil, 40)
+		textImgSetText(ts, table.concat(lines, '\n'))
+		textImgDraw(ts)
+		bgDraw(motif[main.background].BGDef, 1)
+		refresh()
+	end
+end
+
+-- CvF Online: lobby screen listing players who are hosting
+function main.f_lobby()
+	if not cvfLobbyEnabled() then
+		return
+	end
+	if not main.f_cvfEnsureName() then
+		return
+	end
+	local sel = 1
+	local frame = 0
+	local lastRefresh = -10000
+	local ts = motif.title_info.connecting.TextSpriteData
+	resetKey()
+	while true do
+		frame = frame + 1
+		if frame - lastRefresh >= 180 then
+			cvfLobbyRefresh()
+			lastRefresh = frame
+		end
+		local rooms, status = cvfLobbyRooms()
+		if sel > #rooms then sel = math.max(1, #rooms) end
+		if esc() or getInput(-1, motif[main.group].menu.cancel.key) then
+			sndPlay(motif.Snd, motif[main.group].cancel.snd[1], motif[main.group].cancel.snd[2])
+			return
+		elseif #rooms > 0 and getInput(-1, motif[main.group].menu.next.key) then
+			sel = sel % #rooms + 1
+			sndPlay(motif.Snd, motif[main.group].cursor.move.snd[1], motif[main.group].cursor.move.snd[2])
+		elseif #rooms > 0 and getInput(-1, motif[main.group].menu.previous.key) then
+			sel = (sel - 2) % #rooms + 1
+			sndPlay(motif.Snd, motif[main.group].cursor.move.snd[1], motif[main.group].cursor.move.snd[2])
+		elseif #rooms > 0 and getInput(-1, motif[main.group].menu.done.key) then
+			local r = rooms[sel]
+			sndPlay(motif.Snd, motif[main.group].cursor.done.snd.default[1], motif[main.group].cursor.done.snd.default[2])
+			main.f_waitForPreloads(true)
+			local oldPort = cvfGetNetplayPort()
+			cvfSetNetplayPort(r.port)
+			if main.f_connect(r.ip, r.name) then
+				if synchronize() then
+					enterSyncedNetplayMenu()
+				end
+				replayStop()
+				exitNetPlay()
+				exitReplay()
+				showSessionWarning()
+			end
+			cvfSetNetplayPort(oldPort)
+			lastRefresh = -10000
+			resetKey()
+		end
+		-- draw
+		clearColor(motif[main.background].bgclearcolor[1], motif[main.background].bgclearcolor[2], motif[main.background].bgclearcolor[3])
+		bgDraw(motif[main.background].BGDef, 0)
+		rectDraw(motif.title_info.connecting.overlay.RectData)
+		local lines = {'ONLINE LOBBY  -  you are "' .. cvfGetPlayerName() .. '"', ''}
+		if #rooms == 0 then
+			table.insert(lines, status ~= '' and status or 'Nobody is hosting right now.')
+			table.insert(lines, '')
+			table.insert(lines, 'Pick Host Game to wait here for an opponent.')
+		else
+			table.insert(lines, 'Players waiting for a match:')
+			table.insert(lines, '')
+			local first = math.max(1, math.min(sel - 4, #rooms - 8))
+			for i = first, math.min(#rooms, first + 8) do
+				local r = rooms[i]
+				local wait = r.age < 60 and (r.age .. 's') or (math.floor(r.age / 60) .. 'm')
+				local tag = r.compatible and '' or '  (different version)'
+				table.insert(lines, (i == sel and '> ' or '   ') .. r.name .. '   waiting ' .. wait .. tag)
+			end
+			if status ~= '' then
+				table.insert(lines, '')
+				table.insert(lines, status)
+			end
+		end
+		table.insert(lines, '')
+		table.insert(lines, main.f_cvfListHelp())
+		textImgReset(ts)
+		textImgSetPos(ts, nil, 40)
+		textImgSetText(ts, table.concat(lines, '\n'))
+		textImgDraw(ts)
+		bgDraw(motif[main.background].BGDef, 1)
+		refresh()
+	end
+end
