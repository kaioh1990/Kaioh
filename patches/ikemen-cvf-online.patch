@@ -0,0 +1,34 @@
+//go:build ios
+
+package main
+
+// Functions the iOS app calls for the Nearby direct link (see cvf_p2p_ios.go).
+// Kept apart because a file with //export may only declare C in its preamble.
+
+/*
+#include <stdlib.h>
+*/
+import "C"
+import "unsafe"
+
+// The app hands over its relay functions (a CvfP2PFuncs struct) at startup.
+//
+//export CvfP2PRegister
+func CvfP2PRegister(funcs unsafe.Pointer) {
+	cvfP2PSetFuncs(funcs)
+}
+
+// Called by the app whenever the list of hosts it can reach directly changes.
+// json: [{"id":"...","name":"...","ver":"...","rp":7500}, ...]
+//
+//export CvfP2PPeers
+func CvfP2PPeers(json *C.char) {
+	cvfNearby.setP2P(C.GoString(json))
+}
+
+// The player's answer from the app's name box ("" if cancelled).
+//
+//export CvfNameEntered
+func CvfNameEntered(name *C.char) {
+	cvfNameAskDone(C.GoString(name))
+}
diff --git a/src/cvf_p2p_ios.go b/src/cvf_p2p_ios.go
new file mode 100644
index 00000000..574af3b5
--- /dev/null
+++ b/src/cvf_p2p_ios.go
@@ -0,0 +1,69 @@
+//go:build ios
+
+package main
+
+// iPhone/iPad direct link for Nearby play (Apple peer-to-peer Wi-Fi, the link AirDrop uses).
+// The radio side lives in the app (CvfP2P.m, Network.framework); it relays the normal
+// netplay TCP connection and rollback UDP packets through 127.0.0.1, so the engine's
+// netcode is unchanged. The app registers its functions at startup (CvfP2PRegister in
+// cvf_p2p_export_ios.go); until then these calls do nothing.
+
+/*
+#include <stdlib.h>
+typedef struct {
+	void (*advertise)(const char *instance, const char *name, const char *ver, int tcpPort, int udpPort);
+	void (*advertiseStop)(void);
+	void (*browse)(int on);
+	int (*join)(const char *instance, int localTcp, int localUdp);
+	void (*close)(void);
+	void (*askName)(const char *suggestion);
+} CvfP2PFuncs;
+static CvfP2PFuncs cvfP2PFn;
+static void cvfP2PSet(CvfP2PFuncs *f) { cvfP2PFn = *f; }
+static int cvfP2PHave(void) { return cvfP2PFn.join != NULL; }
+static void cvfP2PAdvertiseC(const char *i, const char *n, const char *v, int t, int u) { if (cvfP2PFn.advertise) cvfP2PFn.advertise(i, n, v, t, u); }
+static void cvfP2PAdvertiseStopC(void) { if (cvfP2PFn.advertiseStop) cvfP2PFn.advertiseStop(); }
+static void cvfP2PBrowseC(int on) { if (cvfP2PFn.browse) cvfP2PFn.browse(on); }
+static int cvfP2PJoinC(const char *i, int t, int u) { return cvfP2PFn.join ? cvfP2PFn.join(i, t, u) : 0; }
+static void cvfP2PCloseC(void) { if (cvfP2PFn.close) cvfP2PFn.close(); }
+static int cvfAskNameC(const char *s) { if (!cvfP2PFn.askName) return 0; cvfP2PFn.askName(s); return 1; }
+*/
+import "C"
+import "unsafe"
+
+const cvfP2PAvailable = true
+
+func cvfP2PSetFuncs(f unsafe.Pointer) { C.cvfP2PSet((*C.CvfP2PFuncs)(f)) }
+
+func cvfP2PAdvertise(id, name, ver string, tcpPort, udpPort int) {
+	ci, cn, cv := C.CString(id), C.CString(name), C.CString(ver)
+	defer C.free(unsafe.Pointer(ci))
+	defer C.free(unsafe.Pointer(cn))
+	defer C.free(unsafe.Pointer(cv))
+	C.cvfP2PAdvertiseC(ci, cn, cv, C.int(tcpPort), C.int(udpPort))
+}
+
+func cvfP2PAdvertiseStop() { C.cvfP2PAdvertiseStopC() }
+
+func cvfP2PBrowse(on bool) {
+	v := 0
+	if on {
+		v = 1
+	}
+	C.cvfP2PBrowseC(C.int(v))
+}
+
+func cvfP2PJoin(id string, localTcp, localUdp int) bool {
+	ci := C.CString(id)
+	defer C.free(unsafe.Pointer(ci))
+	return C.cvfP2PJoinC(ci, C.int(localTcp), C.int(localUdp)) != 0
+}
+
+func cvfP2PClose() { C.cvfP2PCloseC() }
+
+// Opens the app's name box. False if the app has none.
+func cvfNativeAskName(suggestion string) bool {
+	cs := C.CString(suggestion)
+	defer C.free(unsafe.Pointer(cs))
+	return C.cvfAskNameC(cs) != 0
+}
