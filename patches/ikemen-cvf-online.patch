+// ---------------------------------------------------------------------------
+// Gameplay rules for the online port (data/cvf_online.ini). They must be identical
+// for both players, so they are read once at startup from the shared game folder.
+//
+//   MaxAttackInvincibility = N  cap NotHitBy/HitBy granted during attack states to the
+//                               first N frames of the state (0 = off)
+//   InvincibilityExemptStates = 1000-1099   states that keep their invincibility
+//   MPVar = 34                  variable holding MP
+//   MPGainScale = 0.5           multiply every MP gain (fractions carry over)
+//   RulesAuthor = CvF           only characters with this author are affected
+
+type cvfRulesT struct {
+	loaded       bool
+	iframeCap    int32
+	exemptLo     int32
+	exemptHi     int32
+	mpVar        int32
+	mpScaleMilli int32
+	author       string
+}
+
+var cvfRules = cvfRulesT{exemptLo: 1000, exemptHi: 1099, mpVar: -1, mpScaleMilli: 1000}
+
+func cvfRulesLoad() *cvfRulesT {
+	r := &cvfRules
+	if r.loaded {
+		return r
+	}
+	r.loaded = true
+	f, err := os.Open(cvfOnlineConfigFile)
+	if err != nil {
+		return r
+	}
+	defer f.Close()
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		line := sc.Text()
+		if i := strings.Index(line, ";"); i >= 0 {
+			line = line[:i]
+		}
+		k, v, ok := strings.Cut(line, "=")
+		if !ok {
+			continue
+		}
+		k, v = strings.ToLower(strings.TrimSpace(k)), strings.TrimSpace(v)
+		switch k {
+		case "maxattackinvincibility":
+			fmt.Sscan(v, &r.iframeCap)
+		case "invincibilityexemptstates":
+			var lo, hi int32
+			if n, _ := fmt.Sscanf(strings.ReplaceAll(v, " ", ""), "%d-%d", &lo, &hi); n == 2 {
+				r.exemptLo, r.exemptHi = lo, hi
+			}
+		case "mpvar":
+			fmt.Sscan(v, &r.mpVar)
+		case "mpgainscale":
+			var s float64
+			if _, err := fmt.Sscan(v, &s); err == nil && s >= 0 && s <= 10 {
+				r.mpScaleMilli = int32(s*1000 + 0.5)
+			}
+		case "rulesauthor":
+			r.author = strings.ToLower(v)
+		}
+	}
+	return r
+}
+
+func (r *cvfRulesT) appliesTo(c *Char) bool {
+	if c == nil || c.helperIndex != 0 {
+		return false
+	}
+	return r.author == "" || c.gi().authorLow == r.author
+}
+
+// Clamp the duration of a NotHitBy/HitBy set while attacking. Returns false to skip it.
+func cvfClampInvincibility(c *Char, time *int32) bool {
+	r := cvfRulesLoad()
+	if r.iframeCap <= 0 || c.ss.moveType != MT_A || !r.appliesTo(c) {
+		return true
+	}
+	if c.ss.no >= r.exemptLo && c.ss.no <= r.exemptHi {
+		return true
+	}
+	remaining := r.iframeCap - c.ss.time
+	cvfDebugf("iframes %s state %d time %d remaining %d", c.name, c.ss.no, c.ss.time, remaining)
+	if remaining <= 0 {
+		return false
+	}
+	if *time < 0 || *time > remaining {
+		*time = remaining
+	}
+	return true
+}
+
+// Scale positive MP gains; the fractional part is kept in c.cvfMPRem (part of rollback state).
+func cvfScaleMPGain(c *Char, i, v int32) int32 {
+	r := cvfRulesLoad()
+	if v <= 0 || i != r.mpVar || r.mpScaleMilli == 1000 || !r.appliesTo(c) {
+		return v
+	}
+	cvfDebugf("mp gain %s +%d", c.name, v)
+	total := v*r.mpScaleMilli + c.cvfMPRem
+	c.cvfMPRem = total % 1000
+	return total / 1000
+}
+
+var cvfDebugOn = os.Getenv("CVF_RULES_DEBUG") != ""
+var cvfDebugCount int
+
+func cvfDebugf(format string, args ...any) {
+	if cvfDebugOn && cvfDebugCount < 200 {
+		cvfDebugCount++
+		fmt.Fprintf(os.Stderr, "[cvf] "+format+"\n", args...)
+	}
+}
