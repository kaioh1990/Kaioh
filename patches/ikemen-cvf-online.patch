+--returns the selectable cell under a touch, in screenpack coordinates
+function start.f_touchCell(x, y)
+	local size = motif.select_info.cell.size
+	for row, cols in ipairs(start.t_grid) do
+		for col, c in ipairs(cols) do
+			local cx = motif.select_info.pos[1] + c.x
+			local cy = motif.select_info.pos[2] + c.y
+			if x >= cx and x < cx + size[1] and y >= cy and y < cy + size[2] then
+				if c.char ~= nil and c.skip ~= 1 and c.hidden ~= 2 then
+					return col - 1, row - 1
+				end
+				return nil
+			end
+		end
+	end
+	return nil
+end
