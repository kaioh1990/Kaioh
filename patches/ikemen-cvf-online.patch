+// ---------------------------------------------------------------------------
+// Gameplay rules for the online port (data/cvf_online.ini). They must be identical
+// for both players, so they are read once at startup from the shared game folder.
+//
+//   MaxAttackInvincibility = N  cap NotHitBy/HitBy granted during attack states to the
+//                               first N frames of the state (0 = off)
+//   InvincibilityExemptStates = 1000-1099   states that keep their invincibility
+//   MPVar = 34                  variable holding MP
+//   MPGainScale = 0.5           multiply every MP gain (fractions carry over)
+//   SpecialCooldown = N         frames after a special attack before another can start (0 = off)
+//   SpecialStates = 1100-2999   the states that count as special attacks
+//   FightAspect = 16:9          aspect ratio of fights, or "stage" for the stage's own
+//   WideView = 1                display only: fill wider screens with more of the stage
+//   RulesAuthor = CvF           only characters with this author are affected
+
+type cvfRulesT struct {
+	loaded       bool
+	iframeCap    int32
+	exemptLo     int32
+	exemptHi     int32
+	mpVar        int32
+	mpScaleMilli int32
+	specialCD    int32
+	specialLo    int32
+	specialHi    int32
+	fightAspect  [2]int32
+	wideView     bool
+	author       string
+}
+
+var cvfRules = cvfRulesT{exemptLo: 1000, exemptHi: 1099, mpVar: -1, mpScaleMilli: 1000, specialLo: 1100, specialHi: 2999}
+
+func cvfRulesLoad() *cvfRulesT {
+	r := &cvfRules
+	if r.loaded {
+		return r
+	}
+	r.loaded = true
+	f, err := os.Open(cvfOnlineConfigFile)
+	if err != nil {
+		return r
+	}
+	defer f.Close()
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		line := sc.Text()
+		if i := strings.Index(line, ";"); i >= 0 {
+			line = line[:i]
+		}
+		k, v, ok := strings.Cut(line, "=")
+		if !ok {
+			continue
+		}
+		k, v = strings.ToLower(strings.TrimSpace(k)), strings.TrimSpace(v)
+		switch k {
+		case "maxattackinvincibility":
+			fmt.Sscan(v, &r.iframeCap)
+		case "invincibilityexemptstates":
+			var lo, hi int32
+			if n, _ := fmt.Sscanf(strings.ReplaceAll(v, " ", ""), "%d-%d", &lo, &hi); n == 2 {
+				r.exemptLo, r.exemptHi = lo, hi
+			}
+		case "mpvar":
+			fmt.Sscan(v, &r.mpVar)
+		case "mpgainscale":
+			var s float64
+			if _, err := fmt.Sscan(v, &s); err == nil && s >= 0 && s <= 10 {
+				r.mpScaleMilli = int32(s*1000 + 0.5)
+			}
+		case "specialcooldown":
+			fmt.Sscan(v, &r.specialCD)
+		case "specialstates":
+			var lo, hi int32
+			if n, _ := fmt.Sscanf(strings.ReplaceAll(v, " ", ""), "%d-%d", &lo, &hi); n == 2 {
+				r.specialLo, r.specialHi = lo, hi
+			}
+		case "wideview":
+			r.wideView = v == "1" || strings.EqualFold(v, "true")
+		case "fightaspect":
+			if strings.EqualFold(v, "stage") {
+				r.fightAspect = [2]int32{-1, -1}
+			} else {
+				fmt.Sscanf(strings.ReplaceAll(v, " ", ""), "%d:%d", &r.fightAspect[0], &r.fightAspect[1])
+			}
+		case "rulesauthor":
+			r.author = strings.ToLower(v)
+		}
+	}
+	return r
+}
+
+func (r *cvfRulesT) appliesTo(c *Char) bool {
+	if c == nil || c.helperIndex != 0 {
+		return false
+	}
+	return r.author == "" || c.gi().authorLow == r.author
+}
+
+// Clamp the duration of a NotHitBy/HitBy set while attacking. Returns false to skip it.
+func cvfClampInvincibility(c *Char, time *int32) bool {
+	r := cvfRulesLoad()
+	if r.iframeCap <= 0 || c.ss.moveType != MT_A || !r.appliesTo(c) {
+		return true
+	}
+	if c.ss.no >= r.exemptLo && c.ss.no <= r.exemptHi {
+		return true
+	}
+	remaining := r.iframeCap - c.ss.time
+	cvfDebugf("iframes %s state %d time %d remaining %d", c.name, c.ss.no, c.ss.time, remaining)
+	if remaining <= 0 {
+		return false
+	}
+	if *time < 0 || *time > remaining {
+		*time = remaining
+	}
+	return true
+}
+
+// Touch taps for screens that read them directly (character select). The screen polls
+// every frame, so an old poll means nothing is listening and the app sends a confirm instead.
+var cvfTap struct {
+	x, y    float32
+	pending bool
+	polled  int32
+	used    bool
+}
+
+// False while a physical controller is connected: only direct taps on elements count.
+var cvfTouchMenus = true
+
+// x and y are 0-1 across the game view. Returns false if no screen is listening.
+func cvfStoreTap(x, y float32) bool {
+	if !cvfTap.used || sys.frameCounter-cvfTap.polled > 5 {
+		return false
+	}
+	gameWidth := 240 * sys.getMotifAspect()
+	cvfTap.x, cvfTap.y = x*gameWidth-(gameWidth-320)/2, y*240
+	cvfTap.pending = true
+	return true
+}
+
+// Physical screen size, passed in by the iOS app.
+var cvfScreen [2]int32
+
+func cvfParseScreen(s string) {
+	fmt.Sscanf(s, "%dx%d", &cvfScreen[0], &cvfScreen[1])
+}
+
+// Applies the shared fight aspect, which affects gameplay and must match between players,
+// and fits the menus to screens wider than 16:9. Game size outside fights is display only.
+func cvfApplyDisplay(cfg *Config) {
+	if a := cvfRulesLoad().fightAspect; a[0] != 0 && a[1] != 0 {
+		cfg.Video.FightAspectWidth, cfg.Video.FightAspectHeight = a[0], a[1]
+	}
+	// Menus match the screen's shape: wider on long phones, narrower (down to 4:3) on
+	// squarer screens, so neither gets black bars.
+	if w, h := cvfScreen[0], cvfScreen[1]; h > 0 && w*9 != h*16 {
+		gw := cfg.Video.GameHeight * w / h
+		if minW := cfg.Video.GameHeight * 4 / 3; gw < minW {
+			gw = minW
+		}
+		cfg.Video.GameWidth = gw &^ 1
+	}
+}
+
+// Wide view: gameplay keeps the shared fight width (walls, camera, screen triggers), and
+// each device draws the scene at its own screen width, showing more of the stage on the
+// sides. renderFrame already draws at screen size for overlays; this only removes the
+// clip and black bars during fights. Nothing here touches game state, so rollback is
+// unaffected and players can use different screens.
+func (s *System) cvfWideView() bool {
+	return cvfRulesLoad().wideView && s.middleOfMatch() && s.stage != nil &&
+		s.cfg.Video.KeepAspect && s.getFightAspect() < s.getMotifAspect()
+}
+
+// Keeps the wider view inside the stage art. XMin/XMax are the furthest edges visible
+// at the shared fight width, which is what stages are drawn to cover. If the art is
+// narrower than the screen, the view centres on it.
+func (s *System) cvfClampWideView(x, scl float32) float32 {
+	if scl <= 0 || s.cam.BaseScale() <= 0 {
+		return x
+	}
+	half := s.gameWidth / 2 / (scl * s.cam.BaseScale())
+	lo, hi := s.cam.XMin+half, s.cam.XMax-half
+	if lo > hi {
+		return (s.cam.XMin + s.cam.XMax) / 2
+	}
+	return Clamp(x, lo, hi)
+}
+
+// Count down the wait between special attacks. It restarts on every frame spent in a
+// special attack, so it runs from the end of the move. Stored on Char, so it rolls back.
+func cvfSpecialTick(c *Char) {
+	r := cvfRulesLoad()
+	if r.specialCD <= 0 || !r.appliesTo(c) {
+		return
+	}
+	if c.ss.moveType == MT_A && c.ss.no >= r.specialLo && c.ss.no <= r.specialHi {
+		c.cvfSpecialCD = r.specialCD
+	} else if c.cvfSpecialCD > 0 && !c.hitPause() {
+		c.cvfSpecialCD--
+	}
+}
+
+// True when a ChangeState would start a new special attack during the wait.
+// Moving between states of the same move is allowed, and so is anything but an attack.
+func cvfBlockSpecial(c *Char, no int32) bool {
+	r := cvfRulesLoad()
+	if c.cvfSpecialCD <= 0 || no < r.specialLo || no > r.specialHi || !r.appliesTo(c) {
+		return false
+	}
+	if c.ss.no >= r.specialLo && c.ss.no <= r.specialHi {
+		return false
+	}
+	st, ok := sys.cgi[c.ss.sb.playerNo].states[no]
+	if !ok || st.moveType != MT_A {
+		return false
+	}
+	cvfDebugf("special blocked %s state %d, %d frames left", c.name, no, c.cvfSpecialCD)
+	return true
+}
+
+// Scale positive MP gains; the fractional part is kept in c.cvfMPRem (part of rollback state).
+func cvfScaleMPGain(c *Char, i, v int32) int32 {
+	r := cvfRulesLoad()
+	if v <= 0 || i != r.mpVar || r.mpScaleMilli == 1000 || !r.appliesTo(c) {
+		return v
+	}
+	cvfDebugf("mp gain %s +%d", c.name, v)
+	total := v*r.mpScaleMilli + c.cvfMPRem
+	c.cvfMPRem = total % 1000
+	return total / 1000
+}
+
+var cvfDebugOn = os.Getenv("CVF_RULES_DEBUG") != ""
+var cvfDebugCount int
+
+func cvfDebugf(format string, args ...any) {
+	if cvfDebugOn && cvfDebugCount < 200 {
+		cvfDebugCount++
+		fmt.Fprintf(os.Stderr, "[cvf] "+format+"\n", args...)
+	}
+}
diff --git a/src/cvf_sound_lazy.go b/src/cvf_sound_lazy.go
new file mode 100644
index 00000000..c3ac2b6d
--- /dev/null
+++ b/src/cvf_sound_lazy.go
@@ -0,0 +1,144 @@
+package main
+
+// CvF Online: on-demand loading of .snd sounds.
+//
+// Ikemen normally reads every sound of every .snd file into memory when a
+// character or the fight screen loads. Castlevania Fighter's shared sound
+// bank (data/Xsound.snd) is 687 MB of uncompressed WAVs, which made one match
+// use ~700 MB of RAM - too much for the PS Vita and wasteful everywhere else.
+// Now only each sound's header is read at load time; the samples are read the
+// first time the sound plays and kept in a size-capped LRU cache.
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"strconv"
+	"sync"
+
+	"github.com/ikemen-engine/beep/v2/wav"
+)
+
+type lazySound struct {
+	filename string
+	offset   int64
+	size     uint32
+	state    int8 // 0 = not loaded, 1 = loaded, -1 = corrupted
+	lastUse  uint64
+}
+
+var cvfLazy struct {
+	sync.Mutex
+	loaded  []*Sound
+	bytes   int64
+	tick    uint64
+	limit   int64
+	enabled int8 // 0 unknown, 1 on, -1 off
+}
+
+// CVF_LAZY_SOUNDS=0 restores the original behaviour; CVF_SOUND_CACHE_MB sets the cache size.
+func cvfLazySoundsEnabled() bool {
+	if cvfLazy.enabled == 0 {
+		cvfLazy.enabled = 1
+		if os.Getenv("CVF_LAZY_SOUNDS") == "0" {
+			cvfLazy.enabled = -1
+		}
+		cvfLazy.limit = 96 << 20
+		if mb, err := strconv.Atoi(os.Getenv("CVF_SOUND_CACHE_MB")); err == nil && mb > 0 {
+			cvfLazy.limit = int64(mb) << 20
+		}
+	}
+	return cvfLazy.enabled == 1
+}
+
+// newLazySound reads only the WAV header at f's current position.
+func newLazySound(f io.ReadSeeker, filename string, offset int64, size uint32) (*Sound, error) {
+	hdrLen := uint32(4096)
+	if size < hdrLen {
+		hdrLen = size
+	}
+	hdr := make([]byte, hdrLen)
+	if _, err := io.ReadFull(f, hdr); err != nil {
+		return nil, err
+	}
+	snd := &Sound{lazy: &lazySound{filename: filename, offset: offset, size: size}}
+	if st, wavfmt, err := wav.Decode(bytes.NewReader(hdr)); err == nil {
+		snd.format = wavfmt
+		snd.length = st.Len()
+	} else {
+		// Unusual header layout: load it fully now, like before.
+		if !snd.ensureLoaded() {
+			return nil, nil
+		}
+	}
+	return snd, nil
+}
+
+// ensureLoaded makes sure the samples are in memory. Returns false if the
+// sound can't be played.
+func (s *Sound) ensureLoaded() bool {
+	l := s.lazy
+	if l == nil {
+		return s.wavData != nil
+	}
+	cvfLazy.Lock()
+	defer cvfLazy.Unlock()
+	switch l.state {
+	case 1:
+		return true
+	case -1:
+		return false
+	}
+	f, err := OpenFile(l.filename)
+	if err != nil {
+		l.state = -1
+		return false
+	}
+	defer f.Close()
+	if _, err := f.Seek(l.offset, io.SeekStart); err != nil {
+		l.state = -1
+		return false
+	}
+	full, err := readSound(f, l.size)
+	if err != nil || full == nil {
+		l.state = -1
+		return false
+	}
+	s.wavData, s.format, s.length = full.wavData, full.format, full.length
+	l.state = 1
+	cvfLazy.tick++
+	l.lastUse = cvfLazy.tick
+	cvfLazy.loaded = append(cvfLazy.loaded, s)
+	cvfLazy.bytes += int64(len(s.wavData))
+	cvfEvictSounds()
+	return true
+}
+
+func (s *Sound) lazyTouch() {
+	if s.lazy == nil {
+		return
+	}
+	cvfLazy.Lock()
+	cvfLazy.tick++
+	s.lazy.lastUse = cvfLazy.tick
+	cvfLazy.Unlock()
+}
+
+// cvfEvictSounds drops the samples of the least recently used sounds until the
+// cache fits. A channel that is still playing an evicted sound keeps its own
+// reference to the data, so nothing is cut off. Caller holds the lock.
+func cvfEvictSounds() {
+	for cvfLazy.bytes > cvfLazy.limit && len(cvfLazy.loaded) > 1 {
+		oldest := 0
+		for i, s := range cvfLazy.loaded {
+			if s.lazy.lastUse < cvfLazy.loaded[oldest].lazy.lastUse {
+				oldest = i
+			}
+		}
+		s := cvfLazy.loaded[oldest]
+		cvfLazy.bytes -= int64(len(s.wavData))
+		s.wavData = nil
+		s.lazy.state = 0
+		cvfLazy.loaded = append(cvfLazy.loaded[:oldest], cvfLazy.loaded[oldest+1:]...)
+	}
+}
