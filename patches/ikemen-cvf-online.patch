new file mode 100644
index 00000000..6323a306
--- /dev/null
+++ b/src/cvf_nearby.go
@@ -0,0 +1,605 @@
+package main
+
+// Castlevania Fighter "Nearby" play: two devices on the same local network play without
+// the Internet, the lobby or typing addresses. The usual case is one device's hotspot
+// (iPhone Personal Hotspot, Android hotspot, Steam Deck / Windows hotspot) with the other
+// device joined to it, but any shared Wi-Fi works too.
+//
+// Discovery is a tiny UDP probe/reply on cvfNearbyPort:
+//   - the host answers probes with its name, netplay port and build tag;
+//   - the joiner sends a probe to every address of each local Wi-Fi/Ethernet subnet
+//     (plus the broadcast address) and lists whoever answers.
+// Probing each address directly avoids broadcast/multicast, which iOS only allows for
+// apps with a special Apple entitlement. A hotspot subnet is small (an iPhone's is 14
+// addresses), so a sweep is cheap.
+//
+// iPhones/iPads also advertise and browse over Apple's peer-to-peer Wi-Fi (cvf_p2p_ios.go),
+// so two Apple devices find each other with no network at all. When a host is reachable
+// both ways, the shared network is used.
+//
+// The match itself is ordinary Ikemen netplay (TCP handshake + rollback over UDP).
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"net"
+	"runtime"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	lua "github.com/yuin/gopher-lua"
+)
+
+const (
+	cvfNearbyPort    = 7520
+	cvfNearbyProbe   = "CVFNEARBY?1"
+	cvfNearbyMaxScan = 1022 // addresses per interface; bigger networks scan the /24 around us
+	cvfNearbyExpire  = 7 * time.Second
+
+	// Loopback ports the app's relay uses on the joining device for a direct link.
+	cvfP2PJoinTCP = 7510
+	cvfP2PJoinUDP = 7502
+)
+
+type cvfNearbyHost struct {
+	ID      string
+	Via     string // "lan" or "p2p"
+	Name    string
+	IP      string
+	Port    int
+	Version string
+	seen    time.Time
+}
+
+type cvfNearbyReply struct {
+	T       string `json:"t"`
+	Name    string `json:"name"`
+	Port    int    `json:"port"`
+	Version string `json:"ver"`
+	ID      string `json:"id"`
+}
+
+type cvfNearbyState struct {
+	mu sync.Mutex
+
+	// hosting
+	hostConn   net.PacketConn
+	hostErr    string
+	hostPort   int
+	hostProbes int
+	hostID     string
+
+	// joining
+	scanStop  chan struct{}
+	hosts     map[string]*cvfNearbyHost
+	scanErr   string
+	lastSweep time.Time
+	extra     []string // extra probe targets (tests)
+	p2p       []cvfNearbyHost
+}
+
+func cvfNearbyNewID() string {
+	b := make([]byte, 5)
+	rand.Read(b)
+	return hex.EncodeToString(b)
+}
+
+var cvfNearby = &cvfNearbyState{}
+
+// Interfaces worth scanning: up, not loopback, not cellular/VPN/peer-to-peer links.
+func cvfNearbyIfaceOK(ifc net.Interface) bool {
+	if ifc.Flags&net.FlagUp == 0 || ifc.Flags&net.FlagLoopback != 0 {
+		return false
+	}
+	n := strings.ToLower(ifc.Name)
+	for _, p := range []string{"pdp_ip", "rmnet", "ccmni", "wwan", "utun", "ipsec", "tun", "tap",
+		"ppp", "awdl", "llw", "anpi", "gif", "stf", "tailscale", "zt", "wg", "docker", "veth", "virbr"} {
+		if strings.HasPrefix(n, p) {
+			return false
+		}
+	}
+	return true
+}
+
+type cvfNearbyNet struct {
+	self  net.IP
+	ipnet *net.IPNet
+}
+
+func cvfNearbyNets() []cvfNearbyNet {
+	var out []cvfNearbyNet
+	ifaces, _ := net.Interfaces()
+	for _, ifc := range ifaces {
+		if !cvfNearbyIfaceOK(ifc) {
+			continue
+		}
+		addrs, _ := ifc.Addrs()
+		for _, a := range addrs {
+			ipn, ok := a.(*net.IPNet)
+			if !ok {
+				continue
+			}
+			ip4 := ipn.IP.To4()
+			if ip4 == nil || ip4.IsLinkLocalUnicast() || ip4.IsLoopback() {
+				continue
+			}
+			out = append(out, cvfNearbyNet{ip4, &net.IPNet{IP: ip4.Mask(ipn.Mask), Mask: ipn.Mask}})
+		}
+	}
+	return out
+}
+
+func cvfNearbyIsSelf(ip net.IP) bool {
+	for _, n := range cvfNearbyNets() {
+		if n.self.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+// Every address to probe on one subnet: all hosts (or the /24 around us on big
+// networks), then the broadcast address. Our own address is skipped.
+func cvfNearbyTargets(n cvfNearbyNet) []net.IP {
+	ones, bits := n.ipnet.Mask.Size()
+	if bits != 32 || ones >= 31 {
+		return nil
+	}
+	base := n.ipnet.IP.To4()
+	size := uint32(1) << uint(32-ones)
+	if size-2 > cvfNearbyMaxScan {
+		base = n.self.Mask(net.CIDRMask(24, 32)).To4()
+		size = 256
+	}
+	start := uint32(base[0])<<24 | uint32(base[1])<<16 | uint32(base[2])<<8 | uint32(base[3])
+	out := make([]net.IP, 0, size)
+	for i := uint32(1); i < size; i++ { // i == size-1 is the broadcast address
+		v := start + i
+		ip := net.IPv4(byte(v>>24), byte(v>>16), byte(v>>8), byte(v)).To4()
+		if !ip.Equal(n.self) {
+			out = append(out, ip)
+		}
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// Host side
+
+func (s *cvfNearbyState) hostBegin(port, udpPort int) {
+	s.hostEnd()
+	id := cvfNearbyNewID()
+	name, tag := cvfNearbyIdentity()
+	cvfP2PAdvertise(id, name, tag, port, udpPort)
+	conn, err := net.ListenPacket("udp4", fmt.Sprintf(":%d", cvfNearbyPort))
+	s.mu.Lock()
+	s.hostPort, s.hostProbes, s.hostID = port, 0, id
+	if err != nil {
+		s.hostErr = "Nearby discovery unavailable (" + err.Error() + ")"
+		s.mu.Unlock()
+		return
+	}
+	s.hostErr = ""
+	s.hostConn = conn
+	s.mu.Unlock()
+
+	go func() {
+		buf := make([]byte, 256)
+		for {
+			n, from, err := conn.ReadFrom(buf)
+			if err != nil {
+				return // closed by hostEnd
+			}
+			if string(buf[:n]) != cvfNearbyProbe {
+				continue
+			}
+			name, tag := cvfNearbyIdentity()
+			s.mu.Lock()
+			p, id := s.hostPort, s.hostID
+			s.hostProbes++
+			s.mu.Unlock()
+			b, _ := json.Marshal(cvfNearbyReply{T: "cvfnearby", Name: name, Port: p, Version: tag, ID: id})
+			conn.WriteTo(b, from)
+		}
+	}()
+}
+
+func cvfNearbyIdentity() (name, tag string) {
+	cvfOnline.readConfig()
+	cvfOnline.mu.Lock()
+	name, tag = cvfOnline.playerName, cvfOnline.buildTag
+	cvfOnline.mu.Unlock()
+	if name == "" {
+		name = "Player"
+	}
+	return
+}
+
+// Stops looking for opponents. A direct link that is already connected keeps running.
+func (s *cvfNearbyState) hostEnd() {
+	cvfP2PAdvertiseStop()
+	s.mu.Lock()
+	c := s.hostConn
+	s.hostConn = nil
+	s.mu.Unlock()
+	if c != nil {
+		c.Close()
+	}
+}
+
+func (s *cvfNearbyState) hostStatus() string {
+	s.mu.Lock()
+	port, herr := s.hostPort, s.hostErr
+	s.mu.Unlock()
+	var b strings.Builder
+	b.WriteString("NEARBY  -  waiting for an opponent...\n\n")
+	var ips []string
+	for _, n := range cvfNearbyNets() {
+		ips = append(ips, n.self.String())
+	}
+	if len(ips) == 0 && cvfP2PAvailable {
+		b.WriteString("Nearby iPhones and iPads can join you directly.\n\n")
+	} else if len(ips) == 0 {
+		b.WriteString("Not connected to any network yet.\n\n")
+	} else {
+		fmt.Fprintf(&b, "Your address here: %s   Port: %d\n\n", strings.Join(ips, ", "), port)
+	}
+	if herr != "" {
+		b.WriteString(herr + "\nThe other player can still use Join Game with the address above.\n\n")
+	} else {
+		b.WriteString("The other player picks Online > Join Nearby.\n\n")
+	}
+	b.WriteString(cvfNearbyNoWifiHint())
+	b.WriteString("\n" + cvfStopHostingHint())
+	return b.String()
+}
+
+func cvfNearbyNoWifiHint() string {
+	if cvfP2PAvailable {
+		return "iPhone/iPad to iPhone/iPad works anywhere (keep Wi-Fi on).\n" +
+			"Other devices: share Wi-Fi or a hotspot. No Internet is used.\n"
+	}
+	return "No Wi-Fi around? Turn on the hotspot on one device\n" +
+		"(iPhone: Personal Hotspot, Android/Steam Deck: Hotspot)\n" +
+		"and connect the other device to it. No Internet is used.\n"
+}
+
+// ---------------------------------------------------------------------------
+// Join side
+
+func (s *cvfNearbyState) scanBegin() {
+	s.mu.Lock()
+	if s.scanStop != nil {
+		s.mu.Unlock()
+		return
+	}
+	stop := make(chan struct{})
+	s.scanStop = stop
+	if s.hosts == nil {
+		s.hosts = map[string]*cvfNearbyHost{}
+	}
+	s.scanErr = ""
+	s.mu.Unlock()
+	cvfP2PBrowse(true)
+
+	conn, err := net.ListenPacket("udp4", ":0")
+	if err != nil {
+		s.mu.Lock()
+		s.scanErr = "Cannot search (" + err.Error() + ")"
+		s.scanStop = nil
+		s.mu.Unlock()
+		return
+	}
+
+	// Replies
+	go func() {
+		buf := make([]byte, 512)
+		for {
+			n, from, err := conn.ReadFrom(buf)
+			if err != nil {
+				return
+			}
+			var r cvfNearbyReply
+			if json.Unmarshal(buf[:n], &r) != nil || r.T != "cvfnearby" || r.Port <= 0 || r.Port > 65535 {
+				continue
+			}
+			ua, ok := from.(*net.UDPAddr)
+			if !ok || ua.IP.To4() == nil {
+				continue
+			}
+			if cvfNearbyIsSelf(ua.IP) {
+				continue // our own broadcast echo
+			}
+			ip := ua.IP.To4().String()
+			s.mu.Lock()
+			if s.hosts == nil { // search screen already closed
+				s.mu.Unlock()
+				continue
+			}
+			s.hosts[ip+fmt.Sprint(":", r.Port)] = &cvfNearbyHost{
+				ID: r.ID, Via: "lan", Name: cvfCleanName(r.Name), IP: ip, Port: r.Port, Version: r.Version, seen: time.Now(),
+			}
+			s.mu.Unlock()
+		}
+	}()
+
+	// Probes: a full sweep straight away, then every 2.5 seconds.
+	go func() {
+		defer conn.Close()
+		probe := []byte(cvfNearbyProbe)
+		t := time.NewTicker(2500 * time.Millisecond)
+		defer t.Stop()
+		for {
+			nets := cvfNearbyNets()
+			sent := 0
+			for _, n := range nets {
+				for i, ip := range cvfNearbyTargets(n) {
+					select {
+					case <-stop:
+						return
+					default:
+					}
+					if _, err := conn.WriteTo(probe, &net.UDPAddr{IP: ip, Port: cvfNearbyPort}); err == nil {
+						sent++
+					}
+					if i%64 == 63 {
+						time.Sleep(2 * time.Millisecond) // don't overrun small send buffers
+					}
+				}
+			}
+			s.mu.Lock()
+			for _, h := range s.extra {
+				if a, err := net.ResolveUDPAddr("udp4", h); err == nil {
+					conn.WriteTo(probe, a)
+				}
+			}
+			s.lastSweep = time.Now()
+			switch {
+			case len(nets) == 0 && cvfP2PAvailable:
+				s.scanErr = ""
+			case len(nets) == 0:
+				s.scanErr = "Not connected to any network."
+			case sent == 0:
+				s.scanErr = "Cannot reach the local network. On iPhone/iPad allow\nLocal Network for CvF Online in Settings > Privacy & Security."
+			default:
+				s.scanErr = ""
+			}
+			s.mu.Unlock()
+			select {
+			case <-stop:
+				return
+			case <-t.C:
+			}
+		}
+	}()
+}
+
+func (s *cvfNearbyState) scanEnd() {
+	cvfP2PBrowse(false)
+	s.mu.Lock()
+	if s.scanStop != nil {
+		close(s.scanStop)
+		s.scanStop = nil
+	}
+	s.hosts = nil
+	s.p2p = nil
+	s.mu.Unlock()
+}
+
+// Direct-link hosts reported by the app (JSON list).
+func (s *cvfNearbyState) setP2P(js string) {
+	var in []struct {
+		ID   string `json:"id"`
+		Name string `json:"name"`
+		Ver  string `json:"ver"`
+		RP   int    `json:"rp"`
+	}
+	if json.Unmarshal([]byte(js), &in) != nil {
+		return
+	}
+	var out []cvfNearbyHost
+	for _, h := range in {
+		if h.ID == "" {
+			continue
+		}
+		out = append(out, cvfNearbyHost{ID: h.ID, Via: "p2p", Name: cvfCleanName(h.Name), Port: h.RP, Version: h.Ver})
+	}
+	s.mu.Lock()
+	if s.scanStop != nil {
+		s.p2p = out
+	}
+	s.mu.Unlock()
+}
+
+// Hosts heard from recently, sorted by name, and a status line.
+func (s *cvfNearbyState) list() ([]cvfNearbyHost, string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	var out []cvfNearbyHost
+	for k, h := range s.hosts {
+		if time.Since(h.seen) > cvfNearbyExpire {
+			delete(s.hosts, k)
+			continue
+		}
+		out = append(out, *h)
+	}
+	// A host reachable over the shared network is listed once, using that network.
+	for _, h := range s.p2p {
+		dup := false
+		for _, o := range out {
+			if o.ID != "" && o.ID == h.ID {
+				dup = true
+				break
+			}
+		}
+		if !dup {
+			out = append(out, h)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].Name != out[j].Name {
+			return out[i].Name < out[j].Name
+		}
+		return out[i].IP < out[j].IP
+	})
+	return out, s.scanErr
+}
+
+// ---------------------------------------------------------------------------
+// Touch devices: gesture hints and the player name
+
+// True on phones/tablets while menus are driven by touch (no controller connected).
+func cvfTouchUI() bool {
+	return (runtime.GOOS == "ios" || runtime.GOOS == "android") && cvfTouchMenus
+}
+
+func cvfStopHostingHint() string {
+	if cvfTouchUI() {
+		return "Double-tap to stop hosting."
+	}
+	return "Press Esc to stop hosting."
+}
+
+// A name for players who never typed one ("Player 4821").
+func cvfDefaultName() string {
+	n, _ := rand.Int(rand.Reader, big.NewInt(9000))
+	return fmt.Sprintf("Player %d", 1000+n.Int64())
+}
+
+var cvfNameAsk struct {
+	sync.Mutex
+	waiting bool
+	done    bool
+	result  string
+}
+
+func cvfNameAskBegin() bool {
+	cvfNameAsk.Lock()
+	cvfNameAsk.waiting, cvfNameAsk.done, cvfNameAsk.result = true, false, ""
+	cvfNameAsk.Unlock()
+	if !cvfNativeAskName(cvfDefaultName()) {
+		cvfNameAsk.Lock()
+		cvfNameAsk.waiting = false
+		cvfNameAsk.Unlock()
+		return false
+	}
+	return true
+}
+
+// Called (from the app) with what the player typed; "" if they cancelled.
+func cvfNameAskDone(name string) {
+	cvfNameAsk.Lock()
+	if cvfNameAsk.waiting {
+		cvfNameAsk.waiting, cvfNameAsk.done, cvfNameAsk.result = false, true, name
+	}
+	cvfNameAsk.Unlock()
+}
+
+// ---------------------------------------------------------------------------
+// Lua
+
+func cvfNearbyScriptInit(l *lua.LState) {
+	luaRegister(l, "cvfNearbyHostBegin", func(l *lua.LState) int {
+		cvfNearby.hostBegin(int(numArg(l, 1)), sys.cfg.Netplay.Rollback.Port)
+		return 0
+	})
+	luaRegister(l, "cvfNearbyHostEnd", func(l *lua.LState) int {
+		cvfNearby.hostEnd()
+		return 0
+	})
+	luaRegister(l, "cvfNearbyHostStatus", func(l *lua.LState) int {
+		l.Push(lua.LString(cvfNearby.hostStatus()))
+		return 1
+	})
+	luaRegister(l, "cvfNearbyScanBegin", func(l *lua.LState) int {
+		cvfNearby.scanBegin()
+		return 0
+	})
+	luaRegister(l, "cvfNearbyScanEnd", func(l *lua.LState) int {
+		cvfNearby.scanEnd()
+		return 0
+	})
+	// Returns a table of {name, ip, port, compatible} and a status string.
+	luaRegister(l, "cvfNearbyHosts", func(l *lua.LState) int {
+		hosts, status := cvfNearby.list()
+		cvfOnline.readConfig()
+		cvfOnline.mu.Lock()
+		tag := cvfOnline.buildTag
+		cvfOnline.mu.Unlock()
+		t := l.NewTable()
+		for _, h := range hosts {
+			rt := l.NewTable()
+			rt.RawSetString("name", lua.LString(h.Name))
+			rt.RawSetString("ip", lua.LString(h.IP))
+			rt.RawSetString("id", lua.LString(h.ID))
+			rt.RawSetString("direct", lua.LBool(h.Via == "p2p"))
+			rt.RawSetString("port", lua.LNumber(h.Port))
+			rt.RawSetString("compatible", lua.LBool(h.Version == tag))
+			t.Append(rt)
+		}
+		l.Push(t)
+		l.Push(lua.LString(status))
+		return 2
+	})
+	// Opens the app's relay to a direct-link host. Returns the loopback TCP port to
+	// connect to and the rollback UDP port to use, or nothing if the host is gone.
+	luaRegister(l, "cvfNearbyDirectJoin", func(l *lua.LState) int {
+		if !cvfP2PJoin(strArg(l, 1), cvfP2PJoinTCP, cvfP2PJoinUDP) {
+			return 0
+		}
+		l.Push(lua.LNumber(cvfP2PJoinTCP))
+		l.Push(lua.LNumber(cvfP2PJoinUDP))
+		return 2
+	})
+	luaRegister(l, "cvfNearbyDirectClose", func(l *lua.LState) int {
+		cvfP2PClose()
+		return 0
+	})
+	luaRegister(l, "cvfIsMobile", func(l *lua.LState) int {
+		l.Push(lua.LBool(runtime.GOOS == "ios" || runtime.GOOS == "android"))
+		return 1
+	})
+	luaRegister(l, "cvfTouchUI", func(l *lua.LState) int {
+		l.Push(lua.LBool(cvfTouchUI()))
+		return 1
+	})
+	luaRegister(l, "cvfDefaultName", func(l *lua.LState) int {
+		l.Push(lua.LString(cvfDefaultName()))
+		return 1
+	})
+	// Shows the device's own name box (iPhone/iPad). False if there is none.
+	luaRegister(l, "cvfAskNameBegin", func(l *lua.LState) int {
+		l.Push(lua.LBool(cvfNameAskBegin()))
+		return 1
+	})
+	// Nothing while the box is open, then the typed name ("" if cancelled).
+	luaRegister(l, "cvfAskNamePoll", func(l *lua.LState) int {
+		cvfNameAsk.Lock()
+		done, r := cvfNameAsk.done, cvfNameAsk.result
+		cvfNameAsk.Unlock()
+		if !done {
+			return 0
+		}
+		l.Push(lua.LString(r))
+		return 1
+	})
+	luaRegister(l, "cvfNearbyHint", func(l *lua.LState) int {
+		l.Push(lua.LString(strings.TrimRight(cvfNearbyNoWifiHint(), "\n")))
+		return 1
+	})
+	luaRegister(l, "cvfGetRollbackPort", func(l *lua.LState) int {
+		l.Push(lua.LNumber(sys.cfg.Netplay.Rollback.Port))
+		return 1
+	})
+	luaRegister(l, "cvfSetRollbackPort", func(l *lua.LState) int {
+		if p := int(numArg(l, 1)); p > 0 && p < 65536 {
+			sys.cfg.Netplay.Rollback.Port = p
+		}
+		return 0
+	})
+}
diff --git a/src/cvf_online.go b/src/cvf_online.go
new file mode 100644
index 00000000..10b9d645
--- /dev/null
+++ b/src/cvf_online.go
@@ -0,0 +1,939 @@
+package main
+
+// Castlevania Fighter online helpers:
+//   - shows the host's public/LAN address and port while waiting for an opponent
+//   - opens the netplay ports on the router automatically (UPnP IGD, no dependencies)
+//   - talks to a small lobby server so players can find each other without typing IPs
+//
+// Everything network-related runs in goroutines; Lua only polls cached state, so the
+// menus never block on the network.
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"encoding/xml"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	lua "github.com/yuin/gopher-lua"
+)
+
+const cvfOnlineConfigFile = "data/cvf_online.ini"
+const cvfOnlineProfileFile = "save/cvf_online_profile.json"
+
+type cvfOnlineState struct {
+	mu sync.Mutex
+
+	lobbyURL    string
+	buildTag    string
+	playerName  string
+	configRead  bool
+	httpClient  *http.Client
+	publicIP    string
+	publicIPErr string
+	publicBusy  bool
+
+	upnpStatus string
+	upnpMapped []upnpMapping
+
+	hosting       bool
+	hostPort      int
+	roomID        string
+	roomToken     string
+	roomOpen      string // "", "yes", "no"
+	lobbyHostErr  string
+	hostStop      chan struct{}
+	rooms         []cvfRoom
+	roomsErr      string
+	roomsBusy     bool
+	roomsFetched  time.Time
+	roomsRequests int
+}
+
+type cvfRoom struct {
+	ID      string `json:"id"`
+	Name    string `json:"name"`
+	IP      string `json:"ip"`
+	Port    int    `json:"port"`
+	UDPPort int    `json:"udp_port"`
+	Version string `json:"version"`
+	Open    string `json:"open"`
+	AgeSec  int    `json:"age_sec"`
+}
+
+var cvfOnline = &cvfOnlineState{
+	httpClient: &http.Client{Timeout: 70 * time.Second}, // free hosts can take ~1 min to wake up
+	buildTag:   "cvf-online-1",
+}
+
+func (s *cvfOnlineState) readConfig() {
+	if s.configRead {
+		return
+	}
+	s.configRead = true
+	if f, err := os.Open(cvfOnlineConfigFile); err == nil {
+		sc := bufio.NewScanner(f)
+		for sc.Scan() {
+			line := strings.TrimSpace(sc.Text())
+			if i := strings.Index(line, ";"); i >= 0 {
+				line = strings.TrimSpace(line[:i])
+			}
+			k, v, ok := strings.Cut(line, "=")
+			if !ok {
+				continue
+			}
+			k, v = strings.ToLower(strings.TrimSpace(k)), strings.TrimSpace(v)
+			switch k {
+			case "lobbyurl":
+				s.lobbyURL = strings.TrimRight(v, "/")
+			case "buildtag":
+				if v != "" {
+					s.buildTag = v
+				}
+			}
+		}
+		f.Close()
+	}
+	if b, err := os.ReadFile(cvfOnlineProfileFile); err == nil {
+		var p struct {
+			Name string `json:"name"`
+		}
+		if json.Unmarshal(b, &p) == nil {
+			s.playerName = p.Name
+		}
+	}
+}
+
+func (s *cvfOnlineState) saveProfile() {
+	b, _ := json.Marshal(map[string]string{"name": s.playerName})
+	os.MkdirAll(filepath.Dir(cvfOnlineProfileFile), 0755)
+	os.WriteFile(cvfOnlineProfileFile, b, 0644)
+}
