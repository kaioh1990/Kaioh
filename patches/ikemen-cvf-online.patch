+-- CvF Online: ask for a lobby display name once
+function main.f_cvfEnsureName()
+	if cvfGetPlayerName() ~= '' then
+		return true
+	end
+	-- Phones/tablets have no keyboard here: use the device's own name box (iPhone/iPad),
+	-- and never block on it; an untyped name becomes "Player 1234".
+	if cvfIsMobile() then
+		local typed = ''
+		if cvfAskNameBegin() then
+			local ts = motif.title_info.connecting.TextSpriteData
+			while true do
+				local r = cvfAskNamePoll()
+				if r ~= nil then
+					typed = r
+					break
+				end
+				clearColor(motif[main.background].bgclearcolor[1], motif[main.background].bgclearcolor[2], motif[main.background].bgclearcolor[3])
+				bgDraw(motif[main.background].BGDef, 0)
+				rectDraw(motif.title_info.connecting.overlay.RectData)
+				textImgReset(ts)
+				textImgSetPos(ts, nil, 60)
+				textImgSetText(ts, 'Choose the name other players will see.')
+				textImgDraw(ts)
+				bgDraw(motif[main.background].BGDef, 1)
+				refresh()
+			end
+			resetKey()
+		end
+		if typed == '' then
+			typed = cvfDefaultName()
+		end
+		cvfSetPlayerName(typed)
+		return true
+	end
+	local name = main.f_drawInput(
+		motif[main.group].textinput.TextSpriteData,
+		'Enter your player name for the online lobby:',
+		motif[main.group],
+		motif[main.background],
+		motif[main.group].textinput.overlay.RectData
+	)
+	if name == '' then
+		return false
+	end
+	cvfSetPlayerName(name)
+	return true
+end
