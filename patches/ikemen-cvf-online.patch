+	case x == 0 || math.IsNaN(x):
+		return x // return ±0 || math.NaN()
+	case math.IsInf(x, 0):
+		return math.NaN()
+	}
+
+	// make argument positive but save the sign
+	sign := false
+	if x < 0 {
+		x = -x
+		sign = true
+	}
+
+	var j uint64
+	var y, z float64
+	if x >= cvfReduceThreshold {
+		j, z = cvfTrigReduce(x)
+	} else {
+		j = uint64(x * (4 / math.Pi)) // integer part of x/(math.Pi/4), as integer for tests on the phase angle
+		y = float64(j)                // integer part of x/(math.Pi/4), as float
+
+		// map zeros to origin
+		if j&1 == 1 {
+			j++
+			y++
+		}
+		j &= 7                               // octant modulo 2Pi radians (360 degrees)
+		z = ((x - y*PI4A) - y*PI4B) - y*PI4C // Extended precision modular arithmetic
+	}
+	// reflect in x axis
+	if j > 3 {
+		sign = !sign
+		j -= 4
+	}
+	zz := z * z
+	if j == 1 || j == 2 {
+		y = 1.0 - 0.5*zz + zz*zz*((((((cvf_cos[0]*zz)+cvf_cos[1])*zz+cvf_cos[2])*zz+cvf_cos[3])*zz+cvf_cos[4])*zz+cvf_cos[5])
+	} else {
+		y = z + z*zz*((((((cvf_sin[0]*zz)+cvf_sin[1])*zz+cvf_sin[2])*zz+cvf_sin[3])*zz+cvf_sin[4])*zz+cvf_sin[5])
+	}
+	if sign {
+		y = -y
+	}
+	return y
+}
+
+/*
+	Floating-point tangent.
+*/
+
+// The original C code, the long comment, and the constants
+// below were from http://netlib.sandia.gov/cephes/cmath/cvfSin.c,
+// available from http://www.netlib.org/cephes/cmath.tgz.
+// The go code is a simplified version of the original C.
+//
+//      cvfTan.c
+//
+//      Circular tangent
+//
+// SYNOPSIS:
+//
+// double x, y, cvfTan();
+// y = cvfTan( x );
+//
+// DESCRIPTION:
+//
+// Returns the circular tangent of the radian argument x.
+//
+// Range reduction is modulo pi/4.  A rational function
+//       x + x**3 P(x**2)/Q(x**2)
+// is employed in the basic interval [0, pi/4].
+//
+// ACCURACY:
+//                      Relative error:
+// arithmetic   domain     # trials      peak         rms
+//    DEC      +-1.07e9      44000      4.1e-17     1.0e-17
+//    IEEE     +-1.07e9      30000      2.9e-16     8.1e-17
+//
+// Partial loss of accuracy begins to occur at x = 2**30 = 1.074e9.  The loss
+// is not gradual, but jumps suddenly to about 1 part in 10e7.  Results may
+// be meaningless for x > 2**49 = 5.6e14.
+// [Accuracy loss statement from cvfSin.go comments.]
+//
+// Cephes Math Library Release 2.8:  June, 2000
+// Copyright 1984, 1987, 1989, 1992, 2000 by Stephen L. Moshier
+//
+// The readme file at http://netlib.sandia.gov/cephes/ says:
+//    Some software in this archive may be from the book _Methods and
+// Programs for Mathematical Functions_ (Prentice-Hall or Simon & Schuster
+// International, 1989) or from the Cephes Mathematical Library, a
+// commercial product. In either event, it is copyrighted by the author.
+// What you see here may be used freely but it comes with no support or
+// guarantee.
+//
+//   The two known misprints in the book are repaired here in the
+// source listings for the gamma function and the incomplete beta
+// integral.
+//
+//   Stephen L. Moshier
+//   moshier@na-net.ornl.gov
+
+// cvfTan coefficients
+var cvf_tanP = [...]float64{
+	-1.30936939181383777646e4, // 0xc0c992d8d24f3f38
+	1.15351664838587416140e6,  // 0x413199eca5fc9ddd
+	-1.79565251976484877988e7, // 0xc1711fead3299176
+}
+var cvf_tanQ = [...]float64{
+	1.00000000000000000000e0,
+	1.36812963470692954678e4,  // 0x40cab8a5eeb36572
+	-1.32089234440210967447e6, // 0xc13427bc582abc96
+	2.50083801823357915839e7,  // 0x4177d98fc2ead8ef
+	-5.38695755929454629881e7, // 0xc189afe03cbe5a31
+}
+
+func cvfTan(x float64) float64 {
+	const (
+		PI4A = 7.85398125648498535156e-1  // 0x3fe921fb40000000, math.Pi/4 split into three parts
+		PI4B = 3.77489470793079817668e-8  // 0x3e64442d00000000,
+		PI4C = 2.69515142907905952645e-15 // 0x3ce8469898cc5170,
+	)
+	// special cases
+	switch {
+	case x == 0 || math.IsNaN(x):
+		return x // return ±0 || math.NaN()
+	case math.IsInf(x, 0):
+		return math.NaN()
+	}
+
+	// make argument positive but save the sign
+	sign := false
+	if x < 0 {
+		x = -x
+		sign = true
+	}
+	var j uint64
+	var y, z float64
+	if x >= cvfReduceThreshold {
+		j, z = cvfTrigReduce(x)
+	} else {
+		j = uint64(x * (4 / math.Pi)) // integer part of x/(math.Pi/4), as integer for tests on the phase angle
+		y = float64(j)                // integer part of x/(math.Pi/4), as float
+
+		/* map zeros and singularities to origin */
+		if j&1 == 1 {
+			j++
+			y++
+		}
+
+		z = ((x - y*PI4A) - y*PI4B) - y*PI4C
+	}
+	zz := z * z
+
+	if zz > 1e-14 {
+		y = z + z*(zz*(((cvf_tanP[0]*zz)+cvf_tanP[1])*zz+cvf_tanP[2])/((((zz+cvf_tanQ[1])*zz+cvf_tanQ[2])*zz+cvf_tanQ[3])*zz+cvf_tanQ[4]))
+	} else {
+		y = z
+	}
+	if j&2 == 2 {
+		y = -1 / y
+	}
+	if sign {
+		y = -y
+	}
+	return y
+}
+
+// cvfReduceThreshold is the maximum value of x where the reduction using math.Pi/4
+// in 3 float64 parts still gives accurate results. This threshold
+// is set by y*C being representable as a float64 without error
+// where y is given by y = floor(x * (4 / math.Pi)) and C is the leading partial
+// terms of 4/math.Pi. Since the leading terms (PI4A and PI4B in cvfSin.go) have 30
+// and 32 trailing zero bits, y should have less than 30 significant mbits.
+//
+//	y < 1<<30  -> floor(x*4/math.Pi) < 1<<30 -> x < (1<<30 - 1) * math.Pi/4
+//
+// So, conservatively we can take x < 1<<29.
+// Above this threshold Payne-Hanek range reduction must be used.
+const cvfReduceThreshold = 1 << 29
+
+// cvfTrigReduce implements Payne-Hanek range reduction by math.Pi/4
+// for x > 0. It returns the integer part mod 8 (j) and
+// the fractional part (z) of x / (math.Pi/4).
+// The implementation is based on:
+// "ARGUMENT REDUCTION FOR HUGE ARGUMENTS: Good to the Last Bit"
+// K. C. Ng et al, March 24, 1992
+// The simulated multi-precision calculation of x*B uses 64-bit integer arithmetic.
+func cvfTrigReduce(x float64) (j uint64, z float64) {
+	const PI4 = math.Pi / 4
+	if x < PI4 {
+		return 0, x
+	}
+	// Extract out the integer and exponent such that,
+	// x = ix * 2 ** exp.
+	ix := math.Float64bits(x)
+	exp := int(ix>>cvfFloatShift&cvfFloatMask) - cvfFloatBias - cvfFloatShift
+	ix &^= cvfFloatMask << cvfFloatShift
+	ix |= 1 << cvfFloatShift
+	// Use the exponent to extract the 3 appropriate uint64 digits from cvfMPi4,
+	// B ~ (z0, z1, z2), such that the product leading digit has the exponent -61.
+	// Note, exp >= -53 since x >= PI4 and exp < 971 for maximum float64.
+	digit, bitshift := uint(exp+61)/64, uint(exp+61)%64
+	z0 := (cvfMPi4[digit] << bitshift) | (cvfMPi4[digit+1] >> (64 - bitshift))
+	z1 := (cvfMPi4[digit+1] << bitshift) | (cvfMPi4[digit+2] >> (64 - bitshift))
+	z2 := (cvfMPi4[digit+2] << bitshift) | (cvfMPi4[digit+3] >> (64 - bitshift))
+	// Multiply mantissa by the digits and extract the upper two digits (hi, lo).
+	z2hi, _ := mbits.Mul64(z2, ix)
+	z1hi, z1lo := mbits.Mul64(z1, ix)
+	z0lo := z0 * ix
+	lo, c := mbits.Add64(z1lo, z2hi, 0)
+	hi, _ := mbits.Add64(z0lo, z1hi, c)
+	// The top 3 bits are j.
+	j = hi >> 61
+	// Extract the fraction and find its magnitude.
+	hi = hi<<3 | lo>>61
+	lz := uint(mbits.LeadingZeros64(hi))
+	e := uint64(cvfFloatBias - (lz + 1))
+	// Clear implicit mantissa bit and shift into place.
+	hi = (hi << (lz + 1)) | (lo >> (64 - (lz + 1)))
+	hi >>= 64 - cvfFloatShift
+	// Include the exponent and convert to a float.
+	hi |= e << cvfFloatShift
+	z = math.Float64frombits(hi)
+	// Map zeros to origin.
+	if j&1 == 1 {
+		j++
+		j &= 7
+		z--
+	}
+	// Multiply the fractional part by pi/4.
+	return j, z * PI4
+}
+
+// cvfMPi4 is the binary digits of 4/pi as a uint64 array,
+// that is, 4/pi = Sum cvfMPi4[i]*2^(-64*i)
+// 19 64-bit digits and the leading one bit give 1217 bits
+// of precision to handle the largest possible float64 exponent.
+var cvfMPi4 = [...]uint64{
+	0x0000000000000001,
+	0x45f306dc9c882a53,
+	0xf84eafa3ea69bb81,
+	0xb6c52b3278872083,
+	0xfca2c757bd778ac3,
+	0x6e48dc74849ba5c0,
+	0x0c925dd413a32439,
+	0xfc3bd63962534e7d,
+	0xd1046bea5d768909,
+	0xd338e04d68befc82,
+	0x7323ac7306a673e9,
+	0x3908bf177bf25076,
+	0x3ff12fffbc0b301f,
+	0xde5e2316b414da3e,
+	0xda6cfd9e4f96136e,
+	0x9e8c7ecd3cbfd45a,
+	0xea4f758fd7cbe2f6,
+	0x7a0e73ef14a525d4,
+	0xd7f6bf623f1aba10,
+	0xac06608df8f6d757,
+}
+
+/*
+	Floating-point arctangent.
+*/
+
+// The original C code, the long comment, and the constants below were
+// from http://netlib.sandia.gov/cephes/cmath/cvfAtan.c, available from
+// http://www.netlib.org/cephes/cmath.tgz.
+// The go code is a version of the original C.
+//
+// cvfAtan.c
+// Inverse circular tangent (arctangent)
+//
+// SYNOPSIS:
+// double x, y, cvfAtan();
+// y = cvfAtan( x );
+//
+// DESCRIPTION:
+// Returns radian angle between -pi/2 and +pi/2 whose tangent is x.
+//
+// Range reduction is from three intervals into the interval from zero to 0.66.
+// The approximant uses a rational function of degree 4/5 of the form
+// x + x**3 P(x)/Q(x).
+//
+// ACCURACY:
+//                      Relative error:
+// arithmetic   domain    # trials  peak     rms
+//    DEC       -10, 10   50000     2.4e-17  8.3e-18
+//    IEEE      -10, 10   10^6      1.8e-16  5.0e-17
+//
+// Cephes Math Library Release 2.8:  June, 2000
+// Copyright 1984, 1987, 1989, 1992, 2000 by Stephen L. Moshier
+//
+// The readme file at http://netlib.sandia.gov/cephes/ says:
+//    Some software in this archive may be from the book _Methods and
+// Programs for Mathematical Functions_ (Prentice-Hall or Simon & Schuster
+// International, 1989) or from the Cephes Mathematical Library, a
+// commercial product. In either event, it is copyrighted by the author.
+// What you see here may be used freely but it comes with no support or
+// guarantee.
+//
+//   The two known misprints in the book are repaired here in the
+// source listings for the gamma function and the incomplete beta
+// integral.
+//
+//   Stephen L. Moshier
+//   moshier@na-net.ornl.gov
+
+// cvfXatan evaluates a series valid in the range [0, 0.66].
+func cvfXatan(x float64) float64 {
+	const (
+		P0 = -8.750608600031904122785e-01
+		P1 = -1.615753718733365076637e+01
+		P2 = -7.500855792314704667340e+01
+		P3 = -1.228866684490136173410e+02
+		P4 = -6.485021904942025371773e+01
+		Q0 = +2.485846490142306297962e+01
+		Q1 = +1.650270098316988542046e+02
+		Q2 = +4.328810604912902668951e+02
+		Q3 = +4.853903996359136964868e+02
+		Q4 = +1.945506571482613964425e+02
+	)
+	z := x * x
+	z = z * ((((P0*z+P1)*z+P2)*z+P3)*z + P4) / (((((z+Q0)*z+Q1)*z+Q2)*z+Q3)*z + Q4)
+	z = x*z + x
+	return z
+}
+
+// cvfSatan reduces its argument (known to be positive)
+// to the range [0, 0.66] and calls cvfXatan.
+func cvfSatan(x float64) float64 {
+	const (
+		cvfMorebits = 6.123233995736765886130e-17 // pi/2 = PIO2 + cvfMorebits
+		cvfTan3pio8 = 2.41421356237309504880      // cvfTan(3*pi/8)
+	)
+	if x <= 0.66 {
+		return cvfXatan(x)
+	}
+	if x > cvfTan3pio8 {
+		return math.Pi/2 - cvfXatan(1/x) + cvfMorebits
+	}
+	return math.Pi/4 + cvfXatan((x-1)/(x+1)) + 0.5*cvfMorebits
+}
+
+func cvfAtan(x float64) float64 {
+	if x == 0 {
+		return x
+	}
+	if x > 0 {
+		return cvfSatan(x)
+	}
+	return -cvfSatan(-x)
+}
+
+/*
+	Floating-point arcsine and arccosine.
+
+	They are implemented by computing the arctangent
+	after appropriate range reduction.
+*/
+
+func cvfAsin(x float64) float64 {
+	if x == 0 {
+		return x // special case
+	}
+	sign := false
+	if x < 0 {
+		x = -x
+		sign = true
+	}
+	if x > 1 {
+		return math.NaN() // special case
+	}
+
+	temp := math.Sqrt(1 - x*x)
+	if x > 0.7 {
+		temp = math.Pi/2 - cvfSatan(temp/x)
+	} else {
+		temp = cvfSatan(x / temp)
+	}
+
+	if sign {
+		temp = -temp
+	}
+	return temp
+}
+
+func cvfAcos(x float64) float64 {
+	return math.Pi/2 - cvfAsin(x)
+}
+
+func cvfAtan2(y, x float64) float64 {
+	// special cases
+	switch {
+	case math.IsNaN(y) || math.IsNaN(x):
+		return math.NaN()
+	case y == 0:
+		if x >= 0 && !math.Signbit(x) {
+			return math.Copysign(0, y)
+		}
+		return math.Copysign(math.Pi, y)
+	case x == 0:
+		return math.Copysign(math.Pi/2, y)
+	case math.IsInf(x, 0):
+		if math.IsInf(x, 1) {
+			switch {
+			case math.IsInf(y, 0):
+				return math.Copysign(math.Pi/4, y)
+			default:
+				return math.Copysign(0, y)
+			}
+		}
+		switch {
+		case math.IsInf(y, 0):
+			return math.Copysign(3*math.Pi/4, y)
+		default:
+			return math.Copysign(math.Pi, y)
+		}
+	case math.IsInf(y, 0):
+		return math.Copysign(math.Pi/2, y)
+	}
+
+	// Call cvfAtan and determine the quadrant.
+	q := cvfAtan(y / x)
+	if x < 0 {
+		if q <= 0 {
+			return q + math.Pi
+		}
+		return q - math.Pi
+	}
+	return q
+}
+
+const (
+	cvfFloatMask  = 0x7FF
+	cvfFloatShift = 64 - 11 - 1
+	cvfFloatBias  = 1023
+)
diff --git a/src/cvf_online.go b/src/cvf_online.go
new file mode 100644
index 00000000..51d1319d
--- /dev/null
+++ b/src/cvf_online.go
@@ -0,0 +1,930 @@
+package main
+
+// Castlevania Fighter online helpers:
+//   - shows the host's public/LAN address and port while waiting for an opponent
+//   - opens the netplay ports on the router automatically (UPnP IGD, no dependencies)
+//   - talks to a small lobby server so players can find each other without typing IPs
+//
+// Everything network-related runs in goroutines; Lua only polls cached state, so the
+// menus never block on the network.
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"encoding/xml"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	lua "github.com/yuin/gopher-lua"
+)
+
+const cvfOnlineConfigFile = "data/cvf_online.ini"
+const cvfOnlineProfileFile = "save/cvf_online_profile.json"
+
+type cvfOnlineState struct {
+	mu sync.Mutex
+
+	lobbyURL    string
+	buildTag    string
+	playerName  string
+	configRead  bool
+	httpClient  *http.Client
+	publicIP    string
+	publicIPErr string
+	publicBusy  bool
+
+	upnpStatus string
+	upnpMapped []upnpMapping
+
+	hosting       bool
+	hostPort      int
+	roomID        string
+	roomToken     string
+	roomOpen      string // "", "yes", "no"
+	lobbyHostErr  string
+	hostStop      chan struct{}
+	rooms         []cvfRoom
+	roomsErr      string
+	roomsBusy     bool
+	roomsFetched  time.Time
+	roomsRequests int
+}
+
+type cvfRoom struct {
+	ID      string `json:"id"`
+	Name    string `json:"name"`
+	IP      string `json:"ip"`
+	Port    int    `json:"port"`
+	UDPPort int    `json:"udp_port"`
+	Version string `json:"version"`
+	Open    string `json:"open"`
+	AgeSec  int    `json:"age_sec"`
+}
+
+var cvfOnline = &cvfOnlineState{
+	httpClient: &http.Client{Timeout: 70 * time.Second}, // free hosts can take ~1 min to wake up
+	buildTag:   "cvf-online-1",
+}
+
+func (s *cvfOnlineState) readConfig() {
+	if s.configRead {
+		return
+	}
+	s.configRead = true
+	if f, err := os.Open(cvfOnlineConfigFile); err == nil {
+		sc := bufio.NewScanner(f)
+		for sc.Scan() {
+			line := strings.TrimSpace(sc.Text())
+			if i := strings.Index(line, ";"); i >= 0 {
+				line = strings.TrimSpace(line[:i])
+			}
+			k, v, ok := strings.Cut(line, "=")
+			if !ok {
+				continue
+			}
+			k, v = strings.ToLower(strings.TrimSpace(k)), strings.TrimSpace(v)
+			switch k {
+			case "lobbyurl":
+				s.lobbyURL = strings.TrimRight(v, "/")
+			case "buildtag":
+				if v != "" {
+					s.buildTag = v
+				}
+			}
+		}
+		f.Close()
+	}
+	if b, err := os.ReadFile(cvfOnlineProfileFile); err == nil {
+		var p struct {
+			Name string `json:"name"`
+		}
+		if json.Unmarshal(b, &p) == nil {
+			s.playerName = p.Name
+		}
+	}
+}
+
+func (s *cvfOnlineState) saveProfile() {
+	b, _ := json.Marshal(map[string]string{"name": s.playerName})
+	os.MkdirAll(filepath.Dir(cvfOnlineProfileFile), 0755)
+	os.WriteFile(cvfOnlineProfileFile, b, 0644)
+}
+
+// ---------------------------------------------------------------------------
+// Addresses
+
+func cvfLocalIPs() []string {
+	var out []string
+	ifaces, _ := net.Interfaces()
+	for _, ifc := range ifaces {
+		if ifc.Flags&net.FlagUp == 0 || ifc.Flags&net.FlagLoopback != 0 {
+			continue
+		}
+		addrs, _ := ifc.Addrs()
+		for _, a := range addrs {
+			if ipn, ok := a.(*net.IPNet); ok {
+				if ip4 := ipn.IP.To4(); ip4 != nil && !ip4.IsLinkLocalUnicast() {
+					out = append(out, ip4.String())
+				}
+			}
+		}
+	}
+	return out
+}
+
+func (s *cvfOnlineState) fetchPublicIP() {
+	s.mu.Lock()
+	if s.publicBusy || s.publicIP != "" {
+		s.mu.Unlock()
+		return
+	}
+	s.publicBusy = true
+	lobby := s.lobbyURL
+	s.mu.Unlock()
+
+	go func() {
+		ip, err := "", fmt.Errorf("no lobby configured")
+		sources := []string{}
+		if lobby != "" {
+			sources = append(sources, lobby+"/api/ip")
+		}
+		sources = append(sources, "https://api.ipify.org?format=json")
+		for _, u := range sources {
+			ip, err = s.getIP(u)
+			if err == nil && ip != "" {
+				break
+			}
+		}
+		s.mu.Lock()
+		s.publicBusy = false
+		if err == nil && ip != "" {
+			s.publicIP, s.publicIPErr = ip, ""
+		} else {
+			s.publicIPErr = "unknown"
+		}
+		s.mu.Unlock()
+	}()
+}
+
+func (s *cvfOnlineState) getIP(u string) (string, error) {
+	c := &http.Client{Timeout: 15 * time.Second}
+	resp, err := c.Get(u)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+	var v struct {
+		IP string `json:"ip"`
+	}
+	if err := json.NewDecoder(io.LimitReader(resp.Body, 4096)).Decode(&v); err != nil {
+		return "", err
+	}
+	if net.ParseIP(v.IP) == nil {
+		return "", fmt.Errorf("bad ip")
+	}
+	return v.IP, nil
+}
+
+// ---------------------------------------------------------------------------
+// Minimal UPnP IGD client (SSDP discovery + SOAP AddPortMapping/DeletePortMapping)
+
+type upnpMapping struct {
+	controlURL, service string
+	port                int
+	proto               string
+}
+
+type upnpDevice struct {
+	controlURL, service, localIP string
+}
+
+func upnpDiscover() (*upnpDevice, error) {
+	conn, err := net.ListenPacket("udp4", ":0")
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	dst := &net.UDPAddr{IP: net.IPv4(239, 255, 255, 250), Port: 1900}
+	for _, st := range []string{
+		"urn:schemas-upnp-org:device:InternetGatewayDevice:1",
+		"urn:schemas-upnp-org:device:InternetGatewayDevice:2",
+		"urn:schemas-upnp-org:service:WANIPConnection:1",
+	} {
+		msg := "M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nST: " + st +
+			"\r\nMAN: \"ssdp:discover\"\r\nMX: 2\r\n\r\n"
+		conn.WriteTo([]byte(msg), dst)
+	}
+	conn.SetReadDeadline(time.Now().Add(3 * time.Second))
+	buf := make([]byte, 4096)
+	seen := map[string]bool{}
+	for {
+		n, _, err := conn.ReadFrom(buf)
+		if err != nil {
+			return nil, fmt.Errorf("no UPnP router found")
+		}
+		loc := ""
+		for _, line := range strings.Split(string(buf[:n]), "\r\n") {
+			if k, v, ok := strings.Cut(line, ":"); ok && strings.EqualFold(strings.TrimSpace(k), "location") {
+				loc = strings.TrimSpace(v)
+			}
+		}
+		if loc == "" || seen[loc] {
+			continue
+		}
+		seen[loc] = true
+		if d, err := upnpDescribe(loc); err == nil {
+			return d, nil
+		}
+	}
+}
+
+func upnpDescribe(loc string) (*upnpDevice, error) {
+	c := &http.Client{Timeout: 4 * time.Second}
+	resp, err := c.Get(loc)
+	if err != nil {
+		return nil, err
+	}
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	resp.Body.Close()
+	type svc struct {
+		ServiceType string `xml:"serviceType"`
+		ControlURL  string `xml:"controlURL"`
+	}
+	dec := xml.NewDecoder(bytes.NewReader(body))
+	var found *svc
+	for {
+		tok, err := dec.Token()
+		if err != nil {
+			break
+		}
+		if se, ok := tok.(xml.StartElement); ok && se.Name.Local == "service" {
+			var s svc
+			if dec.DecodeElement(&s, &se) == nil &&
+				(strings.Contains(s.ServiceType, "WANIPConnection") || strings.Contains(s.ServiceType, "WANPPPConnection")) {
+				found = &s
+				break
+			}
+		}
+	}
+	if found == nil {
+		return nil, fmt.Errorf("no WAN service")
+	}
+	base, _ := url.Parse(loc)
+	ctl, err := base.Parse(found.ControlURL)
+	if err != nil {
+		return nil, err
+	}
+	// Which local address reaches the router?
+	host := base.Hostname()
+	localIP := ""
+	if c, err := net.Dial("udp4", net.JoinHostPort(host, "1900")); err == nil {
+		localIP = c.LocalAddr().(*net.UDPAddr).IP.String()
+		c.Close()
+	}
+	return &upnpDevice{controlURL: ctl.String(), service: found.ServiceType, localIP: localIP}, nil
+}
+
+func upnpSOAP(controlURL, service, action, args string) error {
+	body := `<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" ` +
+		`s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"><s:Body><u:` + action +
+		` xmlns:u="` + service + `">` + args + `</u:` + action + `></s:Body></s:Envelope>`
+	req, err := http.NewRequest("POST", controlURL, strings.NewReader(body))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", `text/xml; charset="utf-8"`)
+	req.Header.Set("SOAPAction", `"`+service+`#`+action+`"`)
+	c := &http.Client{Timeout: 5 * time.Second}
+	resp, err := c.Do(req)
+	if err != nil {
+		return err
+	}
+	io.Copy(io.Discard, io.LimitReader(resp.Body, 1<<16))
+	resp.Body.Close()
+	if resp.StatusCode != 200 {
+		return fmt.Errorf("router refused (%d)", resp.StatusCode)
+	}
+	return nil
+}
+
+func upnpAdd(d *upnpDevice, port int, proto string) error {
+	args := fmt.Sprintf("<NewRemoteHost></NewRemoteHost><NewExternalPort>%d</NewExternalPort>"+
+		"<NewProtocol>%s</NewProtocol><NewInternalPort>%d</NewInternalPort>"+
+		"<NewInternalClient>%s</NewInternalClient><NewEnabled>1</NewEnabled>"+
+		"<NewPortMappingDescription>Castlevania Fighter Online</NewPortMappingDescription>"+
+		"<NewLeaseDuration>7200</NewLeaseDuration>", port, proto, port, d.localIP)
+	return upnpSOAP(d.controlURL, d.service, "AddPortMapping", args)
+}
+
+func upnpDelete(m upnpMapping) {
+	args := fmt.Sprintf("<NewRemoteHost></NewRemoteHost><NewExternalPort>%d</NewExternalPort>"+
+		"<NewProtocol>%s</NewProtocol>", m.port, m.proto)
+	upnpSOAP(m.controlURL, m.service, "DeletePortMapping", args)
+}
+
+func (s *cvfOnlineState) openPorts(tcpPort, udpPort int) {
+	s.mu.Lock()
+	s.upnpStatus = "Opening router port automatically..."
+	s.mu.Unlock()
+	go func() {
+		d, err := upnpDiscover()
+		if err != nil {
+			s.mu.Lock()
+			s.upnpStatus = "Router auto-setup unavailable"
+			s.mu.Unlock()
+			return
+		}
+		var maps []upnpMapping
+		var errs []string
+		try := func(p int, proto string) {
+			if p <= 0 {
+				return
+			}
+			if err := upnpAdd(d, p, proto); err != nil {
+				errs = append(errs, proto)
+			} else {
+				maps = append(maps, upnpMapping{d.controlURL, d.service, p, proto})
+			}
+		}
+		if tcpPort > 0 {
+			try(tcpPort, "TCP")
+		}
+		try(udpPort, "UDP")
+		s.mu.Lock()
+		s.upnpMapped = append(s.upnpMapped, maps...)
+		if len(errs) == 0 {
+			s.upnpStatus = "Router port opened automatically"
+		} else {
+			s.upnpStatus = "Router refused auto-setup (" + strings.Join(errs, "/") + ")"
+		}
+		s.mu.Unlock()
+	}()
+}
+
+func (s *cvfOnlineState) closePorts() {
+	s.mu.Lock()
+	maps := s.upnpMapped
+	s.upnpMapped = nil
+	s.upnpStatus = ""
+	s.mu.Unlock()
+	if len(maps) > 0 {
+		go func() {
+			for _, m := range maps {
+				upnpDelete(m)
+			}
+		}()
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Lobby client
+
+func (s *cvfOnlineState) post(path string, v any, out any) error {
+	b, _ := json.Marshal(v)
+	resp, err := s.httpClient.Post(s.lobbyURL+path, "application/json", bytes.NewReader(b))
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode/100 != 2 {
+		msg, _ := io.ReadAll(io.LimitReader(resp.Body, 512))
+		return fmt.Errorf("lobby: %s", strings.TrimSpace(string(msg)))
+	}
+	if out != nil {
+		return json.NewDecoder(io.LimitReader(resp.Body, 1<<20)).Decode(out)
+	}
+	return nil
+}
+
+func (s *cvfOnlineState) hostBegin(port, udpPort int) {
+	s.readConfig()
+	s.hostEnd()
+	s.mu.Lock()
+	s.hosting, s.hostPort = true, port
+	s.roomID, s.roomToken, s.roomOpen, s.lobbyHostErr = "", "", "", ""
+	stop := make(chan struct{})
+	s.hostStop = stop
+	name, lobby, tag := s.playerName, s.lobbyURL, s.buildTag
+	s.mu.Unlock()
+
+	s.fetchPublicIP()
+	s.openPorts(port, udpPort)
+
+	if lobby == "" {
+		return
+	}
+	if name == "" {
+		name = "Player"
+	}
+	go func() {
+		// Give UPnP a moment so the lobby's reachability check sees the open port.
+		select {
+		case <-stop:
+			return
+		case <-time.After(3 * time.Second):
+		}
+		var r struct {
+			ID    string `json:"id"`
+			Token string `json:"token"`
+			IP    string `json:"ip"`
+		}
+		for {
+			err := s.post("/api/rooms", map[string]any{"name": name, "port": port, "udp_port": udpPort, "version": tag}, &r)
+			if err == nil {
+				break
+			}
+			s.mu.Lock()
+			s.lobbyHostErr = "Lobby unreachable, retrying"
+			s.mu.Unlock()
+			select {
+			case <-stop:
+				return
+			case <-time.After(10 * time.Second):
+			}
+		}
+		s.mu.Lock()
+		s.lobbyHostErr = ""
+		if s.hostStop != stop {
+			s.mu.Unlock()
+			s.post("/api/rooms/"+r.ID+"/leave", map[string]string{"token": r.Token}, nil)
+			return
+		}
+		s.roomID, s.roomToken = r.ID, r.Token
+		if r.IP != "" && s.publicIP == "" {
+			s.publicIP = r.IP
+		}
+		s.mu.Unlock()
+		t := time.NewTicker(10 * time.Second)
+		defer t.Stop()
+		for {
+			var hb struct {
+				Open string `json:"open"`
+			}
+			err := s.post("/api/rooms/"+r.ID+"/heartbeat", map[string]string{"token": r.Token}, &hb)
+			s.mu.Lock()
+			if err == nil {
+				s.roomOpen = hb.Open
+				s.lobbyHostErr = ""
+			}
+			s.mu.Unlock()
+			select {
+			case <-stop:
+				s.post("/api/rooms/"+r.ID+"/leave", map[string]string{"token": r.Token}, nil)
+				return
+			case <-t.C:
+			}
+		}
+	}()
+}
+
+func (s *cvfOnlineState) hostEnd() {
+	s.mu.Lock()
+	if s.hostStop != nil {
+		close(s.hostStop)
+		s.hostStop = nil
+	}
+	s.hosting = false
+	s.roomID, s.roomToken, s.roomOpen = "", "", ""
+	s.mu.Unlock()
+}
+
+func (s *cvfOnlineState) hostStatus() string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	var b strings.Builder
+	b.WriteString("Waiting for an opponent...\n\n")
+	pub := s.publicIP
+	if pub == "" {
+		if s.publicIPErr != "" {
+			pub = "(could not detect)"
+		} else {
+			pub = "(detecting...)"
+		}
+	}
+	fmt.Fprintf(&b, "Internet address: %s   Port: %d\n", pub, s.hostPort)
+	if ips := cvfLocalIPs(); len(ips) > 0 {
+		fmt.Fprintf(&b, "Same network (LAN): %s\n", strings.Join(ips, ", "))
+	}
+	if s.upnpStatus != "" {
+		b.WriteString(s.upnpStatus + "\n")
+		if strings.HasPrefix(s.upnpStatus, "Router auto-setup unavailable") || strings.HasPrefix(s.upnpStatus, "Router refused") {
+			fmt.Fprintf(&b, "If nobody can join: forward TCP+UDP %d on your router\nor use a VPN like Tailscale.\n", s.hostPort)
+		}
+	}
+	switch {
+	case s.lobbyURL == "":
+		b.WriteString("\nShare your Internet address with your opponent.\n")
+	case s.lobbyHostErr != "":
+		b.WriteString("\n" + s.lobbyHostErr + " - share your address instead.\n")
+	case s.roomID == "":
+		b.WriteString("\nListing you in the lobby...\n")
+	default:
+		fmt.Fprintf(&b, "\nListed in the lobby as \"%s\"\n", s.playerName)
+		b.WriteString("Other players can now pick you in Online > Lobby.\n")
+	}
+	b.WriteString("\nPress Esc to stop hosting.")
+	return b.String()
+}
+
+func (s *cvfOnlineState) refreshRooms() {
+	s.readConfig()
+	s.mu.Lock()
+	if s.roomsBusy || s.lobbyURL == "" {
+		if s.lobbyURL == "" {
+			s.roomsErr = "No lobby server configured (data/cvf_online.ini)"
+		}
+		s.mu.Unlock()
+		return
+	}
+	s.roomsBusy = true
+	if s.roomsFetched.IsZero() {
+		s.roomsErr = "Connecting to the lobby (can take up to a minute)..."
+	}
+	s.mu.Unlock()
+	go func() {
+		resp, err := s.httpClient.Get(s.lobbyURL + "/api/rooms")
+		var rooms []cvfRoom
+		if err == nil {
+			if resp.StatusCode == 200 {
+				err = json.NewDecoder(io.LimitReader(resp.Body, 1<<20)).Decode(&rooms)
+			} else {
+				err = fmt.Errorf("status %d", resp.StatusCode)
+			}
+			resp.Body.Close()
+		}
+		s.mu.Lock()
+		s.roomsBusy = false
+		if err != nil {
+			s.roomsErr = "Lobby unreachable, retrying..."
+		} else {
+			sort.SliceStable(rooms, func(i, j int) bool { return rooms[i].AgeSec < rooms[j].AgeSec })
+			s.rooms, s.roomsErr, s.roomsFetched = rooms, "", time.Now()
+		}
+		s.mu.Unlock()
+	}()
+}
+
+var cvfNameRe = regexp.MustCompile(`[^\p{L}\p{N} _.\-!?']`)
+
+func cvfCleanName(n string) string {
+	n = strings.TrimSpace(cvfNameRe.ReplaceAllString(n, ""))
+	if r := []rune(n); len(r) > 20 {
+		n = string(r[:20])
+	}
+	return n
+}
