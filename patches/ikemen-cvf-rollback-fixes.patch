+// Advance the projectile animation.
+// Animation progress decides when removed projectiles are cleaned up and which Clsn boxes are active,
+// so it is gameplay state and must run once per simulated frame. It used to run from cueDraw(),
+// which rollback only calls once per rendered frame, so re-simulated frames desynced.
+func (p *Projectile) animStep() {
+	if p.anim == nil || p.root().scf(SCF_disabled) {
+		return
+	}
+	isPaused := p.hitpause > 0 || p.pauseBool
+	// TODO: Gating UpdateSprite() during pauses makes it go out of sync with the animation data
+	// In the case of projectiles this can be seen with Clsn display
+	if !isPaused && sys.tickFrame() {
+		p.anim.UpdateSprite()
+	}
+	if sys.tickNextFrame() && !isPaused {
+		p.anim.Action()
+	}
+}
