+    // Folders that can hold the game, in order. The game folder is the one with chars/ in it.
+    private String cvfFindGame() {
+        java.util.ArrayList<File> places = new java.util.ArrayList<>();
+        String picked = mSharedPrefs.getString(getString(R.string.game_folder_key), "");
+        if (!picked.isEmpty()) {
+            places.add(new File(picked));
+            places.add(new File(picked, "Game"));
+        }
+        // Internal storage > CvF Online > Game: kept when the app is uninstalled.
+        places.add(new File(Environment.getExternalStorageDirectory(), "CvF Online/Game"));
+        // Android/data/<app>/files/Game: needs no permission, deleted with the app.
+        File own = getExternalFilesDir(null);
+        if (own != null) {
+            places.add(new File(own, "Game"));
+        }
+        // Without file access Android can still show that a shared folder exists while
+        // refusing to read it, so only the app's own folder counts until access is given.
+        boolean access = cvfHasFileAccess();
+        String ownPath = own != null ? own.getAbsolutePath() : null;
+        for (File place : places) {
+            boolean isOwn = ownPath != null && place.getAbsolutePath().startsWith(ownPath);
+            if ((access || isOwn) && new File(place, "chars").isDirectory()) {
+                return place.getAbsolutePath();
+            }
         }
+        return null;
+    }
 
