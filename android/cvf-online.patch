diff --git a/app/src/main/java/org/libsdl/app/CvfGestureOverlay.java b/app/src/main/java/org/libsdl/app/CvfGestureOverlay.java
new file mode 100644
index 0000000..e223819
--- /dev/null
+++ b/app/src/main/java/org/libsdl/app/CvfGestureOverlay.java
@@ -0,0 +1,202 @@
+package org.libsdl.app;
+
+import android.content.Context;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.InputDevice;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+import android.view.View;
+
+/**
+ * CvF Online: menu gestures instead of an on-screen gamepad (same rules as the iOS app).
+ *
+ * Outside fights: swipe to move, tap the right half to confirm, double-tap to go back,
+ * tap a character to move the cursor there (tap again to pick). A three-finger tap is
+ * Start, also during fights. Fights themselves need a controller.
+ * With a controller connected, only direct taps on screen elements are used.
+ *
+ * Input goes in as the player 1 keyboard keys from CvF's config.ini (arrows, z, Enter)
+ * plus Esc, so no virtual gamepad takes a controller slot from a real one.
+ */
+public class CvfGestureOverlay extends View {
+    // Same sizes as iOS (points there, dp here).
+    private static final float TAP_DISTANCE_DP = 16f;
+    private static final float SWIPE_DISTANCE_DP = 28f;
+    private static final float DOUBLE_TAP_DISTANCE_DP = 60f;
+    private static final long TAP_TIME_MS = 350;
+    private static final long PRESS_MS = 90;
+    private static final long DOUBLE_TAP_TIME_MS = 280;
+
+    private static final int KEY_CONFIRM = KeyEvent.KEYCODE_Z;     // P1 "a"
+    private static final int KEY_START = KeyEvent.KEYCODE_ENTER;   // P1 "start"
+    private static final int KEY_BACK = KeyEvent.KEYCODE_ESCAPE;   // menus: back
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final float mDensity;
+
+    private boolean mTracking;
+    private float mStartX, mStartY;
+    private long mStartTime;
+    private int mMaxPointers;
+
+    private boolean mTapPending;
+    private float mTapX, mTapY;
+    private final Runnable mCommitTap = this::commitSingleTap;
+
+    public CvfGestureOverlay(Context context) {
+        super(context);
+        mDensity = context.getResources().getDisplayMetrics().density;
+        setClickable(true);
+        setFocusable(false);
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent ev) {
+        switch (ev.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                mTracking = true;
+                mStartX = ev.getX();
+                mStartY = ev.getY();
+                mStartTime = ev.getEventTime();
+                mMaxPointers = 1;
+                break;
+            case MotionEvent.ACTION_POINTER_DOWN:
+            case MotionEvent.ACTION_MOVE:
+                mMaxPointers = Math.max(mMaxPointers, ev.getPointerCount());
+                break;
+            case MotionEvent.ACTION_UP:
+                // Every finger has lifted: decide what the gesture was.
+                if (mTracking) {
+                    mTracking = false;
+                    gestureEnded(ev.getX(), ev.getY(), ev.getEventTime() - mStartTime <= TAP_TIME_MS);
+                }
+                break;
+            case MotionEvent.ACTION_CANCEL:
+                mTracking = false;
+                break;
+        }
+        return true; // Never pass touches on to SDL (no touch-as-mouse clicks).
+    }
+
+    private void gestureEnded(float x, float y, boolean quick) {
+        float dx = x - mStartX, dy = y - mStartY;
+        float distance = (float) Math.hypot(dx, dy);
+        boolean controller = controllerConnected();
+
+        if (mMaxPointers >= 3) {
+            if (quick && !controller) {
+                press(KEY_START);
+            }
+            return;
+        }
+        if (mMaxPointers != 1 || inMatch()) {
+            return;
+        }
+        if (controller) {
+            if (distance <= TAP_DISTANCE_DP * mDensity && quick) {
+                tap(x / getWidth(), y / getHeight());
+            }
+            return;
+        }
+        if (distance >= SWIPE_DISTANCE_DP * mDensity) {
+            if (Math.abs(dx) > Math.abs(dy)) {
+                press(dx > 0 ? KeyEvent.KEYCODE_DPAD_RIGHT : KeyEvent.KEYCODE_DPAD_LEFT);
+            } else {
+                press(dy > 0 ? KeyEvent.KEYCODE_DPAD_DOWN : KeyEvent.KEYCODE_DPAD_UP);
+            }
+        } else if (distance <= TAP_DISTANCE_DP * mDensity && quick) {
+            handleTap(x, y);
+        }
+    }
+
+    private void handleTap(float x, float y) {
+        if (mTapPending && Math.hypot(x - mTapX, y - mTapY) <= DOUBLE_TAP_DISTANCE_DP * mDensity) {
+            mHandler.removeCallbacks(mCommitTap);
+            mTapPending = false;
+            press(KEY_BACK);
+            return;
+        }
+        if (mTapPending) {
+            mHandler.removeCallbacks(mCommitTap);
+            commitSingleTap();
+        }
+        // Hold the tap briefly in case a second one makes it a double-tap.
+        mTapPending = true;
+        mTapX = x;
+        mTapY = y;
+        mHandler.postDelayed(mCommitTap, DOUBLE_TAP_TIME_MS);
+    }
+
+    private void commitSingleTap() {
+        if (!mTapPending) {
+            return;
+        }
+        mTapPending = false;
+        // Character select reads taps itself (tap a character to move there).
+        if (tap(mTapX / getWidth(), mTapY / getHeight())) {
+            return;
+        }
+        if (mTapX >= getWidth() / 2f) {
+            press(KEY_CONFIRM);
+        }
+    }
+
+    private void press(final int keycode) {
+        SDLActivity.onNativeKeyDown(keycode);
+        mHandler.postDelayed(() -> SDLActivity.onNativeKeyUp(keycode), PRESS_MS);
+    }
+
+    // Engine hooks (src/util_android.go). An engine without them just loses the extras.
+    private static boolean inMatch() {
+        try {
+            return SDLActivity.nativeCvfInMatch();
+        } catch (UnsatisfiedLinkError e) {
+            return false;
+        }
+    }
+
+    private static boolean tap(float x, float y) {
+        try {
+            return SDLActivity.nativeCvfTouchTap(x, y);
+        } catch (UnsatisfiedLinkError e) {
+            return false;
+        }
+    }
+
+    private static boolean controllerConnected() {
+        boolean connected = false;
+        for (int id : InputDevice.getDeviceIds()) {
+            if (isRealGamepad(InputDevice.getDevice(id))) {
+                connected = true;
+                break;
+            }
+        }
+        try {
+            SDLActivity.nativeCvfSetTouchMenus(!connected);
+        } catch (UnsatisfiedLinkError ignored) {
+        }
+        return connected;
+    }
+
+    // Real controllers report gamepad buttons; sensors that claim to be joysticks don't.
+    private static boolean isRealGamepad(InputDevice device) {
+        if (device == null || device.isVirtual()) {
+            return false;
+        }
+        int sources = device.getSources();
+        if ((sources & InputDevice.SOURCE_GAMEPAD) != InputDevice.SOURCE_GAMEPAD
+                && (sources & InputDevice.SOURCE_JOYSTICK) != InputDevice.SOURCE_JOYSTICK) {
+            return false;
+        }
+        boolean[] has = device.hasKeys(KeyEvent.KEYCODE_BUTTON_A, KeyEvent.KEYCODE_BUTTON_B,
+                KeyEvent.KEYCODE_BUTTON_X, KeyEvent.KEYCODE_BUTTON_Y,
+                KeyEvent.KEYCODE_BUTTON_START, KeyEvent.KEYCODE_BUTTON_SELECT);
+        for (boolean b : has) {
+            if (b) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
