pal4=04.act
pal5=05.act
pal6=06.act
pal7=07.act
pal8=08.act
pal9=09.act
pal10=10.act
pal11=11.act
pal12=12.act
[Palette Keymap]
a  = 1 ;Press button X to select palette 1, etc.
b  = 2
c  = 3
x  = 4
y  = 5
z  = 6
a2 = 7 ;Hold Start and press button X for palette 7, etc.
b2 = 8
c2 = 9
