displayname  = "Femdom"  ; Name of character to display
versiondate=0924
mugenversion=2002.14.04
author       = "CvF"   ; Character author name
pal.defaults = 1,2,3,4,5,6   ; Default palettes in order of preference (up to 4, starts from 1)
